.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", person_members_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_person_member_path
      %li.active= link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_person_member_path
  .content
    %h2.title
      = t("web-app-theme.edit", :default => "Edit")
      Einzelmitglied
    .inner
      = semantic_form_for @person_member do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

- if readable? person_member 
  %tr{:class => cycle("odd", "even")}
    %td
      - if !person_member.valid? then
        = image_tag('/assets/warn.svg',{:size=>"16x16"})
      - if person_member.member.nil? then
        INCONSISTENT
      - else
        = link_to person_member.member.mglnr, person_member_path(person_member)
    %td
      = person_member.fullname
    - if person_member.member.nil? then
      %td
        INVALID
    -else 
      %td
        = person_member.member.ort
      %td
        = mail_to person_member.member.email, person_member.member.email
      %td
        =format_date person_member.member.eintritt 
    %td.last
      = link_to_show(person_member, t("common.show"))
      = link_to_edit(person_member, t("common.edit")) 
      = link_to_delete person_member, t("common.delete"), t("common.delete_confirm")


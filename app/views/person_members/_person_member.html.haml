%tr{:class => cycle("odd", "even")}
  %td
    - if not person_member.valid? then
      %a.d-inline-block{"aria-label" => "Person Member errors", "data-bs-title" => "BLAH #{person_member.errors.to_a.join("\n")}", "data-bs-toggle" => "tooltip", :href => "#"}
        %i.fas.fa-exclamation-triangle.text-warning
    - if person_member.member.nil? then
      INCONSISTENT
    - else
      = link_to person_member.member.mglnr, person_member_path(person_member)
  %td
    = person_member.fullname
  - if person_member.member.nil? then
    %td
      INVALID
  -else 
    %td
      = person_member.member.ort
    %td
      = mail_to person_member.member.email, person_member.member.email
  %td.last
    = link_to_show person_member
    = link_to_edit person_member
    = link_to_delete person_member


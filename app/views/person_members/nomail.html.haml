.secondary-navigation
  =render :partial=>'nav'
.container
  %h2
    =t("member.nomail")
    ="(#{t("person_member", count: 3)})"

  #enty_info.text-center= page_entries_info @members
  #paginator= paginate @members
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %th= sortable "mglnr", attr_heading(Member,:mglnr), "table-dark"
      %th=attr_heading(Member, :salutation)
      %th=attr_heading(Member, :vorname)
      %th=attr_heading(Member, :name)
      %th=attr_heading(Member, :strasse)
      %th=attr_heading(Member, :ort)
      %th &nbsp;
    %tbody#person_members
      = render partial: "person_member_nomail", collection: @members, :as => :person_member

.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", person_members_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_person_member_path
      %li.active= link_to "#{t("web-app-theme.show", :default => "Show")}", person_member_path
  .content
    .inner
      %table
        %tr
          %td.label
            #{t("member.mglnr")}:
          %td
            = @person_member.mglnr
        %tr
          %td.label
            #{t("member.anrede")}:
          %td
            = @person_member.anrede
        %tr
          %td.label
            #{t("member.vorname")}:
          %td
            = @person_member.vorname
        %tr
          %td.label
            #{t("member.name")}:
          %td
            = @person_member.name
        %tr
          %td.label
            #{t("member.strasse")}:
          %td
            = @person_member.strasse
        %tr
          %td.label
            #{t("member.country")}:
          %td
            = @person_member.country.name
        %tr
          %td.label
            #{t("member.plz")}:
          %td
            = @person_member.plz
        %tr
          %td.label
            #{t("member.ort")}:
          %td
            = @person_member.ort
        %tr
          %td.label
            #{t("person_member.email")}:
          %td
            = mail_to @person_member.email, @person_member.email

        %tr
          %td.label
            #{t("person_member.geburtstag")}:
          %td
            = format_date(@person_member.geburtstag)
        %tr
          %td.label
            #{t("member.telefonPrivat")}:
          %td
            = @person_member.telefonPrivat
        %tr
          %td.label
            #{t("member.telefonDienstl")}:
          %td
            = @person_member.telefonDienstl
        %tr
          %td.label
            #{t("member.telefax")}:
          %td
            = @person_member.telefax
        %tr
          %td.label
            #{t("member.eintritt")}:
          %td
            = format_date(@person_member.eintritt)
        %tr
          %td.label
            #{t("person_member.za")}:
          %td
            #{t("common.za_"+@person_member.za)}
        %tr
          %td.label
            #{t("person_member.konto")}:
          %td
            = @person_member.konto
        %tr
          %td.label
            #{t("person_member.blz")}:
          %td
            = @person_member.blz
        %tr
          %td.label
            #{t("person_member.zahler")}:
          %td
            = @person_member.zahler
        %tr
          %td.label
            #{t("person_member.lv")}:
          %td
            = @person_member.regional_organization.name
        %tr
          %td.label
            #{t("person_member.tarrif_id")}:
          %td
            = @person_member.tariff.description
        %tr
          %td.label
            #{t("person_member.bemerkung")}:
          %td
            = @person_member.bemerkung
        %tr
          %td.label
            #{t("person_member.zeitungen")}:
          %td
            = @person_member.zeitungen
        %tr
          %td.label
            #{t("person_member.austritt_zum")}:
          %td
            = @person_member.austritt_zum
        %tr
          %td.label
            #{t("person_member.kuendigungVom")}:
          %td
            = @person_member.kuendigungVom
        %tr
          %td.label
            #{t("person_member.zusatzzeitung")}:
          %td
            = @person_member.zusatzzeitung
      .wat-cf
        = edit_button(edit_person_member_path(@person_member),@person_member)
        = del_button(person_member_path(@person_member),@person_member)

- content_for :sidebar, render(:partial => 'sidebar.show')

.secondary-navigation
  = render :partial=>'nav'
.container
  %h2= @person_member.member.mglnr
  %h3
    = @person_member.fullname
    = link_to 'Rechnungsvorschau', invoice_preview_person_member_path(@person_member),  data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'
  - if not @person_member.valid? or not @person_member.member.valid?
    .alert.alert-danger{ role:"alert" }
      - @person_member.errors.each do |e|
        = e.full_message
      - @person_member.member.errors.each do |e|
        =t("member."+e.attribute.to_s)
        \: 
        = e.full_message
        %br


  #personMemberAccordion.accordion
    .accordion-item
      .accordion-header 
        %button.accordion-button{"aria-controls" => "paymentDataCollapse", "aria-expanded" => "true", "data-bs-target" => "#personMemberDataCollapse", "data-bs-toggle" => "collapse", :type => "button"}
          Einzelmitglied-Daten
      #personMemberDataCollapse.accordion-collapse.collapse.show{"data-bs-parent" => "#personMemberAccordion"}
        .accordion-body
          = entity_row(@person_member,:geburtstag,:date)
          = entity_row(@person_member,:telefonDienstl)
          = entity_row(@person_member.tariff,:description)
          = entity_row(@person_member,:kuendigungVom,:date)
          = entity_row(@person_member,:bemerkung)

      = render @person_member.member,:partial=>"member"
  = edit_glyph_link(edit_person_member_path(@person_member),@person_member)


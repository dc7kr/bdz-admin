.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %table
    %tr
      %td= f.label :mglnr, t("member.mglnr"), :class => :label
      %td= f.number_field :mglnr, :class => 'number_field'
    %tr
      %td= f.label :anrede, t("person_member.anrede"), :class => :label
      %td= f.text_field :anrede, :class => 'text_field'
    %tr
      %td= f.label :vorname, t("member.vorname"), :class => :label
      %td= f.text_field :vorname, :class => 'text_field'
    %tr
      %td= f.label :name, t("member.name"), :class => :label
      %td= f.text_field :name, :class => 'text_field'
    %tr
      %td= f.label :strasse, t("person_member.strasse"), :class => :label
      %td= f.text_field :strasse, :class => 'text_field'
    %tr
      %td= f.label :land, t("person_member.land"), :class => :label
      %td= collection_select(:person_member, :country_id, Country.all, :id, :name) 
    %tr
      %td= f.label :plz, t("person_member.plz"), :class => :label
      %td= f.text_field :plz, :class => 'text_field'
    %tr
      %td= f.label :ort, t("person_member.Ort"), :class => :label
      %td= f.text_field :ort, :class => 'text_field'
    %tr
      %td= f.label :email, t("member.email"), :class => :label
      %td= f.text_field :email, :class => 'text_field'
    %tr
      %td= f.label :geburtstag, t("person_member.geburtstag"), :class => :label
      %td= f.text_field :geburtstag, :class => 'datePicker'
    %tr
      %td= f.label :telefonPrivat, t("person_member.telefonPrivat"), :class => :label
      %td= f.text_field :telefonPrivat, :class => 'text_field'
    %tr
      %td= f.label :telefonDienstl, t("person_member.telefonDienstl"), :class => :label
      %td= f.text_field :telefonDienstl, :class => 'text_field'
    %tr
      %td= f.label :telefax, t("person_member.telefax"), :class => :label
      %td= f.text_field :telefax, :class => 'text_field'
    %tr
      %td= f.label :eintritt, t("person_member.eintritt"), :class => :label
      %td= f.text_field :eintritt, :class => 'datePicker'
    %tr
      %td= f.label :za, :class => :label
      %td= f.select :za, options_for_select([["Lastschrift", "L"], ["Rechnung", "R"]],:selected=>@person_member.za) 
    %tr
      %td= f.label :konto, :class => :label
      %td= f.number_field :konto, :class => 'number_field'
    %tr
      %td= f.label :blz, :class => :label
      %td= f.number_field :blz, :class => 'number_field'
    %tr
      %td= f.label :zahler, :class => :label
      %td= f.text_field :zahler, :class => 'text_field'
    %tr
      %td= f.label :lv, t("member.lv"), :class => :label
      %td= collection_select(:person_member, :regional_organization_id, RegionalOrganization.all, :id, :name) 
    %tr
      %td= f.label :tariff, t("person_member.beitragsart"), :class => :label
      %td= collection_select(:person_member, :tariff_id, Tariff.all, :id, :description) 
    %tr
      %td= f.label :zeitungen, t("person_member.zeitungen"), :class => :label
      %td= f.number_field :zeitungen, :class => 'number_field'
    %tr
      %td= f.label :zusatzzeitung, t("person_member.zusatzzeitung"), :class => :label
      %td= f.check_box :zusatzzeitung, :class => 'number_field'
    %tr
      %td= f.label :austrittZum, t("person_member.austrittZum"), :class => :label
      %td= f.text_field :austritt_zum, :class => 'datePicker'
    %tr
      %td= f.label :kuendigungVom, t("person_member.kuendigungVom"), :class => :label
      %td= f.text_field :kuendigungVom, :class => 'datePicker'
    %tr
      %td= f.label :bemerkung, t("person_member.bemerkung"), :class => :label
      %td= f.text_area :bemerkung, :class => 'text_field'
      
      
      
.group.navform.wat-cf
  %button.button{:type => "submit"}
    = image_tag("web-app-theme/icons/tick.png", :alt => "#{t("web-app-theme.save", :default => "Save")}")
    = t("web-app-theme.save", :default => "Save")
  %span.text_button_padding= t("web-app-theme.or", :default => "or")
  = cancel_button()

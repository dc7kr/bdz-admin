.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("person_member.title")
    .inner
      %table.table
        %thead
          %th.first 
            = sortable "mglnr", t("member.mglnr", :default =>"#mglr#")
          %th
            = sortable "name", t("member.fullname", :default => "Name")
          %th= t("member.city")
          %th= t("member.email")
          %th.last &nbsp;
        %tbody#person_members
          = render @person_members
      #paginator
        = paginate @person_members, :remote=>true

      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

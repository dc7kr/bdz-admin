.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("person_member",:count=>3)
  #entry_info.text-center= page_entries_info @person_members
  #paginator= paginate @person_members, params: { format: :turbo_stream }
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %tr
        %th= sortable "mglnr", attr_heading(Member,:mglnr), "table-dark"
        %th= sortable "name", attr_heading(Member,:fullname), "table-dark"
        %th= attr_heading(Member,:city)
        %th= attr_heading(Member,:email)
        %th=sortable "eintritt", attr_heading(Member,:eintritt), "table-dark"
        %th &nbsp;
    %tbody#person_members
      = render @person_members

- content_for :sidebar, render(:partial => 'sidebar')

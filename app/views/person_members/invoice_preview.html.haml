= render layout: 'layouts/modal', locals: { title: 'Rechnungsvorschau' } do 
  %h2=@invoice.full_number
  .row
    .col=t("invoice.invoice_date")
    .col=l @invoice.invoice_date

  .row
    .col=t("invoice.template")
    .col=@invoice.template
  .row
    .col=t("invoice.tax_mode")
    .col=t("invoice.tax_modes.#{@invoice.tax_mode}")

  %table.table.table-bordered
    %thead.table-dark
      %tr
        %th Anzahl
        %th Beschreibung
        %th Einzelpreis
        %th Gesamtpreis
    - @invoice.items.each do |it|
      %tr
        %td=it.count
        %td=it.label
        %td=format_currency it.basis
        %td=format_currency it.total

    %tr
      %td &nbsp;
      %td.fw-bold Gesamtsumme
      %td.fw-bold=format_currency @invoice.net_sum
      %td.fw-bold=format_currency @invoice.sum

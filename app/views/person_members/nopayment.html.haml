.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("member.nopayment")
      (#{t("person_member",:count=>3)})
    .inner
      = link_to_generated_download_path(t('common.download'),nopayment_person_members_path(:format=>:ods))
      %table.table
        %tr
          %th.first 
            = sortable "mglnr", t("member.mglnr", :default =>"#mglr#")
          %th=t("member.fullname")
          %th=t("member.email")
          %th=t("booking.balance")
          %th.last &nbsp;
        - @person_members.each do |person_member|
          %tr{:class => cycle("odd", "even")}
            %td
              = link_to person_member.mglnr, person_member_path(person_member)
            %td= person_member.fullname
            %td=mail_to person_member.email, person_member.email
            %td=format_currency(@accounts[person_member.member_id],'€')
            %td.last
              = link_to_show person_member
              = link_to_edit person_member
              = link_to_delete person_member
      .actions-bar.wat-cf
        .actions

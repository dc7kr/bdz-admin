.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("member.nopayment")
      (#{t("person_member",:count=>3)})
    .inner
      = link_to_generated_download_path(t('common.download'),nopayment_person_members_path(:format=>:ods))
      %table.table
        %tr
          %th.first 
            = sortable "mglnr", t("member.mglnr", :default =>"#mglr#")
          %th=t("member.fullname")
          %th=t("member.email")
          %th=t("booking.balance")
          %th.last &nbsp;
        - @members.each do |member|
          %tr{:class => cycle("odd", "even")}
            %td
              = link_to member.mglnr, person_member_path(member.member_entity)
            %td= member.fullname
            %td=mail_to member.email, member.email
            %td=format_currency(@accounts[member.id],'€')
            %td.last
              = link_to_show member.member_entity
              = link_to_edit member.member_entity
              = link_to_delete member.member_entity
      .actions-bar.wat-cf
        .actions

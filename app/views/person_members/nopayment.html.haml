.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("member.nopayment")
      (#{t("person_member.title")})
    .inner
      %table.table
        %tr
          %th.first 
            = sortable "mglnr", t("member.mglnr", :default =>"#mglr#")
          %th=t("person_member.fullname")
          %th=t("person_member.eMail")
          %th=t("member_account_booking.balance")
          %th.last &nbsp;
        - @person_members.each do |person_member|
          %tr{:class => cycle("odd", "even")}
            %td
              = link_to person_member.mglnr, person_member_path(person_member)
            %td= person_member.fullname
            %td=mail_to person_member.email, person_member.email
            %td=format_currency(@accounts[person_member.member_id],'€')
            %td.last
              = link_to_show(person_member_path(person_member), "#{t("web-app-theme.show", :default => "Show")}")
              |
              \#{link_to_edit(edit_person_member_path(person_member), "#{t("web-app-theme.edit", :default => "Edit")}")} |
              \#{link_to_delete(person_member_path(person_member), "#{t("web-app-theme.delete", :default => "Delete")}", "#{t("web-app-theme.confirm", :default => "Are you sure?")}")}
      .actions-bar.wat-cf
        .actions

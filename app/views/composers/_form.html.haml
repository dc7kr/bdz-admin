= form_for @composer,:html=>{ :class => "form-horizontal" } do |f|
  -if @composer.errors.any?
    #error_explanation
      %h2= "#{pluralize(@composer.errors.count, "error")} prohibited this composer from being saved:"
      %ul
        - @composer.errors.full_messages.each do |msg|
          %li= msg
  .container-liquid
    = form_my_field(f,@composer, :name)
    = form_my_field(f,@composer, :vorname)
    = form_my_field(f,@composer, :gebjahr)
    = form_my_field(f,@composer, :sterbejahr)
    = form_my_field(f,@composer, :ca_geb)
    = form_my_field(f,@composer, :ca_sterb)
    = form_my_field(f,@composer, :fk_ref_komp)
    = form_my_field(f,@composer, :comment)
  .actions
    = f.submit 'Save'
    = cancel_button()

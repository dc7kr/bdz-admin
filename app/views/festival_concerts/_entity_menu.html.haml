%li.nav-item.dropdown
  %button_to.btn.btn-outline-secondary.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :bs=> { :toggle=>"dropdown" }}, :aria => { :expanded => "false"}}
    =t("festival_concert", count:3)
  %ul.dropdown-menu
    - if @festival_concert
      %li=link_to t("festival_concert.programme"), programme_festival_concert_path(@festival_concert), class: "dropdown-item"
      %li
        %hr.dropdown-divider

    %li= link_to t("festival_concert.overview"), overview_festival_concerts_path(format: :ods), class: "dropdown-item"

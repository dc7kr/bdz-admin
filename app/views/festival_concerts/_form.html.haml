= bootstrap_form_for(@festival_concert, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f|
  = f.select :concert_type,  options_for_select([["Bürgerzentrum", "B"], ["Open-Air", "O"],  ["Workshop", "W"],["Stadtkirche","K"],["Schloss","S"]],:selected=>@festival_concert.concert_type)
  =f.text_field :number
  =f.text_field :concert_id
  =f.text_field :title
  =f.text_field :subtitle
  =f.text_field :location
  =f.datetime_local_field :event_time
  =f.check_box :outdoor

  =f.submit

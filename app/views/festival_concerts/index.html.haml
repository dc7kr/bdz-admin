.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("festival_concert.p")
    .inner
      %table.table.table-hover.table-condensed
        %tr
          %th=t("common.number")
          %th=attr_heading(Festival_concert, :title")
          %th=attr_heading(Festival_concert, :location")
          %th=attr_heading(Festival_concert, :event_time")
          %th=attr_heading(Festival_concert, :outdoor")
          %th

        = render @festival_concerts
- content_for :sidebar, render(:partial => 'sidebar')



.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    %h2.title
      #{t("festival_concert.s")} Nr. #{@festival_concert.number}
    .inner
      %table
        %tr
          %td=t('festival_concert.title')
          %td=@festival_concert.title
        %tr
          %td=t('festival_concert.location')
          %td=@festival_concert.location
        %tr
          %td=t('festival_concert.event_time')
          %td=l @festival_concert.event_time

      %h3 Teilnehmer

      %table
        = render @festival_concert.festival_applications


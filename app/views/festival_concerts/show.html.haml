.secondary-navigation
  = render :partial=>'nav'
.container
  .card.bg-light.mb-3
    .card-body
      %h5.card-title 
        #{t("festival_concert",:count=>1)} Nr. #{@festival_concert.concert_type} #{@festival_concert.number}

      =entity_row(@festival_concert,:title)
      =entity_row(@festival_concert,:location)
      =entity_row(@festival_concert,:event_time)
      = link_to t("festival_concert.programme"), programme_festival_concert_path(@festival_concert),  data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'


  %h3 Teilnehmer

  %table
    %thead
      %tr
        %th=t("common.id")
        %th=t("festival_application.orch_name")
        %th=t("festival_application.num_players")
        %th=t("festival_application.payment_status")
    %tbody= render @festival_concert.festival_applications


.secondary-navigation
  = render :partial=>'nav'
.container
  .card.bg-light.mb-3
    .card-body
      %h5.card-title 
        #{t("festival_concert",:count=>1)} Nr. #{@festival_concert.concert_type} #{@festival_concert.number}

      =entity_row(@festival_concert,:title)
      =entity_row(@festival_concert,:location)
      =entity_row(@festival_concert,:event_time)

  %h3 Teilnehmer

  %table
    = render @festival_concert.festival_applications
- content_for :sidebar, render(:partial => 'sidebar_show')

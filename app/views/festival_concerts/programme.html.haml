= render layout: 'layouts/modal', locals: { title: t("festival_concert.programme") } do 
  %h1.title 
    #{t("festival_concert", count: 1)} Nr. #{@festival_concert.number}
    “#{@festival_concert.title}”
  %h3
    =l @festival_concert.event_time
    (#{@festival_concert.location}) 
  %hr

  - @groups.each do |g|
    .mb-2
      %b=g.orch_name
      %table.table
        - g.festival_pieces.each do |p|
          %tr
            %td=p.composer
            %td=p.title
            %td.right #{render_duration(p.duration)} min


%tr
  %td=l member_event.event_date.to_date, :format => :long
  %td=member_event.event_type
  %td=member_event.event_id
  %td=member_event.comment
  %td
    -if (@isOrchestra) then
      = link_to_edit_path( edit_orchestra_member_event_path(@member,member_event),'Edit',member_event)
      = link_to_del_path( orchestra_member_event_path(@member,member_event), 'Del',t('common.delete_confirm'),member_event)
    -else
      = link_to_edit_path( edit_person_member_member_event_path(@member,member_event),'Edit',member_event)
      = link_to_del_path( person_member_member_event_path(@member,member_event), 'Del',t('common.delete_confirm'),member_event)


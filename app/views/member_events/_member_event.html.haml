%tr{:id=>"row#{member_event.id}"}
  %td=l member_event.event_date.to_date, :format => :long
  %td=t("member_event.event_types.#{member_event.event_type}")
  %td=truncate member_event.event_id, length: 15
  %td=truncate member_event.comment, length:40
  %td
    -if @member_type == :orchestra
      = link_to_edit member_event, edit_orchestra_member_event_path(@member_entity,member_event)
      = link_to_delete member_event,  orchestra_member_event_path(@member_entity,member_event)
      = link_to_download_path member_event, download_orchestra_member_event_path(@member_entity,member_event)
    -elsif @member_type == :person_member
      = link_to_edit member_event, edit_person_member_member_event_path(@member_entity,member_event)
      = link_to_delete member_event, person_member_member_event_path(@member_entity,member_event)
      = link_to_download_path member_event, download_person_member_member_event_path(@member_entity,member_event)


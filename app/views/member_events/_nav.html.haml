%ul.nav.nav-tabs
  - if @member_type == :orchestra
    %li.nav-item= link_to_up_path t("common.up"), orchestra_path(params[:orchestra_id]) 
    =nav_to_list MemberEvent, orchestra_member_events_path(@member_entity)
    =nav_to_new MemberEvent, new_orchestra_member_event_path(@member_entity)
  - elsif @member_type == :person_member
    %li.nav-item= link_to_up_path t("common.up"), person_member_path(@member_entity)
    =nav_to_list MemberEvent, person_member_member_events_path(@member_entity)
    =nav_to_new MemberEvent, new_person_member_member_event_path(@member_entity)
  -if ( @member_event != nil and @member_event.id != nil) then
    =nav_to_show @member_event


- content_for :entity_menu, render(:partial => 'entity_menu')

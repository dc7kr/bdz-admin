= f.hidden_field :member_id, :value=>@member.member_id
.block
  = f.error_messages :message => "", :header_tag => :h3
.container-fluid
  =form_my_select(f,@member_event, :event_type, options_for_select([["Telefonat", "T"], ["Email", "E"],  ["Brief", "B"]],:selected=>@member_event.event_type))
  =form_my_field(f,@member_event, :event_date, :date)
  =form_my_field(f,@member_event, :event_id)
  .actions      
    =submit_button
    =cancel_button

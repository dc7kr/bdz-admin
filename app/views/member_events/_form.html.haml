= bootstrap_form_for([@member_entity,@member_event], layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  = f.hidden_field :member_id, :value=>@member_entity.member.id
  .container-fluid
    = f.select :event_type, options_for_select([["Telefonat", "T"], ["Email", "E"],  ["Brief", "B"]],:selected=>@member_event.event_type)
    = f.date_field :event_date
    = f.text_field :event_id
    = f.text_area :comment
    .actions      
      =submit_button
      =cancel_button

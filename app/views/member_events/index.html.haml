.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t('member_events.title')
    .inner
      %table.table
        %thead
          %th.first= sortable "event_date", t("member_event.event_date")
          %th= sortable "event_type", t("member_event.event_type")
          %th= sortable "event", t("member_event.event")
          %th= sortable "comment", t("member_event.comment")
          %th.last &nbsp;
        %tbody#member_events
          =render @member_events
 

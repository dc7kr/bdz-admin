.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t('member_event.other')
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %th.first= sortable "event_date", attr_heading(MemberEvent,:event_date)
          %th= sortable "event_type", attr_heading(MemberEvent,:event_type)
          %th= sortable "event", attr_heading(MemberEvent,:event)
          %th= sortable "comment", t("common.comment")
          %th.last &nbsp;
        %tbody#member_events
          =render @member_events
    #paginator
      = paginate @member_events, { :remote=>true, :type=>"script"}
 
- content_for :sidebar, render(:partial => 'sidebar')

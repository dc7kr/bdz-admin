.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t('member_event', count:3)
    - if @member_entity
      = @member_entity.member.mglnr
  .text-center= page_entries_info @member_events
  %table.table.table-hover.table-condensed
    %thead
      %th.first= sortable "event_date", t("member_event.event_date")
      %th= sortable "event_type", t("member_event.event_type")
      %th= sortable "event", t("member_event.event")
      %th= sortable "comment", t("common.comment")
      %th.last &nbsp;
    %tbody#member_events
      =render @member_events
  #paginator
    = paginate @member_events

- content_for :sidebar, render(:partial => 'sidebar')

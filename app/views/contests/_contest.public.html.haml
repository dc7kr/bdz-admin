%dt.title
  =contest.startdate
  -
  =contest.enddate
  =contest.titel

%dd=contest.beschreibung

-fields = [ :inhalt,:zielgruppe,:termine,:gebuehr,:dozenten,:preis,:more_dates,:anmeldung,:deadline ]

- fields.each do |field| 
  - if contest[field] != nil 
    %dt= t('contest.'+field.to_s)
    %dd.body=contest[field]

= link_to_show contest
= link_to_edit contest
= link_to_delete contest

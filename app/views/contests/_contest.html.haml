%tr{:class => cycle("odd", "even")}
  %td= contest.startdate
  %td= contest.enddate
  %td= contest.titel
  %td= contest.deadline
  %td= contest.visible
  %td
    - if contest.visible == false then
      = link_to_publish contest,  t("common.publish")
    = link_to_show contest,  t("common.show")
    = link_to_edit contest, t("common.edit")
    = link_to_delete contest, t('common.delete'), t('common.delete_confirm')

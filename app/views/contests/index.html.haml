%h1 Listing contests

%table
  %tr
    %th Startdate
    %th Enddate
    %th Titel
    %th Deadline
    %th Visible
    %th
    %th
    %th

  - @contests.each do |contest|
    %tr
      %td= contest.startdate
      %td= contest.enddate
      %td= contest.titel
      %td= contest.deadline
      %td= contest.visible
      %td= link_to 'Show', contest
      %td= link_to 'Edit', edit_contest_path(contest)
      %td= link_to 'Destroy', contest, :confirm => 'Are you sure?', :method => :delete

%br

= link_to 'New Contest', new_contest_path

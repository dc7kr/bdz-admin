= bootstrap_form_for @contest,:layout=>:horizontal do |f|
  .container-fluid
    =f.text_field(:startdate)
    =f.text_field(:enddate)
    =f.text_field :titel
    =f.text_area :beschreibung
    =f.text_area :gebuehr
    =f.text_area :preis
    =f.text_area :anmeldung
    =f.text_field :deadline
    =f.text_field :reported
    =f.text_field :email
    =form_wrapped_field(f,@contest, :visible, f.check_box(:visible))
    .actions
      = submit_button()
      = cancel_button()

%tr
  %td.text-truncate= magazine_sampling.one_line_addr
  %td
    - if magazine_sampling.inactive
      %span.badge.bg-secondary=t("magazine_sampling.inactive")
      (
      = magazine_sampling.count
      )
    -else 
      = magazine_sampling.current_count
  %td
    = link_to_show magazine_sampling
    = link_to_edit magazine_sampling
    = link_to_delete magazine_sampling

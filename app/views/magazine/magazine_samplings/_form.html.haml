= bootstrap_form_for(@magazine_sampling, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  .container-fluid
    = f.fields_for :contact do |contact_form|
      = render :partial => "contacts/contact_form", :locals => { :f => contact_form,:contact=>@magazine_sampling.contact}
    =f.number_field :count
      
    =submit_button()
    = cancel_button()
    %br

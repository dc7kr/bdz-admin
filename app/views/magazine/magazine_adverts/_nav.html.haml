%ul.nav.nav-tabs
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_magazine_data_path
  %li{ :class=> tabActiveClass(@current_action,'index','first')}= link_to t("common.list"), magazine_issue_adverts_path(@magazine_issue)
  - if (@magazine_advert)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), '#'
  %li= link_to t("common.new"), new_magazine_issue_advert_path(@magazine_issue)


.block
  .content
    %h2.title
      Mail "#{@mail_params[:subject]}" versandt. 
    .inner
      Mail wurde erfolgreich an #{@orchCount} Orchester und #{@personCount} Einzelmitglieder gesendet.

      - if @results.size >0
        %h3 
          Beim Versenden an #{@orchFailCount} Orchester und #{@personFailCount} Einzelmitglieder und #{@testFailCount} Test Adressen sind Fehler aufgetreten. 
          %br

        %table.table
          %thead
            %th.first Typ
            %th= t("orchestra.mglnr")
            %th Fehler
          %tbody#results
            - @results.each do |result|
              %tr
                %td=result[:type]
                - if result[:type]== 'T' then
                  %td=result[:entity]
                - else
                  %td=link_to result[:entity].mglnr, result[:entity]
                %td=result[:err]
      .actions-bar.wat-cf
        .actions

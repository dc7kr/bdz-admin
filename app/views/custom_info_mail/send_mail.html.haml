.block
  .content
    %h2.title
      Mail "#{@mail_params[:subject]}" versandt. 
    .inner
      Mail wurde erfolgreich an #{@orchCount} Orchester,  #{@personCount} Einzelmitglieder, #{@festivalCount} Festival-Bewerber und #{@permittedCount} Festival-Teilnehmer gesendet.

      - if @results.size >0
        %h3 
          Beim Versenden an #{@orchFailCount} Orchester, #{@personFailCount} Einzelmitglieder, #{@festivalFailCount} Festival-Bewerber, #{@permittedFailCount} Festival-Teilnehmer und #{@testFailCount} Test Adressen sind Fehler aufgetreten. 
          %br

        %table.table
          %thead
            %th.first Typ
            %th= t("orchestra.email")
            %th Fehler
          %tbody#results
            - @results.each do |result|
              %tr
                %td=t("member_event.event_types."+result[:type])
                - if result[:type]== 'T' then
                  %td=result[:entity]
                - else
                  %td=link_to result[:entity].email, result[:entity]
                %td=result[:err]
      .actions-bar.wat-cf
        .actions

= form_for :email, :url => { :controller => 'custom_info_mail', :action => 'send_mail' } do |f|
  = f.label :event_id
  %br
  = f.text_field :event_id, :size => 60 
  %br
  = f.label :group
  %br
  = f.select :group, options_for_select([["Alle Mitglieder", "A"], ["Orchester", "O"],  ["Einzelmitglieder", "E"],["Test","T"],["Festival-Bewerber","F"],["Festival-Zulassungen","P"]],:selected=>"A") 
  %br
  = f.label :subject 
  %br
  = f.text_field :subject, :size => 60 
  %br
  = f.label :body 
  %br
  = f.text_area :body, :rols => 10, :cols => 60 
  %br
  = f.label :datafile
  \: 
  = f.file_field :datafile
  %br
  = submit_tag "Send Email "


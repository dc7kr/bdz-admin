.block
  .secondary-navigation
    
  .content
    .inner
      %h2=t('custom_info_mail',:count=>1)
      = bootstrap_form_for :email,  layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10" , :url => { :controller => 'custom_info_mail', :action => 'send_mail' } do |f|
        = f.text_field :event_id, :size => 60 
        = f.select :group, group_options
        = f.text_field :subject, :size => 60 
        = f.text_area :body, :rols => 10, :cols => 60 
        = f.check_box :via_paper
        = f.file_field :datafile
        = f.file_field :attachment
        %br
        = f.submit t('custom_info_mail.submit')


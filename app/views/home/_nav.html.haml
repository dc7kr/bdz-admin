%ul.nav.nav-tabs
  %li{ :class => tabActiveClass(@current_action,'public_data','first')}= link_to "#{t("main_menu.public_data")}", :controller=>"home",:action=>"public_data"
  %li{ :class => tabActiveClass(@current_action,'member_data',nil)}= link_to "#{t("main_menu.member_data")}", :controller=>"home",:action=>"member_data"
  %li{ :class => tabActiveClass(@current_action,'reference_data',nil)}= link_to "#{t("main_menu.reference_data")}", :controller=>"home",:action=>"reference_data"
  -if current_user.admin? then
    %li{ :class => tabActiveClass(@current_action,'admin_data','last')}= link_to "#{t("main_menu.admin_data")}", :controller=>"home",:action=>"admin_data"
  -if current_user.bulk_permission? then
    %li{ :class => tabActiveClass(@current_action,'cron','last')}= link_to "#{t("main_menu.cron")}", :controller=>"home",:action=>"cron"

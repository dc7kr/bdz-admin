.content
  .inner
    .container-fluid
      .row
        .col-md-4
          .panel.panel-default
            .panel-heading Musik
            %ul.nav.nav-pills.nav-stacked
              %li{:role=>"navigation"}= link_to t('festival_application',:count=>3), festival_applications_path
              %li{:role=>"navigation"}= link_to t('festival_perticipant',:count=>3), permitted_festival_applications_path
              %li{:role=>"navigation"}= link_to t('festival_concert',:count=>3), festival_concerts_path
        .col-md-4
          .panel.panel-default
            .panel-heading Administration
            %ul.nav.nav-pills.nav-stacked
              %li{:role=>"navigation"}= link_to t('event_meal',:count=>3), event_meals_path
              %li{:role=>"navigation"}= link_to t('event_card',:count=>3), event_cards_path
              %li{:role=>"navigation"}= link_to t('event_meal.arrival_overview'), arrival_overview_event_meals_path
              %li{:role=>"navigation"}= link_to t('competition_entry',:count=>3), competition_entries_path
        .col-md-4
          .panel.panel-default
            .panel-heading Tasks
            %ul.nav.nav-pills.nav-stacked
              %li{:role=>"navigation"}= link_to t('festival_mail',:count=>3), festival_mails_path
              %li{:role=>"navigation"}= link_to t('festival_mail.gen_invoices'), invoices_festival_mails_path
              %li{:role=>"navigation"}= link_to t('festival_mail.reservation_invoices'), reservation_invoices_festival_mails_path
- content_for :sidebar, render(:partial => 'sidebar.festival')

.secondary-navigation
  = render :partial=>"nav"
.content
  .inner
    .block
      .block-content
        %h3 Willkommen, #{current_user.name}.
        - restr = current_user.restricting_entity
        - if not restr.nil?  then
          Sie haben Zugriff auf die Daten 
          -if restr.class == RegionalOrganization then
            des Landesverbandes #{restr} (LV Nr. #{restr.nummer})
          -elsif restr.class == PersonMember or restr.class == Orchestra then
            des Mitgliedes Nr. #{restr.mglnr}
            
        

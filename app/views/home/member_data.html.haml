.content
  .inner
    .link-group
      %h3 Daten
      %ul.navigation
        %li= link_to "Orchester", orchestras_path 
        %li= link_to "Einzelmitglieder", person_members_path 
    - if current_user.has_role?(:admin) or current_user.has_role?(:national) 
      .link-group
        %h3 Berichte
        %ul.navigation
          %li= link_to "Mitgliederbericht", "/member_report"
          %li= link_to t('report_sheet.final'), final_report_sheets_path
          %li= link_to t('report_sheet.analysis'), analysis_report_sheets_path
- content_for :sidebar, render(:partial => 'sidebar')

.container
  %div{:data=>{:"turbo-prefetch" => "false" }}
    %ul.nav.nav-tabs{:role=>"tablist"}
      -if current_user.is_admin? or current_user.has_role? :accounting
        %li.nav-item
          %a.nav-link#report-sheet-tab.active{:data=> { :bs => {:toggle =>"tab" }}, :href=>"#report_sheets", :aria => {:controls=>"report_sheets", :selected=>true}, :role=>"tab"} 
            =t('report_sheet.other')
        %li.nav-item
          %a#tarriff-tab.nav-link{ :data => { :bs => {:toggle =>"tab" }}, :href=>"#tarriffs", :aria => {:controls=>"tarriff" }, :role => "tab"}
            =t('tariff',:count=>3)
        %li.nav-item
          %a#report-sheet-tab.nav-link{:data=> { :bs => {:toggle =>"tab" }}, :href=>"#members", :aria => {:controls=>"members" }, :role => "tab"} 
            =t('member',:count=>3)
    #tabContent.tab-content
      #report_sheets.tab-pane.fade.show.active{:role=>"tabpanel", :'aria-labelledby'=>"report-sheet-tab"}
        - if current_user.admin? 
          %ul.nav.flex-column
            %li.nav-item= link_to "Mahnungen Meldebogen", cron_reminders_report_sheet_path, method: :post, class: "nav-link"
            %li.nav-item= link_to "Meldebogen Anschreiben", "/api/rsm/gen_mailings", method: :post, class: "nav-link"
            %li.nav-item= link_to "Meldebogen-Eingabe generieren", generate_report_sheet_inputs_path, method: :post, class: "nav-link"
        - else
          %h5 Ab sofort durch automatisierte Jobs ersetzt
      #tarriffs.tab-pane.fade{:role => "tabpanel", :'aria-labelledby'=>"tarriff-tab"}
        %ul.nav.flex-column
          %li.nav-item= link_to t('cron.invoice_person_members'), cron_invoices_gen_persons_path, method: :post, class: "nav-link"
          %li.nav-item= link_to t('cron.invoice_orchestras'), cron_invoices_gen_orchestras_path, method: :post, class: "nav-link"
          %li.nav-item= link_to "Mahnungen Beitrag", cron_reminders_payment_path, method: :post, class: "nav-link"
          %li.nav-item= link_to t('cron.lv_fee_bookings'), cron_lv_fee_bookings_index_path, method: :post, class: "nav-link"
      #members.tab-pane.fade{:role => "tabpanel", :'aria-labelledby'=>"member-tab"}
        %ul.nav.flex-column
          %li.nav-item= link_to "Rundschreiben", custom_info_mail_path, class: "nav-link"
 



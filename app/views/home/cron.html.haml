.content
  .container-float
    %ul.nav.nav-tabs
      -if current_user.is_admin? or current_user.has_role? :accounting
        %li.nav-item
          %a.nav-link.active#report-sheet-tab{:data=> { :toggle =>"tab" }, :href=>"#report_sheets", :aria => {:controls=>"report_sheets", :selected=>true}, :role=>"tab"} 
            =t('report_sheet.other')
        %li.nav-item
          %a#tarriff-tab.nav-link{ "data-toggle" => "tab", :href=>"#tarriffs", :aria => {:controls=>"tarriff" }, :role => "tab"}
            =t('tariff',:count=>3)
        %li.nav-item
          %a#report-sheet-tab.nav-link{:data=> { :toggle =>"tab" }, :href=>"#members", :aria => {:controls=>"members" }, :role => "tab"} 
            =t('member',:count=>3)
        %li.nav-item
          %a#views-tab.nav-link{:data=> { :toggle =>"tab" }, :href=>"#generic_views", :aria => {:controls=>"views" }, :role => "tab"} 
            =t('generic_view',:count=>3)
    #tabContent.tab-content
      #report_sheets.tab-pane.fade.show.active{:role=>"tabpanel", :'aria-labelledby'=>"report-sheet-tab"}
        %ul.nav.flex-column
          %li.nav-item= link_to "Meldebogen Anschreiben", "/api/rsm/gen_mailings", class: "nav-link"
          %li.nav-item= link_to "Mahnungen Meldebogen", cron_reminders_report_sheet_path, class: "nav-link"
          %li.nav-item= link_to "Meldebogen-Eingabe generieren", generate_report_sheet_inputs_path, class: "nav-link"
      #tarriffs.tab-pane.fade{:role => "tabpanel", :'aria-labelledby'=>"tarriff-tab"}
        %ul.nav.flex-column
          %li.nav-item= link_to t('cron.invoice_person_members'), cron_invoices_gen_persons_path, class: "nav-link"
          %li.nav-item= link_to t('cron.invoice_orchestras'), cron_invoices_gen_orchestras_path, class: "nav-link"
          %li.nav-item= link_to t('cron.invoice_lorch'), cron_invoices_gen_lorch_path, class: "nav-link"
          %li.nav-item= link_to "Mahnungen Beitrag", cron_reminders_payment_path, class: "nav-link"
          %li.nav-item= link_to t('cron.lv_fee_bookings'), cron_lv_fee_bookings_index_path, class: "nav-link"
      #members.tab-pane.fade{:role => "tabpanel", :'aria-labelledby'=>"member-tab"}
        %ul.nav.flex-column
          %li.nav-item= link_to "Rundschreiben", custom_info_mail_path, class: "nav-link"
          %li.nav-item=link_to t('cron.remove_resigned'), cron_cleanup_remove_resigned_path, class: "nav-link"
      #generic_views.tab-pane.fade{:role => "tabpanel", :'aria-labelledby'=>"views-tab"}
        = bootstrap_form_tag(url: home_export_view_path, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
          = f.select(:view,@views, { class: "selectpicker", multiple: true, data: { "live-search": true }})
          = f.submit
  
- content_for :sidebar, render(:partial => 'sidebar.cron')


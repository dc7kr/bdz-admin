.content
  .container-float
    .row
      -if current_user.is_admin? or current_user.has_role? :accounting
        .col-md-4
          .panel.panel-default
            .panel-heading=t('report_sheet',:count=>3)
            .panel-body
              %ul.nav.nav-pills.nav-stacked
                %li= link_to "Meldebogen Anschreiben", "/api/rsm/gen_mailings"
                %li= link_to "Mahnungen Meldebogen", cron_reminders_report_sheet_path
                %li= link_to "Meldebogen-Eingabe generieren", generate_report_sheet_inputs_path
        .col-md-4
          .panel.panel-default
            .panel-heading=t('tariff',:count=>3)
            .panel-body
              %ul.nav.nav-pills.nav-stacked
                %li= link_to t('cron.invoice_person_members'), cron_invoices_gen_persons_path
                %li= link_to t('cron.invoice_orchestras'), cron_invoices_gen_orchestras_path
                %li= link_to t('cron.invoice_lorch'), cron_invoices_gen_lorch_path
                %li= link_to "Mahnungen Beitrag", cron_reminders_payment_path
                %li= link_to t('cron.lv_fee_bookings'), cron_lv_fee_bookings_index_path
        .col-md-4
          .panel.panel-default
            .panel-heading=t('member',:count=>3)
            .panel-body
              %ul.nav.nav-pills.nav-stacked
                %li=link_to t('cron.remove_resigned'), cron_cleanup_remove_resigned_path
- content_for :sidebar, render(:partial => 'sidebar.cron')


.block
  .secondary-navigation
    = render :partial =>'nav'
  .content
    %h2.title
      =t("festival_application.step2_title")
    .inner
      %h3=t('festival_application.planned_programme')
      %table#festival_pieces
        %tr
          %th=t('festival_piece.composer')
          %th=t('festival_piece.title')
          %th=t('festival_piece.duration')
        = render @festival_pieces 
      
      %h3=t('festival_application.add_piece')
      
      = form_for [:public,@festival_application,FestivalPiece.new], :remote => true do |f| 
        = f.error_messages 
        %table
          %tr
            %td= f.label :composer
            %td= f.label :title
            %td= f.label :duration
          %tr
            %td= f.text_field :composer
            %td= f.text_field :title
            %td= f.text_field :duration
            %td= f.submit  t('festival_piece.create_festival_piece')
  = wizard_forward_button(t('common.finalize'),finalize_public_festival_application_path(@festival_application))
- content_for :sidebar, render(:partial => 'sidebar')

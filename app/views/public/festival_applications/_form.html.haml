.block
  = f.error_messages :message => "", :header_tag => :h3
  -if @festival_application.errors.any? or @festival_application.contact_person.errors.any? then 
    #error_explanation

      %h2=t("activerecord.errors.template.header")
      %ul
        - @festival_application.errors.full_messages.each do |msg|
          %li= msg
        - @festival_application.contact_person.errors.full_messages.each do |msg|
          %li= msg
.group
  %table
    %tr
      %td= f.label :country_id, :class=> :label
      %td= f.collection_select(:country_id, Country.all, :id, :name) 
    %tr
      %td= f.label :group_type, :class => :label
      %td= f.select :group_type, options_for_select(get_group_type_options,:selected=>@festival_application.group_type)
    %tr
      %td= f.label :orch_name, :class => :label
      %td= f.text_field :orch_name
    %tr
      %td= f.label :conductor, :class => :label
      %td= f.text_field :conductor
    %tr
      %td= f.label :num_players, :class => :label
      %td= f.number_field :num_players
    %tr
      %td= f.label :contact_person, :class => :label
      %td
        =  fields_for(:contact_person, @festival_application.contact_person)  do |person_f|
          %table
            %tr
              %td=person_f.label :salutation
              %td=person_f.select :salutation, options_for_select(get_salutation_options,:selected=>@festival_application.contact_person.salutation)
            %tr
              %td=person_f.label :first_name
              %td=person_f.text_field :first_name 
            %tr
              %td=person_f.label :last_name
              %td=person_f.text_field :last_name
            %tr
              %td=person_f.label :street
              %td=person_f.text_field :street
            %tr
              %td=person_f.label :zip
              %td=person_f.text_field :zip
            %tr
              %td=person_f.label :city
              %td=person_f.text_field :city
            %tr
              %td=person_f.label :country
              %td=person_f.collection_select(:country_id, Country.all, :id, :name, :selected=>@festival_application.contact_person.country_id) 
            %tr
              %td=person_f.label :phone
              %td=person_f.text_field :phone
            %tr
              %td=person_f.label :email
              %td=person_f.text_field :email
    %tr
      %td= f.label :equipment, :class => :label
      %td= f.text_field :equipment
    %tr
      %td= f.label :special_cast, :class => :label
      %td= f.text_field :special_cast

  %button.button{:type => "submit"}
    = image_tag("web-app-theme/icons/tick.png", :alt => t("common.save"))
    = t("common.save_and_continue")
 

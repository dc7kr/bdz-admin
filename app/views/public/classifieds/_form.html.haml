= bootstrap_form_for([:public,@classified], layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f|
  =f.select :adv_type, options_for_select([["Biete", "1"], ["Suche", "0"]],:selected=>@classified.adv_type)
  =f.text_field :name
  =f.email_field :email
  =f.url_field :url
  =f.text_field :object
  =f.text_area :description
  = f.submit t("common.save")
  = link_to t("common.cancel"), url_for(:back), :class => "btn btn-default"



= form_for @classified,:html=>{ :class => "form-horizontal" } do |f|
  .block
    = f.error_messages :message => "", :header_tag => :h3
  .container-fluid
    =form_my_field(f,@classified, :object)
    =form_my_textarea(f,@classified, :description,80,5)
    =form_my_field(f,@classified, :validuntil,:date)
    =form_wrapped_field(f,@classified,:visible, f.check_box(:visible, :class => 'check_box'))
  .actions
    = f.submit t("common.save")
    = cancel_button()

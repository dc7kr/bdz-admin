= bootstrap_form_for([:public, @concert], layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f|
  .container-fluid
    .panel.panel-primary
      .panel-heading
        .panel-title
          Konzertdaten
      .panel-body 
        = f.text_field :titel
        = form_my_field(f,@concert, :concert_date,:datetime)
        = f.text_field :stadt
        = f.text_field :ort
        = f.select :bland, options_from_collection_for_select(@states, "id", "name")
        .form-group
          = f.label :country_code, {class: "control-label col-sm-2"}
          .col-md-10
            = f.country_select(:country_code, { iso_codes:true }, { class:  "form-control"})

        = f.text_field :eintritt
        = f.select :festival, options_from_collection_for_select(@festivals, "id", "name")
        = f.text_area :comment
    .panel.panel-primary 
      .panel-heading
        .panel-title
          Mitglieder
      .panel-body
        = f.number_field :mglnr
        %span.badge.bg-info Hinweis: Durch Eingabe der Mitgliedsnummer wird automatisch Homepage und Veranstalter aus unseren Daten übernommen. 

    .panel.panel-default
      .panel-heading
        .panel-title
          Nicht-Mitglieder
      .panel-body
        = f.text_field :interpret
        = f.url_field :url
        = f.email_field :email 

  .actions
    = submit_button
    = cancel_button

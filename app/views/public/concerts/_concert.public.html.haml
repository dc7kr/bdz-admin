.concert_data
  %a{:name => "#{'O'+String(concert.id)}"}
  %span.concert_date= l(concert.concert_date)
  %span.concert_title= concert.titel
  %span.concert_performer
    - if not concert.url.nil? and not concert.url.empty? then 
      %a{:href=>"#{concert.url}",:target=>"_blank", :onclick=>"meldung()"}=concert.interpret
    -else
      =concert.interpret
  %span.concert_location
    = concert.ort
    ,
    = concert.stadt

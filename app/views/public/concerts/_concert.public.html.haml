%dt
  %a{:name => "#{'O'+String(concert.id)}"}
  = l(concert.concert_date)
  ,
  = concert.stadt
  ,
  = concert.ort
  ,
%dd.title=concert.titel
%dd
  %a{:href=>"#{concert.url}",:target=>"_blank", :onclick=>"meldung()"}
    =concert.interpret
  %i
    =concert.comment
  = link_to_show concert
  = link_to_edit concert
  = link_to_delete concert

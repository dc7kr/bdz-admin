%p 
  #{t('event_card.order_confirm.thanks',:email => @event_card.email, :nr=>@event_card.id )}

.heading 
  #{t('event_card.order_confirm.heading', :nr=> @event_card.id )}
%table 

  - @event_card.ordered_cards.each do |c|
    -if c.count >0 
      %tr
        %td.number=c.count
        %td=t('event_card.'+c.key)
        %td=t('event_card.each_price', { :price => c.price})
        %td.number="%.2f EUR" % c.total

  %tr
    %td &nbsp;
    %td.sum=t('common.sum')
    %td &nbsp;
    %td{:class=> "sum number"}="%.2f EUR" % @event_card.sum


.block
  .secondary-navigation
    = render :partial => '_nav'
  .content
    %h2.title
      = t("common.edit")
      = t("regional_organization.s")
    .inner
      = form_for @regional_organization, :url => regional_organization_path(@regional_organization), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

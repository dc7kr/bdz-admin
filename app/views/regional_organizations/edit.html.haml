.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", regional_organizations_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_regional_organization_path
      %li.active= link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_regional_organization_path
  .content
    %h2.title
      = t("web-app-theme.edit", :default => "Edit")
      RegionalOrganization
    .inner
      = form_for @regional_organization, :url => regional_organization_path(@regional_organization), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

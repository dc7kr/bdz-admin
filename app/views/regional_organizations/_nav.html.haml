%ul.nav.nav-tabs
  - if @regional_organization
    %li.nav_item= link_to_up_path t("common.up"), regional_organizations_path
    -if current_user.national_permission?
      %li.nav-item=link_to t("common.show"), @regional_organization, class: nav_action_class("show", "nav-link")
      %li.nav-item=link_to t("common.edit"), edit_regional_organization_path(@regional_organization), class: nav_action_class("edit","nav-link")
  -else 
    %li.nav-item= link_to_up_path t("common.up"), home_member_data_path
  - if can? :create, PersonMember
    %li.nav-item= nav_to_new RegionalOrganization


%ul.nav.nav-tabs
  - if @regional_organization
    %li.first= link_to_up_path t("common.up"), regional_organizations_path
    -if current_user.national_permission?
      %li{ :class => tabActiveClass(@current_action,'show',nil)}=link_to t("common.show"), @regional_organization
      %li{ :class => tabActiveClass(@current_action,'edit',nil)}=link_to t("common.edit"), edit_regional_organization_path(@regional_organization)
  -else 
    %li.first= link_to_up_path t("common.up"), home_member_data_path
  - if can? :create, PersonMember
    %li.nav-item= nav_to_new RegionalOrganization


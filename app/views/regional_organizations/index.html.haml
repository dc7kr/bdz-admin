.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      = t("common.all")
      =t("regional_organization",:count=>3)
    .inner
      %table.table.table-hover.table-condensed
        %tr
          %th.first ID
          %th
            = attr_heading(RegionalOrganization,:name)
          %th= attr_heading(RegionalOrganization,:homepage)
          %th.last &nbsp;
        = render @regional_organizations
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

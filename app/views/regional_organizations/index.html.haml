.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      = t("common.all")
      =t("regional_organization.p")
    .inner
      %table.table
        %tr
          %th.first ID
          %th
            = t("activerecord.attributes.regional_organization.name")
          %th= t("regional_organization.homepage")
          %th.last &nbsp;
        = render @regional_organizations
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

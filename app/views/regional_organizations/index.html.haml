.block
  .secondary-navigation
    %ul.wat-cf
      %li.first.active= link_to "#{t("web-app-theme.list", :default => "List")}", regional_organizations_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_regional_organization_path
  .content
    %h2.title
      = t("common.all")
      RegionalOrganizations
    .inner
      %table.table
        %tr
          %th.first ID
          %th
            = t("activerecord.attributes.regional_organization.name", :default => t("activerecord.labels.nummer", :default => "Nummer"))
          %th= t("regional_organization.homepage")
          %th.last &nbsp;
        = render @regional_organizations
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

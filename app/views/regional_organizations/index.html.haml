.block
  .secondary-navigation
    %ul.wat-cf
      %li.first.active= link_to "#{t("web-app-theme.list", :default => "List")}", regional_organizations_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_regional_organization_path
  .content
    %h2.title
      = t("web-app-theme.all", :default => "All")
      RegionalOrganizations
    .inner
      %table.table
        %tr
          %th.first ID
          %th
            = t("activerecord.attributes.regional_organization.name", :default => t("activerecord.labels.nummer", :default => "Nummer"))
          %th= t("web-app-theme.created_at", :default => "Created at")
          %th.last &nbsp;
        - @regional_organizations.each do |regional_organization|
          %tr{:class => cycle("odd", "even")}
            %td
              = regional_organization.id
            %td
              = link_to regional_organization.name, regional_organization_path(regional_organization)
            %td
              = regional_organization.created_at
            %td.last
              = link_to "#{t("web-app-theme.show", :default => "Show")}", regional_organization_path(regional_organization)
              |
              \#{link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_regional_organization_path(regional_organization)} |
              \#{link_to "#{t("web-app-theme.delete", :default => "Delete")}", regional_organization_path(regional_organization), :method => :delete, :confirm => "#{t("web-app-theme.confirm", :default => "Are you sure?")}"}
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      =t("regional_organization.p")
    %h3.title
      =t("regional_organization.share_overview")
      =t("common.due_date")
      =l @before
    .inner
      %table
        %tr
          %th=t('regional_organization.name')
          %th=t('report_sheet.lv_part')
          %th=t('report_sheet.sum')
          %th=t('report_sheet.uv')
        - @regional_organization_shares.each do |s|
          %tr
            %td=s[:regional_organization].name
            %td.currency=format_currency s[:lvpart]
            %td.currency=format_currency s[:sum]
            %td.currency=format_currency s[:uv]
        %tr
          %td
            %b=t('common.sum')
          %td.currency
            %b=format_currency @uv_sum
          %td.currency
            %b=format_currency @part_sum
          %td.currency
            %b=format_currency @full_sum

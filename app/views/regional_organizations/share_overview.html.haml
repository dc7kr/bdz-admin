.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      =t("regional_organization",:count=>3)
    %h3.title
      =t("regional_organization.share_overview")
      =t("common.due_date")
      =l @before
    .inner
      %table.table.table-condensed
        %tr
          %th &nbsp;
          %th{:colspan=>3} LV Anteile
          %th{:colspan=>2} Gesamt
          %th{:colspan=>4} SEPA Verfahren
        %tr
          %th=t('regional_organization.name')
          %th EM
          %th Orchester
          %th Summe
          %th=t('report_sheet.sum')
          %th UV
          %th EM
          %th Orchester
          %th Summe
          %th UV
        - @regional_organization_shares.each do |s|
          %tr
            %td=s[:regional_organization].name
            %td.currency=format_currency s[:em_part]
            %td.currency=format_currency s[:orch_part]
            %td.currency
              =format_currency s[:orch_part]+s[:em_part]
              - if s[:pre_paid] != 0
                %br
                Vorauszahung: 
                %br
                =format_currency s[:pre_paid]
            %td.currency=format_currency s[:sum]
            %td.currency=format_currency s[:uv]
            %td.currency=format_currency s[:dd_em_part]
            %td.currency=format_currency s[:dd_orch_part]
            %td.currency=format_currency s[:dd_sum]
            %td.currency=format_currency s[:dd_uv]
        %tr
          %td
            %b=t('common.sum')
          %td.currency
            %b=format_currency @s[:lv_em_sum]
          %td.currency
            %b=format_currency @s[:lv_orch_sum]
          %td.currency
            %b=format_currency @s[:lv_sum]
          %td.currency
            %b=format_currency @s[:full_sum]
          %td.currency
            %b=format_currency @s[:uv_sum]
          %td.currency
            %b=format_currency @s[:dd_em_sum]
          %td.currency
            %b=format_currency @s[:dd_orch_sum]
          %td.currency
            %b=format_currency @s[:dd_sum]
          %td.currency
            %b=format_currency @s[:dd_uv_sum]

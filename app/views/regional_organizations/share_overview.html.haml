.secondary-navigation
  = render :partial => 'nav'
.container
  %h2
    =t("regional_organization",:count=>3)
  %h3
    =t("regional_organization.share_overview")
    =t("common.due_date")
    =l @before

  %table.table-sm.table-condensed.table-bordered
    %tr
      %th &nbsp;
      %th{:colspan=>3} LV Anteile
      %th{:colspan=>2} Gesamt
      %th{:colspan=>4} SEPA Verfahren
    %tr
      %th=t('regional_organization.name')
      %th EM
      %th Orchester
      %th Summe
      %th=t('report_sheet.sum')
      %th UV
      %th EM
      %th Orchester
      %th Summe
      %th UV
    - @regional_organization_shares.each do |fs|
      %tr
        %td=fs.regional_organization.name
        %td.currency=format_currency fs.persons_share
        %td.currency=format_currency fs.orchestras_share
        %td.currency
          -if fs.is_corrected?
            =format_currency fs.corrected_share
            (
            =format_currency fs.real_share
            )
          -else
            =format_currency fs.real_share
          - if fs.pre_paid != 0
            %br
            Vorauszahung: 
            %br
            =format_currency fs.pre_paid
        %td.currency=format_currency fs.total
        %td.currency=format_currency fs.insurance_total
        %td.currency=format_currency fs.direct_debit.persons
        %td.currency=format_currency fs.direct_debit.orchestras
        %td.currency=format_currency fs.direct_debit.total
        %td.currency=format_currency fs.direct_debit.insurance
    %tr
      %td
        %b=t('common.sum')
      %td.currency
        %b=format_currency @s[:lv_em_sum]
      %td.currency
        %b=format_currency @s[:lv_orch_sum]
      %td.currency
        %b=format_currency @s[:lv_sum]
      %td.currency
        %b=format_currency @s[:full_sum]
      %td.currency
        %b=format_currency @s[:uv_sum]
      %td.currency
        %b=format_currency @s[:dd_em_sum]
      %td.currency
        %b=format_currency @s[:dd_orch_sum]
      %td.currency
        %b=format_currency @s[:dd_sum]
      %td.currency
        %b=format_currency @s[:dd_uv_sum]


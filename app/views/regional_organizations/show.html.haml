.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    .inner
      %h2= @regional_organization.nummer
      %h2= @regional_organization.name
      -if not @regional_organization.valid?
        %h3
          - regional_organization.errors.each do |e|
            = e.message
            
      %table
        %tr
          %td.label= label :regional_organization, :subname
          %td= @regional_organization.subname
        %tr
          %td.label=label :regional_organization,:homepage
          %td= link_to @regional_organization.homepage,@regional_organization.homepage
        %tr
          %td.label=label :regional_organization,:jugend_url
          %td= link_to @regional_organization.jugend_url,@regional_organization.jugend_url
        %tr
          %td.label= label :regional_organization, :iban
          %td= @regional_organization.iban
        %tr
          %td.label= label :regional_organization,:bic
          %td= @regional_organization.bic

      .wat-cf
        = link_to_edit @regional_organization
        = del_button @regional_organization,@regional_organization

    %table
      = render @functions


- content_for :sidebar, render(:partial => 'sidebar.show')

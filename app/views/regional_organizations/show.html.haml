.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", regional_organizations_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_regional_organization_path
      %li.active= link_to "#{t("web-app-theme.show", :default => "Show")}", regional_organization_path
  .content
    .inner
      %p
        %b
          = label :regional_organization, :nummer
          \:
        = @regional_organization.nummer
      %p
        %b
          = label :regional_organization, :name
          \:
        = @regional_organization.name
      %p
        %b
          = label :regional_organization, :subname
          \:
        = @regional_organization.subname
      %p
        %b
          = label :regional_organization, :homepage
          \:
        = link_to @regional_organization.homepage,@regional_organization.homepage
      %p
        %b
          = label :regional_organization, :jugend_url
          \:
        = link_to @regional_organization.jugend_url,@regional_organization.jugend_url
      %p
        %b
          #{label :regional_organization, :jugend_url}\:
        = @regional_organization.konto
      %p
        %b
          #{label :regional_organization, :blz}\:
        = @regional_organization.blz
      .wat-cf
        = link_to_edit @regional_organization

        = del_button @regional_organization,@regional_organization


- content_for :sidebar, render(:partial => 'sidebar.show')

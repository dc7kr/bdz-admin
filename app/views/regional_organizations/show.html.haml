.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", regional_organizations_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_regional_organization_path
      %li.active= link_to "#{t("web-app-theme.show", :default => "Show")}", regional_organization_path
  .content
    .inner
      %p
        %b
          = t("activerecord.attributes.regional_organization.nummer", :default => t("activerecord.labels.nummer", :default => "Nummer"))
          \:
        = @regional_organization.nummer
      %p
        %b
          = t("activerecord.attributes.regional_organization.name", :default => t("activerecord.labels.name", :default => "Name"))
          \:
        = @regional_organization.name
      %p
        %b
          = t("activerecord.attributes.regional_organization.subname", :default => t("activerecord.labels.subname", :default => "Subname"))
          \:
        = @regional_organization.subname
      %p
        %b
          = t("activerecord.attributes.regional_organization.homepage", :default => t("activerecord.labels.homepage", :default => "Homepage"))
          \:
        = @regional_organization.homepage
      %p
        %b
          = t("regional_organization.jugend_url")
          \:
        = @regional_organization.jugend_url
      %p
        %b
          = t("regional_organization.konto")
          \:
        = @regional_organization.konto
      %p
        %b
          = t("regional_organization.blz")
          \:
        = @regional_organization.blz
      .wat-cf
        = link_to image_tag("web-app-theme/icons/application_edit.png", :alt => "#{t("web-app-theme.edit", :default=> "Edit")}") + " " + t("web-app-theme.edit", :default=> "Edit"), edit_regional_organization_path(@regional_organization), :class => "button"
        = link_to image_tag("web-app-theme/icons/cross.png", :alt => "#{t("web-app-theme.delete", :default=> "Delete")}") + " " + t("web-app-theme.delete", :default => "Delete"), regional_organization_path(@regional_organization), :method => "delete", :class => "button", :confirm => "#{t("web-app-theme.confirm", :default => "Are you sure?")}"
- content_for :sidebar, render(:partial => 'sidebar.show')

= bootstrap_form_for @regional_organization, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10" do |f|
  - if @regional_organization.errors.any? then
    - @regional_organization.errors.each do |k,v|
      = k 
      = v
  = f.number_field :nummer, :required=>true
  = f.text_field :name, :required=>true
  = f.text_field :subname
  = f.url_field :homepage
  = f.url_field :jugend_url
  = f.text_field :gema_kdnr
  = f.text_field :gema_kdnr_new
  = f.fields_for :member do |member_form|
    = render :partial => "members/member_form", :locals => { :f => member_form,:member=>@regional_organization.member}
  = form_my_field(f,@regional_organization,:iban, :static)
  = form_my_field(f,@regional_organization,:bic, :static)

  .actions
    =submit_button
    =cancel_button

= bootstrap_form_for @regional_organization, layout: :horizontal do |f|
  = f.number_field :nummer, :required=>true
  = f.text_field :name, :required=>true
  = f.text_field :subname
  = f.url_field :homepage
  = f.url_field :jugend_url
  = f.text_field :gema_kdnr
  = f.text_field :gema_kdnr_new
  = f.fields_for :member do |member_form|
    = render :partial => "members/member_form", :locals => { :f => member_form,:member=>@regional_organization.member}

  =f.submit t("common.save")
  =cancel_button

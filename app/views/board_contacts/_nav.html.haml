%ul.wat-cf
  %li.first= link_to_up_path(t('common.up'),home_public_data_path);
  %li{ :class => tabActiveClass(@current_action,'index',nil)}= link_to t("common.list"), board_contacts_path
  -if (@board_contact and @board_contact.id ) then 
    %li{:class => tabActiveClass(@current_action,'edit',nil)}= link_to t("common.edit"), edit_board_contact_path(@board_contact)
    %li{:class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), board_contact_path(@board_contact)
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to t("common.new"), new_board_contact_path


.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("board_contact",:count=>3)
    .inner
      #enty_info.text-center
        = page_entries_info @board_contacts
      %table.table-sm.table-hover.table-condensed
        %thead
          %th.first= attr_heading Contact, :last_name
          %th= sortable "email", attr_heading(Contact,:email )
          %th.last &nbsp;
        %tbody#board_contacts
          =render @board_contacts
      #paginator
        = paginate @board_contacts, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')



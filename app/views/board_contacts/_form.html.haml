.block
.group
  .container-fluid
    = bootstrap_form_for(@board_contact, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
      = f.fields_for :contact do |contact_form|
        = render :partial => "contacts/contact_form", :locals => { :f => contact_form,:contact=>@board_contact.contact}
      .actions
        =submit_button
        = cancel_button()
  %br

=turbo_stream.append("notifications") do
  .toast.text-bg-primary{id: "toast_#{toast_id}", "aria-atomic" => "true", "aria-live" => "assertive", :role => "alert"}
    .toast-header
      %i.fas.fa-info-circle
      %strong.me-auto Job Notification:
      %small#rt_time
      %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "toast", :type => "button"}
    .toast-body
      ="#{timestamp}:#{message}"

%turbo-stream{:action => "show_toast", :id=> "toast_#{toast_id}"}


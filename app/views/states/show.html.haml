.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", states_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_state_path
      %li.active= link_to "#{t("web-app-theme.show", :default => "Show")}", state_path
  .content
    .inner
      %p
        %b
          = t("activerecord.attributes.state.land")
          \:
        = @state.country
      %p
        %b
          = t("activerecord.attributes.state.name", :default => t("activerecord.labels.name", :default => "Name"))
          \:
        = @state.name
      .wat-cf
        = link_to image_tag("web-app-theme/icons/application_edit.png", :alt => "#{t("web-app-theme.edit", :default=> "Edit")}") + " " + t("web-app-theme.edit", :default=> "Edit"), edit_state_path(@state), :class => "button"
        = link_to image_tag("web-app-theme/icons/cross.png", :alt => "#{t("web-app-theme.delete", :default=> "Delete")}") + " " + t("web-app-theme.delete", :default => "Delete"), state_path(@state), :method => "delete", :class => "button", :confirm => "#{t("web-app-theme.confirm", :default => "Are you sure?")}"
- content_for :sidebar, render(:partial => 'sidebar')

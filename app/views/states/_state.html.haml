%tr{:class => cycle("odd", "even")}
  %td
    = state.id
  %td
    - if ( state.country ) 
      =  link_to state.country.name,country_path(state.country)
    - else
      keines
  %td
    = link_to state.name, state_path(state)
  %td.last
    = link_to "#{t("web-app-theme.show", :default => "Show")}", state_path(state)
    |
    \#{link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_state_path(state)} |
    \#{link_to "#{t("web-app-theme.delete", :default => "Delete")}", state_path(state), :method => :delete, :confirm => "#{t("web-app-theme.confirm", :default => "Are you sure?")}"}


.block
  .secondary-navigation
    = render :partial=>"nav"
  .content
    %h2.title
      = t("common.all")
      = t("state",:count=>3)
    .inner
      %table.table.table-hover.table-condensed
        %tr
          %th.first ID
          %th=label :state,:country_id
          %th=label :state,:name
          %th.last &nbsp;
        = render @states
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

.block
  .secondary-navigation
    %ul.wat-cf
      %li.first.active= link_to "#{t("web-app-theme.list", :default => "List")}", states_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_state_path
  .content
    %h2.title
      = t("web-app-theme.all", :default => "All")
      States
    .inner
      %table.table
        %tr
          %th.first ID
          %th
            = t("activerecord.attributes.state.country_id", :default => t("activerecord.labels.country_id", :default => "Land"))
          %th= t("web-app-theme.created_at", :default => "Created at")
          %th.last &nbsp;
        - @states.each do |state|
          %tr{:class => cycle("odd", "even")}
            %td
              = state.id
            %td
              = link_to state.country, state_path(state)
            %td
              = state.created_at
            %td.last
              = link_to "#{t("web-app-theme.show", :default => "Show")}", state_path(state)
              |
              \#{link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_state_path(state)} |
              \#{link_to "#{t("web-app-theme.delete", :default => "Delete")}", state_path(state), :method => :delete, :confirm => "#{t("web-app-theme.confirm", :default => "Are you sure?")}"}
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

.block
  .secondary-navigation
    %ul.wat-cf
      %li.first.active= link_to "#{t("web-app-theme.list", :default => "List")}", states_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_state_path
  .content
    %h2.title
      = t("common.all")
      States
    .inner
      %table.table
        %tr
          %th.first ID
          %th= t("activerecord.attributes.state.country_id")
          %th= t("activerecord.attributes.state.name")
          %th.last &nbsp;
        = render @states
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

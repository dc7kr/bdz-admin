.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", states_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_state_path
      %li.active= link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_state_path
  .content
    %h2.title
      = t("web-app-theme.edit", :default => "Edit")
      State
    .inner
      = form_for @state, :url => state_path(@state), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

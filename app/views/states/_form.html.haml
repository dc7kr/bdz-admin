.group
  = f.label :country, :class => :label
  = collection_select(:state, :country_id, Country.order(:name), :id, :name) 

.group
  = f.label :name, :class => :label
  = f.text_field :name, :class => 'text_field'
  %button.button{:type => "submit"}
    = image_tag("web-app-theme/icons/tick.png", :alt => "#{t("common.save", :default => "Save")}")
    = t("web-app-theme.save", :default => "Save")
  %span.text_button_padding= t("common.or", :default => "or")
  = cancel_button() 

.block
  .secondary-navigation
    
  %h2 SEPA File regeneration

  .card
    .card-body
      %h5.card-title SEPA File regeneration Nach Buchungstext
      = bootstrap_form_for :sepa, :url => { :controller => 'sepa_regeneration', :action => 'regenerate' } do |f|
        = f.text_field :booking_txt, :size => 60 
        = f.submit t('common.send'), data: {turbo: false}
  .card
    .card-body
      %h5.card-title Nach Datum
      = bootstrap_form_for :sepa, :url => { :controller => 'sepa_regeneration', :action => 'regenerate_by_date_and_type' } do |f|
        = f.text_field :booking_date, :size => 60 
        = f.select :member_type, [ ["Orchestra","Orchestra"],["PersonMember","PersonMember"]]

        = f.select :member_sub_type, [["Any",""],["Vereinsorchester","O"],["Koop","K",],["Landesorchester","L"]]
        = f.text_field :max_mglnr, :size => 5
        = f.submit  t('common.send'), data: {turbo: false}

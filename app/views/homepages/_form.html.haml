.container-liquid
  = bootstrap_form_for(@homepage, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
    = f.text_field :abbrev
    = f.number_field :mitglnr
    =f.text_field :name
    =f.text_area :kontakt, cols:80, rows: 5 
    =f.text_area :proben, rols: 80, rows:5 
    =f.text_area :descr, cols:80, rows:5
    =f.date_field :created_at
    =f.date_field :updated_at
    =f.url_field :redir_url 

    =f.submit
    =cancel_button

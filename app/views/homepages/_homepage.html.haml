%tr
  %td.first= homepage.abbrev
  %td
    - if ! homepage.member_exists?
      %span.badge.bg-danger kein Mitglied

    = homepage.mitglnr
  %td= homepage.name
  %td= l homepage.created_at unless homepage.created_at.nil?
  %td= l homepage.updated_at unless homepage.updated_at.nil?
  %td= homepage.redir_url
  %td
    = link_to_show homepage
    = link_to_edit homepage
    = link_to_delete homepage



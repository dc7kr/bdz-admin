.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      = t("common.edit")
      = t('homepages',:count=>1)
    .inner
      = form_for @homepage do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

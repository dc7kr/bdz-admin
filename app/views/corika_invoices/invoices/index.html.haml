.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("invoice",:count=>3)
    .inner
      %table.table-sm
        %thead
          %tr
            %th.first Domain
            %th Rechnungs-Nr
            %th Datum
            %th Netto
            %th Brutto
            %th
            %th.last &nbsp;
        %tbody#invoices
          =render @invoices
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

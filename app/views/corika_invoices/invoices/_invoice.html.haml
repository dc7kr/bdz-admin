%tr
  //%td=link_to [:invoice_engine, invoice], invoice.id
  %td=invoice.id
  %td=invoice.number
  %td=l(invoice.invoice_date)
  %td=invoice.net_sum
  %td=invoice.sum
  %td
    =link_to_show invoice, authz: false
    =link_to "PDF",invoice_engine.gen_pdf_invoice_path(invoice)
    =link_to "SEPA",invoice_engine.gen_sepa_invoice_path(invoice)

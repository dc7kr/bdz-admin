.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %h3
        #{t("magazine_issue.counts")}
        #{t("magazine_issue.s")} #{@magazine_issue.number}/#{@magazine_issue.year}

%table 
  %tr
    %td.label_l=t("magazine_sampling.p")
    %td.number=@magazine_samplings
  %tr
    %td.label_l=t("subscriber.p")
    %td.number=@subscribers
  %tr 
    %td.label_l=t("advertiser.p")
    %td.number=@adverts
  %tr
    %td.label_l=t("orchestra.p")
    %td.number=@orchestra_count
  %tr
    %td.label_l=t("person_member.p")
    %td.number=@person_member_count
  %tr
    %td.label_l=t("common.sum")
    %td.sum=@overall


   


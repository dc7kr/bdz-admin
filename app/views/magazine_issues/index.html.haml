.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("magazine_issue.p")
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %th.first=t('common.year')
          %th=attr_heading(MagazineIssue,:number)
          %th.last
        = render @magazine_issues
      #paginator
        = paginate @magazine_issues

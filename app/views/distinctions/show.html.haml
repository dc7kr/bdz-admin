.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %h3
        #{t("distinction",:count=>1)}
        &nbsp;
        #{@distinction.orchestra.orchName} (#{@distinction.orchestra.member.mglnr.to_s})
      .container-fluid
        =entity_row @distinction, :dist_date,:date
        =entity_row @distinction, :gold_needles
        =entity_row @distinction, :silver_needles
        =entity_row @distinction, :national_needles
        =entity_row @distinction, :certificates
        =entity_row @distinction, :honorletters
        =entity_row @distinction, :medals
        =entity_row @distinction, :porto, :currency

        .row 
          .col-md-3.text-end=t("invoice", count: 1)
          .col-md-9
            = link_to 'Rechnungsvorschau', invoice_preview_orchestra_distinction_path(@distinction.orchestra,@distinction),  data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'
            - if not @distinction.invoice_id.present?
              = generate_button(t('distinction.generate_invoice'), gen_invoice_orchestra_distinction_path(@orchestra,@distinction), @distinction)
            - else
              - invoice = CorikaInvoices::Invoice.find(@distinction.invoice_id)
              %b Nr. #{invoice.full_number} vom #{l invoice.invoice_date}
              = link_to_download_path(t('common.download'),download_orchestra_member_account_booking_path(@orchestra,@distinction.member_account_booking),@distinction.member_account_booking)

      
      = edit_button edit_orchestra_distinction_path(@distinction.orchestra,@distinction), @distinction

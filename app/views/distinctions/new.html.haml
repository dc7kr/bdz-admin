.block
  .secondary-navigation
    = render :partial =>'nav'
  .content
    %h2.title
      = t("common.new")
      = t("distinction",:count=>1)
    .inner
      %h3= @orchestra.orchName
      = bootstrap_form_for([@orchestra,@distinction],  :layout=> :horizontal) do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

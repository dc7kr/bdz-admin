
%b Rechnung Nr. #{invoice.full_number} vom #{l invoice.invoice_date}

- invoice.items.each do |i|
  .row
    .col-md-3.text-end
      %label=i.label
    .col-md-1.text-end=i.count
    .col-md-1 x
    .col-md-2.text-end=format_currency(i.basis)
    .col-md-2.text-end=format_currency(i.total)
%hr.calc
.row
  .col-md-3.text-end
    %label=t("common.sum")
  .col-md-4.text-end
  .col-md-2.text-end=format_currency(invoice.sum)
.row
  .col-md-3.text-end
    %label=t("common.incl_tax")
  .col-md-4.text-end
  .col-md-2.text-end=format_currency(invoice.sum-invoice.net_sum)
%hr.calc_final


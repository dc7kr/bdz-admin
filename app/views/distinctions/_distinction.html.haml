%tr
  %td.text-center= format_date(distinction.dist_date)
  %td.text-center= distinction.silver_needles
  %td.text-center= distinction.gold_needles
  %td.text-center= distinction.national_needles
  %td.text-center= distinction.certificates
  %td.text-center= distinction.honorletters
  %td.text-center= distinction.medals
  %td.border-0
    = link_to_show distinction, orchestra_distinction_path(@orchestra,distinction)
    = link_to_edit distinction, edit_orchestra_distinction_path(@orchestra,distinction)
    = link_to_delete distinction, orchestra_distinction_path(@orchestra,distinction)
    - if (distinction.member_account_booking == nil)
      = link_to_generate_path t('distinction.generate_invoice'), gen_invoice_orchestra_distinction_path(@orchestra,distinction)
    - else
      = link_to_download_path distinction.member_account_booking, download_orchestra_member_account_booking_path(@orchestra,distinction.member_account_booking)


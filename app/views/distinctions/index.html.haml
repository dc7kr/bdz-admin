.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("distinction.p")
      = @orchestra.orchName
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %th.first= sortable "dist_date", label(:distinction, :dist_date)
          %th=label :distinction, :silver_needles
          %th=label :distinction, :gold_needles
          %th=label :distinction, :national_needles
          %th=label :distinction, :certificates
          %th=label :distinction, :honorletters
          %th=label :distinction, :medals
          %th.last &nbsp;
        %tbody#distinctions
          =render @distinctions
      #paginator
        = paginate @distinctions, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

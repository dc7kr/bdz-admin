.container-fluid
  = bootstrap_form_for([@orchestra,@distinction],  :layout=> :horizontal) do |f|
    = f.date_field :dist_date
    = f.number_field :gold_needles
    = f.number_field :silver_needles
    = f.number_field :national_needles
    = f.number_field :certificates
    = f.number_field :honorletters
    = f.number_field :medals

    = form_my_field(f,@distinction, :porto,:currency)
    .actions
      =f.submit 
      =cancel_button

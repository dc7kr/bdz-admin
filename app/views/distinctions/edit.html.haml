.block
  .secondary-navigation
    %ul.wat-cf
      = render :partial => 'nav'
  .content
    %h2.title
      = t("web-app-theme.edit", :default => "Edit")
      = t("distinction",:count=>1)
    .inner
      %h3= @orchestra.orchName
      = bootstrap_form_for [@orchestra,@distinction],  :layout=> :horizontal, :url => orchestra_distinction_path(@orchestra,@distinction), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

%tr
  %td= festival_application.id
  %td
    = display_group_visitor_type(festival_application)
    %br
    %b
      = festival_application.orch_name
    - if festival_application.ticket_warning?
      %span.badge.bg-warning=t("festival_application.ticket_deviation")
    - if festival_application.payment_mismatch?
      %span.badge.bg-danger=t("festival_applications.payment_mismatch")
    %br
    #{t('festival_application.conductor')}: #{festival_application.conductor}
    %br
    -if festival_application.contact_person.nil? then
      nix
    -else
      = mail_to festival_application.contact_person.email, festival_application.contact_person.email
  %td= festival_application.num_players
  %td= festival_application.tickets_total
  %td= t("festival_application.payment_states.#{festival_application.payment_status}")
  %td=format_currency festival_application.amount
  %td
    .btn-group
      =link_to_show festival_application
      =link_to_edit festival_application
      =link_to_delete festival_application



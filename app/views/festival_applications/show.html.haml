.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    #{t("festival_application",:count=>1)} Nr. #{@festival_application.id}
    - if @festival_application.permission
      (#{t('festival_application.permission_granted')})
    %br
    =@festival_application.orch_name
  =link_to "Datenblatt", gen_participant_sheet_festival_application_path(@festival_application),:class=>"btn btn-primary btn-sm", data: { turbo:false }
  = link_to t("festival_application.public_view"), ef_festival_application_path(@festival_application), class: 'btn btn-primary btn-sm'
  .container-fluid.mt-3
    .card.mb-2
      .card-header#headingOne
        %h4=t("festival_applications.general_panel_title")

      .card-body
        =custom_entity_row(t("festival_application.group_type"), display_group_type(@festival_application.group_type))
        =custom_entity_row(t("festival_application.visitor_type"), display_visitor_type(@festival_application.visitor_type))
        =entity_row(@festival_application,:contact_phone)
        =entity_row(@festival_application,:country_code,:country)
        =entity_row(@festival_application,:orch_name)
        =entity_row(@festival_application,:conductor)
        .row
          .col-md-3.text-end #{t("festival_application.contact_person")}:
          .col-md-9= render(:partial =>  'contact_person_oneline')
    -if @festival_application.permission
      .card.mb-2
        .card-header
          %h4
            =t("festival_application.tickets", count:1)
            - if @festival_application.ticket_warning?
              %span.badge.bg-warning=t("festival_application.ticket_deviation")
        .card-body
          =entity_row(@festival_application,:tickets)
          =entity_row(@festival_application,:tickets_red)
      .card.mb-2
        .card-header
          %h4
            =t("festival_application.festival_concert_id")
            - if @festival_application.festival_concert then
              = @festival_application.festival_concert.label
            - else
              keine Zuweisung
        .card-body
          =entity_row(@festival_application,:stage_time)
          =entity_row(@festival_application,:rehearsal_time)
          =entity_row(@festival_application,:num_players)
          =entity_row(@festival_application,:stage_plan, :active_storage)
          =entity_row(@festival_application,:equipment)
          =entity_row(@festival_application,:special_cast)
          =entity_row(@festival_application,:soloist_tickets)
          .row
            .col-md-3.text-end=t("festival_application.public_comment")
            .col-md-9=@festival_application.comment

    .card.mb-2
      .card-header
        %h4=t("festival_application.invoice", count:2)
      .card-body
        =entity_row(@festival_application,:amount)
        =custom_entity_row(t("festival_application.payment_status"), t("festival_application.payment_states.#{@festival_application.payment_status}"))
        - if @festival_application.has_ticket_invoice?
          =link_to "Ticket PDF", ticket_invoice_festival_application_path(@festival_application),:class=>"btn btn-primary btn-sm", data: { turbo:false }
        - else
          = link_to 'Ticket Preview', ticket_invoice_preview_festival_application_path(@festival_application),  data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'
        - if @festival_application.needs_fee_invoice?
          - if @festival_application.has_fee_invoice?
            =link_to "Fee PDF", fee_invoice_festival_application_path(@festival_application),:class=>"btn btn-primary btn-sm", data: { turbo:false }
          - else
            = link_to 'Fee Preview', fee_invoice_preview_festival_application_path(@festival_application),  data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'
    - if not @festival_application.event_meal.nil?
      -@event_meal = @festival_application.event_meal
      .card
        .card-header
          %h4=t("festival_application.invoice", count:2)
        .card-body
          =entity_row(@event_meal,:tln)
          =entity_row(@event_meal,:veg)
          =entity_row(@event_meal,:arrival_time,:date)

- content_for :sidebar, render(:partial => 'sidebar_show')
- content_for :entity_menu, render(:partial => 'entity_menu')

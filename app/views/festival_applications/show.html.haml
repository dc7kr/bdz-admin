.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      #{t("festival_application.s")} Nr. #{@festival_application.id}
      - if @festival_application.permission
        (#{t('festival_application.permission_granted')})
    .inner
      %table
        %tr
          %td.label #{t("festival_application.group_type")}:
          %td= display_group_type(@festival_application.group_type)
        %tr
          %td.label #{t("festival_application.visitor_type")}:
          %td= display_visitor_type(@festival_application.visitor_type)
        %tr
          %td.label #{t("festival_application.country_id")}:
          %td= @festival_application.country_code 
        -if @festival_application.permission
          %tr
            %td.label=t("festival_application.festival_concert_id")
            %td
              -if @festival_application.festival_concert then
                = @festival_application.festival_concert.label
              -else
                keine Zuweisung
        %tr
          %td.label #{t("festival_application.orch_name")}:
          %td= @festival_application.orch_name
        %tr
          %td.label #{t("festival_application.conductor")}:
          %td= @festival_application.conductor
        %tr
          %td.label #{t("festival_application.num_players")}:
          %td= @festival_application.num_players
        %tr
          %td.label #{t("festival_application.equipment")}:
          %td= @festival_application.equipment
        %tr
          %td.label #{t("festival_application.special_cast")}:
          %td= @festival_application.special_cast
        %tr
          %td.label #{t("festival_application.contact_person")}:
          %td= render(:partial =>  'contact_person.oneline') 
        %tr
          %td.label #{t("festival_application.payment_status")}
          %td= t("festival_application.payment_states.#{@festival_application.payment_status}")
        %tr
          %td.label #{t("festival_application.amount")}
          %td= @festival_application.amount
        %tr
          %td.label #{t("festival_application.invoice")}
          %td
            %table
              %tr
                %th Anzahl
                %th Bezeichung
                %th Einzelpreis
                %th Gesamt
              -invoice = @festival_application.invoice
              -invoice.items.each do |i|
                %tr
                  %td=i.count
                  %td=i.label
                  %td.currency=format_currency(i.price,'€')
                  %td.currency=format_currency(i.count*i.price,'€')
              %tr
                %td
                %td #{t("common.sum")}
                %td 
                %td.sum= format_currency(invoice.sum,'€')
          
          

- content_for :sidebar, render(:partial => 'sidebar.show')

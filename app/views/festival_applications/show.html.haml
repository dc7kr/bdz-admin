.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      #{t("festival_application.s")} Nr. #{@festival_application.id}
      - if @festival_application.permission
        (#{t('festival_application.permission_granted')})
    .inner
      %table
        %tr
          %td.label #{t("festival_application.country_id")}:
          %td= @festival_application.country ? @festival_application.country.name : t('common.none')
        -if @festival_application.permission
          %tr
            %td.label=t("festival_application.festival_concert_id")
            %td= @festival_application.festival_concert.label
        %tr
          %td.label #{t("festival_application.orch_name")}:
          %td= @festival_application.orch_name
        %tr
          %td.label #{t("festival_application.conductor")}:
          %td= @festival_application.conductor
        %tr
          %td.label #{t("festival_application.num_players")}:
          %td= @festival_application.num_players
        %tr
          %td.label #{t("festival_application.equipment")}:
          %td= @festival_application.equipment
        %tr
          %td.label #{t("festival_application.special_cast")}:
          %td= @festival_application.special_cast
        %tr
          %td.label #{t("festival_application.contact_person")}:
          %td= render @festival_application.contact_person


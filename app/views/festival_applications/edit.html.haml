.block
  .secondary-navigation
    = render :partial =>'nav'
  .content
    %h2.title
      = t("common.edit")
      = t("festival_application.singular")
    .inner
      = form_for [@festival_application], :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')



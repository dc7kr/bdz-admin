.card
  .card-header=t("festival_application.group_list") 
  .card-body
    %ul.nav.nav-pills.nav-stacked
      %li
        %p
          = form_tag grp_list_festival_applications_path, method: :post, data: {turbo:false} do
            = select_tag :file_format, options_for_select([["HTML", "html"], ["PDF", "pdf"],["ODS","ods"]], "pdf")
            = select_tag :visitor_type, get_visitor_type_options("")
            = submit_tag "Liste", :name => :list, data: { disable_with: false }

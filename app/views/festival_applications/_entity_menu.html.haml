%li.nav-item.dropdown
  %button.btn.btn-outline-secondary.dropdown-toggle{href: "#", role: "button" ,data:  { bs:  { toggle: "dropdown" }}, :aria => { expanded:  "false"}}
    =t(controller_name.singularize, count:3)
  .dropdown-menu
    - if @festival_application and policy(:contact_event).show?
      = link_to "Contact Events", contact_person_contact_events_path(@festival_application.contact_person), class: "dropdown-item"
      .dropdown-divider
    %h4.px-4= t("common.list")
    = link_to "Bewerbungsliste (PDF)", "/festival_applications/list.pdf", class: "dropdown-item"
    = link_to "Bewerbungsliste (ODS)", "/festival_applications/list.ods", class: "dropdown-item"
    .dropdown-divider
    = link_to "Zulassungsliste (PDF)", "/festival_applications/permitted.pdf", class: "dropdown-item"
    = link_to "Zulassungsliste (ODS)", "/festival_applications/permitted.ods", class: "dropdown-item"
    .dropdown-divider
    = link_to "Teilnehmerliste (ODS)", "/festival_applications/participant_overview.ods", class: "dropdown-item"
    = link_to "Sitzpläne", stage_plans_festival_applications_path, class: "dropdown-item"
    .dropdown-divider
    = form_tag grp_list_festival_applications_path, method: :post, data: {turbo:false}, class: "px-4 py-3" do
      .form-group.py-2
        %label{ for: "visitor_type"}=t("festival_application.visitor_type")
        = select_tag :visitor_type, get_visitor_type_options(""), class: "form-control"
      .form-group.py-2
        %label{ for: "file_format"}=t("common.file_format")
        = select_tag :file_format, options_for_select([["HTML", "html"], ["PDF", "pdf"],["ODS","ods"]], "pdf"), class: "form-control"
      = submit_tag "Liste", :name => :list, data: { disable_with: false }, class: "form-control btn btn-primary"

.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("festival_application", count: 3)
    .inner

      %table.table-sm.table-hover.table-condensed
        %tr
          %th &nbsp;
          %th Regulär
          %th Ermäßigt
        %tr
          %td Festivalkarten
          %td=@sums[:tickets]
          %td=@sums[:tickets_red]
        %tr
          %td BDZ-Festivalkarten
          %td=@sums[:bdz_tickets]
          %td=@sums[:bdz_tickets_red]
        %tr 
          %td Gesamtanzahl Spieler:
          %td=@sums[:players]
        %tr 
          %td Spieler ohne Karte
          %td=@sums[:no_ticket]
      %table.table-sm#festival_applications
        %thead
          %tr
            %th=t("common.number")
            %th=sortable :orch_name, t("festival_application.orch_name")
            %th=t("festival_application.num_players")
            %th=t("festival_application.payment_status")
            %th

        %tbody.page 
          =render @festival_applications
      #paginator{:"data-table"=>"festival_applications"}
        = paginate @festival_applications
- content_for :sidebar, render(:partial => 'sidebar')

.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("festival_application", count: 3)


  %table.table-sm.table-hover.table-condensed
    %thead
      %tr
        %th &nbsp;
        %th Regulär
        %th Ermäßigt
      %tr
        %td Festivalkarten
        %td=@sums[:tickets]
        %td=@sums[:tickets_red]
      %tr
        %td BDZ-Festivalkarten
        %td=@sums[:bdz_tickets]
        %td=@sums[:bdz_tickets_red]
      %tr 
        %td Gesamtanzahl Spieler:
        %td=@sums[:players]
      %tr 
        %td Spieler ohne Karte
        %td=@sums[:no_ticket]

  #entry_info.text-center= page_entries_info @festival_applications
  #paginator= paginate @festival_applications, params: { format: :turbo_stream }
  %table.table-sm#festival_applications
    %thead
      %tr
        %th=t("common.number")
        %th=sortable :orch_name, t("festival_application.orch_name")
        %th=t("festival_application.num_players")
        %th=t("festival_application.payment_status")
        %th

    %tbody#festival_applications=render @festival_applications
- content_for :sidebar, render(:partial => 'sidebar')
- content_for :entity_menu, render(:partial => 'entity_menu')

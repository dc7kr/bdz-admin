.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("festival_application.plural")
    .inner

      %table
        %tr 
          %td Gesamtanzahl Spieler:
          %td=@sum_players
      %table.table#festival_applications
        %thead
          %th=t("common.number")
          %th=t("festival_application.group_type")
          %th=t("festival_application.orch_name")
          %th=t("festival_application.num_players")
          %th=t("festival_application.payment_status")
          %th

        %tbody.page 
          =render @festival_applications
      #paginator{:"data-table"=>"festival_applications"}
        = paginate @festival_applications, :remote=>true
- content_for :sidebar, render(:partial => 'sidebar')

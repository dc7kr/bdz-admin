.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("festival_application.plural")
    .inner
      %table
        %tr
          %th=t("festival_application.orch_name")
          %th=t("festival_application.conductor")
          %th=t("festival_application.num players")
          %th=t("festival_application.contact_person")
          %th

        = render @festival_applications
- content_for :sidebar, render(:partial => 'sidebar')

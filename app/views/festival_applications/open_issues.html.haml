.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title=t("festival_applications.open_issues.title")

  %table.table.table-sm#festival_applications
    %thead
      %tr
        %th=t("common.number")
        %th=sortable :orch_name, t("festival_application.orch_name")
        %th=t("common.sum")
        %th

    %tbody.page 
      - @festival_applications.each do |app|
        - i = app.get_ticket_invoice
        -if i.sum != 0 and app.payment_status != 'S' then
          %tr
            %td=app.id
            %td=app.orch_name
            %td.text-end=format_currency i.to_hash[:invoice][:sum][:grand_total]
- content_for :sidebar, render(:partial => 'sidebar')

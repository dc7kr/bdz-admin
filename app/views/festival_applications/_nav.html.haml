%ul.wat-cf
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_member_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list")}", festival_applications_path
  -if (@festival_application)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), festival_application_path(@festival_application)
    %li{:class => tabActiveClass(@current_action,'edit',nil)}= link_to t("common.edit"), edit_festival_application_path(@festival_application)
    %li{:class => tabActiveClass(@current_action,'edit',nil)}= link_to t("festival_piece.p"), festival_application_festival_pieces_path(@festival_application)
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_festival_application_path(@festival_application)


%ul.wat-cf
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_festival_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list")}", festival_applications_path
  %li{ :class => tabActiveClass(@current_action,'permitted',nil)}= link_to "#{t("festival_application.permission_granted").capitalize}", permitted_festival_applications_path
  %li{ :class => tabActiveClass(@current_action,'open_issues',nil)}= link_to t("festival_application.open_issues"), open_issues_festival_applications_path
  -if (@festival_application and not @festival_application.id.nil?)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), festival_application_path(@festival_application)
    %li{:class => tabActiveClass(@current_action,'edit',nil)}= link_to t("common.edit"), edit_festival_application_path(@festival_application)
    %li{:class => tabActiveClass(@current_action,'festival_pieces',nil)}= link_to t("festival_piece.p"), festival_application_festival_pieces_path(@festival_application)
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_festival_application_path


= semantic_form_for @festival_application do |f|
  = f.inputs do
    = f.input :nationality
    = f.input :orchestra
    = f.input :orch_name
    = f.input :conductor
    = f.input :num_players
    = f.input :equipment
    = f.input :special_cast
    = f.input :contact_person
  
  = f.actions do
    = f.action :submit, :as => :button

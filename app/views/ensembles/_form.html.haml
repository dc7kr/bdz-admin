= bootstrap_form_for(@ensemble, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  .container-fluid
    =f.text_field :name
    =f.number_field :mglnr
    =f.url_field :homepage
    =f.text_area :beschreibung, cols:80, rows: 5
    =f.email_field :email
    =f.check_box :visible
    .actions
      = submit_button
      = cancel_button

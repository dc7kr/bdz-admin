= form_for @ensemble, :html => { :class => "form-horizontal"} do |f|
  -if @ensemble.errors.any?
    #error_explanation
      %h2= "#{pluralize(@ensemble.errors.count, "error")} prohibited this ensemble from being saved:"
      %ul
        - @ensemble.errors.full_messages.each do |msg|
          %li= msg
  .container-fluid
    =form_my_field(f,@ensemble, :name)
    =form_my_field(f,@ensemble, :mglnr)
    =form_my_field(f,@ensemble, :homepage)
    =form_my_field(f,@ensemble, :beschreibung)
    =form_my_field(f,@ensemble, :email)
    =form_my_field(f,@ensemble, :visible,:checkbox)
    .actions
      = submit_button
      = cancel_button

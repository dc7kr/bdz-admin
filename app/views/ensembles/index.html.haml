.block
  .secondary-navigation
    %ul.wat-cf
      =render :partial => 'nav'
  .content
    %h2.title
      = t("common.all", :default => "All")
      = t("ensemble.title")
    .inner
      %table.table
        %tr
          %th.first 
            = sortable "id", t("ensemble.id", :default => "Nr")
          %th= sortable "name", t("ensemble.orchName", :default => "Name")
          %th.last &nbsp;
        = render @ensembles
      = paginate @ensembles
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

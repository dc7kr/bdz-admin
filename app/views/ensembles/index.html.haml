.block
  .secondary-navigation
    %ul.wat-cf
      =render :partial => 'nav'
  .content
    %h2.title
      = t("common.all", :default => "All")
      = t("ensemble.title")
    .inner
      %table.table.table-hover.table-condensed
        %tr
          %th.first 
            = sortable "id", attr_heading(Ensemble,:id)
          %th= sortable "name", attr_heading(Ensemble,:orchName)
          %th.last &nbsp;
        = render @ensembles
      = paginate @ensembles
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

.block
  .secondary-navigation
    %ul.wat-cf
      =render :partial => 'nav'
  .content
    %h2.title
      = @ensemble.name
    .inner
      %table
        %tr
          %td.label=t('ensemble.homepage')
          %td= link_to @ensemble.homepage, @ensemble.homepage
        %tr
          %td.label=t('ensemble.beschreibung')
          %td= @ensemble.beschreibung
        %tr
          %td.label=t('ensemble.email')
          %td= mail_to @ensemble.email,@ensemble.email
        %tr
          %td.label=t('ensemble.owner')
          %td= @ensemble.owner
        %tr
          %td.label=t('ensemble.visible')
          %td= @ensemble.visible
      

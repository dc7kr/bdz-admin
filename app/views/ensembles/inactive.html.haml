.block
  .secondary-navigation
    %ul.wat-cf
      %li.first.active= link_to "#{t("web-app-theme.list", :default => "List")}", ensembles_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_ensemble_path
  .content
    %h2.title
      = t("web-app-theme.inactive", :default => "#inactive")
      Orchester
    .inner
      %table.table-sm
        %tr
          %th.first 
            = sortable "id", t("ensemble.id", :default => "Nr")
          %th= sortable "name", t("ensemble.orchName", :default => "Name")
          %th.last &nbsp;
        - @ensembles.each do |ensemble|
          %tr{:class => cycle("odd", "even")}
            %td
              = link_to ensemble.id, ensemble_path(ensemble)
            %td
              = ensemble.name
            %td.last
              = link_to_show( ensemble_path(ensemble), "#{t("web-app-theme.show", :default => "Show")}")
              |
              \#{link_to_edit(edit_ensemble_path(ensemble),  "#{t("web-app-theme.edit", :default => "Edit")}" )} |
              \#{link_to_delete(ensemble_path(ensemble), "#{t("web-app-theme.delete", :default => "Delete")}", "#{t("web-app-theme.confirm", :default => "Are you sure?")}")}
      = paginate @ensembles
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

%tr
  -if @orchestra
    %td
      - if not report_sheet.valid? then
        %span.badge.bg-danger 
          %i.fas.fa-exclamation-circle.bg-danger
      =link_to report_sheet.year.to_s, orchestra_report_sheet_path(@orchestra,report_sheet)
      - if report_sheet.generated then
        %span.badge.bg-secondary=t("report_sheet.generated")
  -else
    %td=report_sheet.orchestra.member.mglnr
  %td #{report_sheet.children} - #{report_sheet.teens} - #{report_sheet.youth} - #{report_sheet.adult} - #{report_sheet.senior}
  %td=format_bool(report_sheet.uv ) 
  %td=report_sheet.zusatz_uv
  %td=report_sheet.calcZeitungen
  %td=report_sheet.calcGemaCount 
  %td=report_sheet.azubi 
  -if @orchestra
    %td
      = link_to_show_path( orchestra_report_sheet_path(@orchestra,report_sheet),'Show',report_sheet)
      = link_to_edit_path( edit_orchestra_report_sheet_path(@orchestra,report_sheet),'Edit',report_sheet)
  - else
    -if report_sheet.orchestra.orch_type=='L' and report_sheet.calcGemaCount-report_sheet.azubi <=0
      %td ALERT

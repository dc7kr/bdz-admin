= form_for ([@report_sheet]) do |f|
  -if @report_sheet.errors.any?
    #error_explanation
      %h2= "#{pluralize(@report_sheet.errors.count, "error")} prohibited this report_sheet from being saved:"
      %ul
        - @report_sheet.errors.full_messages.each do |msg|
          %li= msg
  = f.hidden_field :orchestra_id, :value=>@orchestra.id
  %table
    %tr
      %td= t("report_sheet.year")
      %td= f.text_field :year
    %tr
      %td= t("report_sheet.children")
      %td= f.number_field :children
    %tr
      %td= t("report_sheet.teens")
      %td= f.number_field :teens
    %tr
      %td= t("report_sheet.youth")
      %td= f.number_field :youth
    %tr
      %td= t("report_sheet.adult")
      %td= f.number_field :adult
    %tr
      %td= t("report_sheet.uv")
      %td= f.check_box :uv
    %tr
      %td= t("report_sheet.zeitungen")
      %td= f.number_field :zeitungen
    %tr
      %td= t("report_sheet.gema")
      %td= f.number_field :gema
    %tr
      %td= t("report_sheet.azubi")
      %td= f.number_field :azubi
    %tr
      %td= t("report_sheet.passive")
      %td= f.number_field :passive
  .actions
    = f.submit t("common.save")

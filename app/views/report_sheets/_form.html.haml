=bootstrap_form_for [@orchestra,@report_sheet], layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10" do |f| 
  .container-fluid
    = f.text_field :report_date_str
    = f.number_field :year 
    .form-group
      = f.label :uv,:class=>"control-label col-sm-2"
      = f.check_box :uv, label_class: "col-sm-10", label: ""
    = f.number_field :zusatz_uv

  .card
    .card-header
      .card-title Mitgliederzahlen
    .card-body
      = f.number_field :children,:control_col=>"col-sm-2"
      = f.number_field :teens,:control_col=>"col-sm-2"
      = f.number_field :youth,:control_col=>"col-sm-2"
      = f.number_field :adult,:control_col=>"col-sm-2"
      = f.number_field :senior,:control_col=>"col-sm-2"
      = f.number_field :azubi,:control_col=>"col-sm-2"
      = f.number_field :passive,:control_col=>"col-sm-2"
      = f.number_field :ms_total,:control_col=>"col-sm-2"
      = f.number_field :korr_ztg,:control_col=>"col-sm-2"
  .card
    .card-header
      .card-title Ensembles
    .card-body
      = f.number_field :child_ens,:control_col=>"col-sm-2"
      = f.number_field :youth_ens,:control_col=>"col-sm-2"
      = f.number_field :adult_ens,:control_col=>"col-sm-2"
      = f.number_field :senior_ens,:control_col=>"col-sm-2"
      = f.number_field :chamber_ens,:control_col=>"col-sm-2"
      = f.number_field :other_ens,:control_col=>"col-sm-2"
  =f.text_area :comment,cols: 80, rows:5

  .actions
    = submit_button
    = cancel_button

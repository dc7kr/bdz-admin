.block
  .secondary-navigation
    = render :partial=>"nav"
  .content
    .inner
      %h2
        = @report_sheet.orchestra.orchName
        %br
        = t("report_sheet",:count=>1)
        = @report_sheet.year
        - if @needs_update
          %span.label.label-danger=t("report_sheet.needs_new_invoice")
        - if @inconsistent
          %span.label.label-danger=t("report_sheet.inconsistent")

      =entity_row(@report_sheet,:report_date,:date)
      =entity_row(@report_sheet,:generated)
      =calculation_row(@report_sheet,:children, Prices.childrenRate)
      =calculation_row(@report_sheet,:teens, Prices.teensRate)
      =calculation_row(@report_sheet,:youth, Prices.youthRate)
      =calculation_row(@report_sheet,:adult, Prices.adultRate)
      =calculation_row(@report_sheet,:senior, Prices.seniorRate)
      %hr.calc
      =calculation_sum(label(:report_sheet,:calcBeitrag), @report_sheet.calcBeitrag)
      =calculation_row(@report_sheet,:calcUvCount, Prices.uvRate)
      - if @report_sheet.delayed? then
        =calculation_sum(label(:report_sheet,:delay_fee), Prices.delayFee)
      %hr.calc
      =calculation_sum(label(:report_sheet,:calcInvoice), @report_sheet.calcInvoice)
      %hr.calc_final
      - if @needs_update
        =calculation_sum(label(:report_sheet,:delta_invoice), @booking.amount+@invoice.sum)


      .panel.panel-default
        =entity_row(@report_sheet,:calcZeitungen)
        =entity_row(@report_sheet,:calcGemaCount)
        =entity_row(@report_sheet,:azubi)
        =entity_row(@report_sheet,:totalActiveMembers)
        =entity_row(@report_sheet,:passive)
        .row 
          .col-md-3=label(:report_sheet,:total)
          .col-md-9= @report_sheet.passive+@report_sheet.totalActiveMembers

      - if @inconsistent
        =link_to( t("report_sheet.update_from_members"), update_from_members_orchestra_report_sheet_path(@orchestra,@report_sheet), :class=>"btn btn-primary")
      - if @needs_update and not @inconsistent
        =link_to(t("report_sheet.update_invoice"), update_invoice_orchestra_report_sheet_path(@orchestra,@report_sheet), :class=>"btn btn-primary", :method=> :post)
- content_for :sidebar, render(:partial => 'sidebar')

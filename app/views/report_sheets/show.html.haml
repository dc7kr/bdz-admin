.block
  .secondary-navigation
    = render :partial=>"nav"
  .content
    .inner
      %h2
        = @report_sheet.orchestra.orchName
        %br
        = t("report_sheet",:count=>3)
        = @report_sheet.year
      =entity_row(@report_sheet,:report_date,:date)
      =entity_row(@report_sheet,:generated)
      =calculation_row(@report_sheet,:children, Prices.childrenRate)
      =calculation_row(@report_sheet,:teens, Prices.teensRate)
      =calculation_row(@report_sheet,:youth, Prices.youthRate)
      =calculation_row(@report_sheet,:adult, Prices.adultRate)
      =calculation_row(@report_sheet,:senior, Prices.seniorRate)
      =calculation_row(@report_sheet,:calcUvCount, Prices.uvRate)
      =calculation_sum(label(:report_sheet,:invsum),@report_sheet.calcInvoice)

      - if @report_sheet.delayed? then
        .row
          .col-md-3=label(:report_sheet,:delay_fee)
          .col-md-1
          .col-md-3
          .col-md-2.text-right=format_currency(Prices.delayFee)

      =entity_row(@report_sheet,:calcZeitungen)
      =entity_row(@report_sheet,:calcGemaCount)
      =entity_row(@report_sheet,:azubi)
      %table
        %tr
          %td{:colspan=>4}
            %hr
        %tr
          %td.label=t("report_sheet.total_active")
          %td= @report_sheet.totalActiveMembers
        %tr
          %td.label=t("report_sheet.passive")
          %td= @report_sheet.passive
        %tr
          %td.label=t("report_sheet.total")
          %td= @report_sheet.passive+@report_sheet.totalActiveMembers
        %tr
          %td{:colspan=>4}
            %hr
        %tr
          %td{:class =>'label',:colspan=>4}=t("report_sheet.sum")
          %td.sum= format_currency(@report_sheet.calcBeitrag,'€')
        %tr
          %td{:class =>'label',:colspan=>4}=t("report_sheet.uvsum")
          %td.sum= format_currency(@report_sheet.calcUV,'€')
        %tr
          %td{:class =>'label',:colspan=>4}=t("report_sheet.invsum")
          %td.sum= format_currency(@report_sheet.calcInvoice,'€')

  
- content_for :sidebar, render(:partial => 'sidebar')

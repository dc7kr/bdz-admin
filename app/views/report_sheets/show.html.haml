.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", orchestras_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_orchestra_path
      %li.active= link_to "#{t("web-app-theme.show", :default => "Show")}", orchestra_path
  .content
    .inner
      %h2
        = @report_sheet.orchestra.orchName
        %br
        Meldebogen
        = @report_sheet.year

      %table
        %tr
          %td.label
            = t("report_sheet.children")
            \:
          %td= @report_sheet.children
          %td à
          %td.currency
            =format_currency(Prices.childrenRate,'€')
          %td.currency
            = format_currency(@report_sheet.children * Prices.childrenRate,'€')
        %tr
          %td.label
            = t("report_sheet.teens")
            \:
          %td= @report_sheet.teens
          %td à
          %td.currency
            =format_currency(Prices.teensRate,'€')
          %td.currency
            = format_currency(@report_sheet.teens * Prices.teensRate,'€')
        %tr
          %td.label
            = t("report_sheet.youth")
            \:
          %td= @report_sheet.youth
          %td à
          %td.currency 
            = format_currency(Prices.youthRate,'€')
          %td.currency
            = format_currency(@report_sheet.youth * Prices.youthRate,'€')
        %tr
          %td.label=t("report_sheet.adult")
          %td= @report_sheet.adult
          %td à
          %td.currency
            = format_currency(Prices.adultRate,'€')
          %td.currency
            = format_currency(@report_sheet.adult * Prices.adultRate,'€')
        %tr
          %td.label=t("report_sheet.senior")
          %td= @report_sheet.senior
          %td à
          %td.currency
            = format_currency(Prices.seniorRate,'€')
          %td.currency
            = format_currency(@report_sheet.senior * Prices.seniorRate,'€')
        %tr
        %tr
          %td.label=t("report_sheet.uv")
          %td!= @report_sheet.calcUvCount
          %td à
          %td.currency
            =format_currency(Prices.uvRate ,'€')
          %td.currency
            =format_currency(@report_sheet.calcUV,'€')
        %tr
          %td.label=t("report_sheet.zeitungen")
          %td #{@report_sheet.calcZeitungen} (#{@report_sheet.zeitungen})
        %tr
          %td.label=t("report_sheet.gema")
          %td
            = @report_sheet.calcGemaCount
            (
            = @report_sheet.gema
            )
        %tr
          %td.label=t("report_sheet.azubi")
          %td= @report_sheet.azubi
        %tr
          %td.label=t("report_sheet.passive")
          %td= @report_sheet.passive
        %tr
          %td{:class =>'label',:colspan=>4}=t("report_sheet.sum")
          %td.sum= format_currency(@report_sheet.calcBeitrag,'€')
        %tr
          %td{:class =>'label',:colspan=>4}=t("report_sheet.uvsum")
          %td.sum= format_currency(@report_sheet.calcUV,'€')
        %tr
          %td{:class =>'label',:colspan=>4}=t("report_sheet.invsum")
          %td.sum= format_currency(@report_sheet.calcInvoice,'€')
  
    .wat-cf
      = edit_button(edit_orchestra_report_sheet_path(@orchestra,@report_sheet))
      = del_button( orchestra_report_sheet_path(@report_sheet))
- content_for :sidebar, render(:partial => 'sidebar')

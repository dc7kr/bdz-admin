- invoice.items.each do |i|
  .row
    .col-md-3.text-end
      %label=i.label
    .col-md-1.text-end #{i.count}x
    .col-md-2.text-end=format_currency(i.basis)
    .col-md-2.text-end=format_currency(i.total)
%hr.calc
.row
  .col-md-3.text-end.fw-bold
    %label=t("common.sum")
  .col-md-4.text-end
  .col-md-1.text-end.fw-bold=format_currency(invoice.sum)
%hr.calc_final


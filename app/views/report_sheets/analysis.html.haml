.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title #{t('report_sheet.analysis')} #{Time.now.year} (gesamt: #{@warning_sheets.size})

  %div.infobox
    %span.title
      Hinweis
    %br
    Meldebögen gelten als auffällig, wenn die Zahl der Gema-pflichtigen Mitglieder um mehr als #{BDZ_SETTINGS['report_sheet']['threshold']*100} Prozent vom Vorjahreswert abweicht.
  %br
  %table.table.table-sm
    %tr
      %th=t('orchestra.orchName')
      %th=@last_year.to_s
      %th=@current_year.to_s
    - @warning_sheets.each do |w|
      %tr
        %td
          -if w["cur"].orchestra.nil? 
            UNGÜLTIG, KEIN ORCHESTER
          -else
            =link_to orchestra_report_sheet_path(w["cur"].orchestra,w["cur"])  do 
              = w["cur"].orchestra.orchName
              (
              = w["cur"].orchestra.member.mglnr
              )
            -if w["cur"].orchestra.orch_type == "K"
              %span.badge.bg-primary Kooperativ
            -elsif w["cur"].orchestra.orch_type == "L"
              %span.badge.bg-primary Landesorchester
        %td=w["last"].calcGemaCount
        %td=w["cur"].calcGemaCount

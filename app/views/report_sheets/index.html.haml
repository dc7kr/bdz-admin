%h1 Meldebögen #{@orchestra.orchName } #{@orchestra.mglnr} 
=link_back orchestra_path(@orchestra),t("common.back")
%table
  %tr
    %th=t("report_sheet.year")
    %th=t("report_sheet.children")
    %th=t("report_sheet.teens")
    %th=t("report_sheet.youth")
    %th=t("report_sheet.adult")
    %th=t("report_sheet.uv")
    %th=t("report_sheet.zeitungen")
    %th=t("report_sheet.gema")
    %th=t("report_sheet.azubi")
    %th=t("report_sheet.passive")

  - @report_sheets.each do |report_sheet|
    %tr
      %td= report_sheet.year
      %td= report_sheet.children
      %td= report_sheet.teens
      %td= report_sheet.youth
      %td= report_sheet.adult
      %td= report_sheet.uv
      %td= report_sheet.zeitungen
      %td= report_sheet.gema
      %td= report_sheet.azubi
      %td= report_sheet.passive
      %td
        = link_to_show( orchestra_report_sheet_path(@orchestra,report_sheet),'Show')
        = link_to_edit( edit_orchestra_report_sheet_path(@orchestra,report_sheet),'Edit')
        = link_to_delete( orchestra_report_sheets_path(report_sheet), 'Del','Wirklich löschen?')


%br

= link_to_new(new_orchestra_report_sheet_path(@orchestra),t("report_sheet.new"))

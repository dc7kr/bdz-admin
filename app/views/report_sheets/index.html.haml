.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      -if @orchestra 
        Meldebögen #{@orchestra.orchName } #{@orchestra.mglnr} 
      -else
        Meldebögen #{@curYear}
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %tr
            -if @orchestra
              %th=t("report_sheet.year")
            -else 
              %th=t("member.mglnr")
            %th=t("report_sheet.distribution")
            %th=t("report_sheet.uv")
            %th=t("report_sheet.zusatz_uv")
            %th=t("report_sheet.zeitungen")
            %th=t("report_sheet.gema")
            %th=t("report_sheet.azubi")
            %th=t("report_sheet.passive")
            %th.last &nbsp;
        %tbody#orchestras
          =render @report_sheets
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')



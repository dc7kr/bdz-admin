.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      -if @orchestra 
        Meldebögen #{@orchestra.orchName } #{@orchestra.mglnr} 
      -else
        Meldebögen #{@curYear}
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %tr
            -if @orchestra
              %th=attr_heading(Report_sheet,:year)
            -else 
              %th=t("member.mglnr")
            %th=attr_heading(Report_sheet,:distribution)
            %th=attr_heading(Report_sheet,:uv)
            %th=attr_heading(Report_sheet,:zusatz_uv)
            %th=attr_heading(Report_sheet,:zeitungen)
            %th=attr_heading(Report_sheet,:gema)
            %th=attr_heading(Report_sheet,:azubi)
            %th=attr_heading(Report_sheet,:passive)
            %th.last &nbsp;
        %tbody#orchestras
          =render @report_sheets
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')



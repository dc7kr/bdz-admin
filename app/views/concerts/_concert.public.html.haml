%dt
  %a{:name => "#{'O'+String(concert.id)}"}
  = concert.datum
  ,
  = concert.zeit
  ,
  = concert.stadt
  ,
  = concert.ort
  ,
%dd.title=concert.titel
%dd
  %a{:href=>"#{concert.url}",:target=>"_blank", :onclick=>"meldung()"}
    =concert.interpret
  %i
    =concert.bemerkung
  = link_to_show concert, t('common.show')
  = link_to_edit concert, t('common.edit')
  = link_to_delete concert, t('common.delete'),t('common.delete_confirm')

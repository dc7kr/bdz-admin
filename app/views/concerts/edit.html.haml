.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", concerts_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_concert_path
      %li.active= link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_concert_path
  .content
    %h2.title
      = t("web-app-theme.edit", :default => "Edit")
      Konzert
    .inner
      = form_for @concert, :url => concert_path(@concert), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

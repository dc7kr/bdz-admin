= bootstrap_form_for(@concert, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  = f.datetime_field :concert_date
  = f.text_field :stadt
  = f.text_field :titel
  = f.text_field :ort
  = f.collection_select( :festival_id, Festival.all,:id,:name,{})
  = f.text_field :interpret
  = f.text_field :mglnr
  = f.url_field :url
  = f.text_area :comment, cols:80, rows:5
  = f.collection_select(:bland, State.all, :id, :name,{})
  = form_wrapped_field(f,@concert, :country_id, country_select(:concert, :country_code, {iso_codes:true},{ class:"form-control"}))
  = f.email_field :email
  = f.text_field :eintritt
  = f.text_field :uid
  - if (isAdmin?)
    = f.text_field :owner
  = f.datetime_field :reported
  = f.datetime_field :confirmed
  = f.text_field :token

  = f.check_box :visible
  .actions
    = f.submit t("common.save")
    = cancel_button()

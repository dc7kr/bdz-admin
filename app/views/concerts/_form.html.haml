= form_for @concert do |f|
  -if @concert.errors.any?
    #error_explanation
      %h2= "#{pluralize(@concert.errors.count, "error")} prohibited this concert from being saved:"
      %ul
        - @concert.errors.full_messages.each do |msg|
          %li= msg
  %table
    %tr
      %td= f.label :datum
      %td= f.date_select :datum, :class => 'date_select'
    %tr
      %td= f.label :zeit
      %td= f.text_field :zeit
    %tr
      %td= f.label :reported
      %td= f.text_field :reported
    %tr
      %td= f.label :confirmed
      %td= f.text_field :confirmed
    %tr
      %td= f.label :token
      %td= f.text_field :token
    %tr
      %td= f.label :stadt
      %td= f.text_field :stadt
    %tr
      %td= f.label :titel
      %td= f.text_field :titel
    %tr
      %td= f.label :ort
      %td= f.text_field :ort
    %tr
      %td= f.label :festival_id
      %td= collection_select( :concert, :festival_id, Festival.all,:id,:name)
    %tr
      %td= f.label :interpret
      %td= f.text_field :interpret
    %tr
      %td= f.label :url
      %td= f.text_field :url
    %tr
      %td= f.label :bemerkung
      %td= f.text_field :bemerkung
    %tr
      %td= f.label :bland
      %td= collection_select(:concert, :bland, State.all, :id, :name)
    %tr
      %td= f.label :country_id
      %td= collection_select(:concert, :country_id, Country.all, :id, :name)
    %tr
      %td= f.label :email
      %td= f.text_field :email
    %tr
      %td= f.label :eintritt
      %td= f.text_field :eintritt
    - if (isAdmin?)
      %tr
        %td= f.label :owner
        %td= f.text_field :owner
    %tr
      %td= f.label :visible
      %td= f.check_box :visible, :class => 'check_box'

  .actions
    = f.submit t("common.save")
    = cancel_button()

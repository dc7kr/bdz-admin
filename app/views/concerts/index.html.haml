.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      Konzerte
    .inner
      %table.table-sm.table-hover.table-condensed
        %tr
          %th.first=sortable("concert_date", attr_heading(Concert, :concert_date))
          %th=attr_heading(Concert, :zeit)
          %th=attr_heading(Concert, :interpret)
          %th=sortable("ort", attr_heading(Concert, :ort))
          %th=attr_heading(Concert, :url)
          %th.last &nbsp;
        %tbody#concerts
          =render @concerts
      #paginator
        = paginate @concerts, :remote=>true
      .actions-bar.wat-cf
        .actions

.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      Konzerte
    .inner
      %table.table
        %tr
          %th.first 
            = sortable "datum", t("concert.datum")
          %th
            = t("concert.zeit")
          %th
            = sortable "stadt", t("concert.stadt")
          %th
            = sortable "ort", t("concert.ort")
          %th
            = t("concert.interpret")
          %th
            = t("concert.url")
          %th.last &nbsp;
        %tbody#concerts
          =render @concerts
      #paginator
        = paginate @concerts, :remote=>true
      .actions-bar.wat-cf
        .actions

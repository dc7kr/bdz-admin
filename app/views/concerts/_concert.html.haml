- if can? :read, concert
  %tr{:class => cycle("odd", "even")}
    %td= format_date(concert.datum)
    %td= format_time(concert.zeit)
    %td= concert.stadt
    %td= concert.titel
    %td= concert.ort
    %td= concert.interpret
    %td
      = link_to_show concert, t('common.show')
      = link_to_edit concert, t('common.edit')
      = link_to_delete concert, t('common.delete'),t('common.delete_confirm')

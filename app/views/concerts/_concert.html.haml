%tr{:class => cycle("odd", "even"), :id=>"row#{concert.id}"}
  %td= format_date_only(concert.concert_date)
  %td= format_time(concert.concert_date)
  %td= concert.interpret
  %td
    = concert.ort
    = concert.stadt
  %td= link_to concert.url,concert.url
  %td
    - if concert.visible == 0 then
      = link_to_publish concert,  t("common.publish")
    = link_to_show concert
    = link_to_edit concert
    = link_to_delete concert

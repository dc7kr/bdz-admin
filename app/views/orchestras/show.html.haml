.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", orchestras_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_orchestra_path
      %li.active= link_to "#{t("web-app-theme.show", :default => "Show")}", orchestra_path
  .content
    .inner
      %table
        %tr
          %td.label
            = t("orchestra.mglnr")
            \:
          %td= @orchestra.mglnr
        %tr
          %td.label
            = t("orchestra.orchName")
            \:
          %td= @orchestra.orchName
        %tr
          %td.label
            = t("orchestra.anrede")
            \:
          %td= @orchestra.anrede
        %tr
          %td.label
            = t("orchestra.vorname")
            \:
          %td= @orchestra.vorname
        %tr
          %td.label
            = t("orchestra.nachname")
            \:
          %td= @orchestra.nachname
        %tr
          %td.label
            = t("orchestra.strasse")
            \:
          %td= @orchestra.strasse
        %tr
          %td.label
            = t("orchestra.land")
            \:
          %td= @orchestra.land
        %tr
          %td.label
            = t("orchestra.plz")
            \:
          %td= @orchestra.plz
        %tr
          %td.label
            = t("orchestra.ort")
            \:
          %td= @orchestra.ort
        %tr
          %td.label
            = t("orchestra.telefon")
            \:
          %td= @orchestra.telefon
        %tr
          %td.label
            = t("orchestra.fax")
            \:
          %td= @orchestra.fax
        %tr
          %td.label
            = t("orchestra.gruendung")
            \:
          %td= format_date(@orchestra.gruendung)
        %tr
          %td.label
            = t("orchestra.eintritt")
            \:
          %td= format_date(@orchestra.eintritt)
        %tr
          %td.label
            = t("orchestra.za")
            \:
          %td= t("common.za_"+@orchestra.za)
        %tr
          %td.label
            = t("orchestra.konto")
            \:
          %td= @orchestra.konto
        %tr
          %td.label
            = t("orchestra.blz")
            \:
          %td= @orchestra.blz
        %tr
          %td.label
            = t("orchestra.lv")
            \:
          %td= @orchestra.regional_organization.name
        %tr
          %td.label
            = t("orchestra.orch_type")
            \:
          %td= t("orchestra.type_"+@orchestra.orch_type)
        %tr
          %td.label
            = t("orchestra.austrittZum")
            \:
          %td= format_date(@orchestra.austritt_zum)
        %tr
          %td.label
            = t("orchestra.schreibenVom")
            \:
          %td= format_date(@orchestra.schreibenVom)
        %tr
          %td.label
            = t("orchestra.bemerkung")
            \:
          %td= @orchestra.bemerkung
        %tr
          %td.label
            = t("orchestra.eMail")
            \:
          %td= @orchestra.eMail
        %tr
          %td.label
            = t("orchestra.url")
            \:
          %td= @orchestra.url
        %tr
          %td.label
            = t("orchestra.lastschriftErfasst")
            \:
          %td!= format_bool(@orchestra.lastschriftErfasst)
        %tr
          %td.label
            = t("orchestra.kuendigungErfasst")
            \:
          %td!= format_bool(@orchestra.kuendigungErfasst)
        %tr
          %td.label
            = t("orchestra.zweitanschrift")
            \:
          %td= @orchestra.zweitanschrift
        %tr
          %td.label
            = t("orchestra.name2")
            \:
          %td= @orchestra.name2
        %tr
          %td.label
            = t("orchestra.dageVER")
            \:
          %td= @orchestra.dageVER
        
    .wat-cf
      = edit_button(edit_orchestra_path(@orchestra))
      = del_button( orchestra_path(@orchestra))
    //= render 'report_sheets/fororchestra' unless @report_sheets.count ==0

- content_for :sidebar, render(:partial => 'sidebar.show')

.secondary-navigation
  = render :partial=>'nav'
.container
  %h2 #{@orchestra.member.mglnr} (#{t("orchestra.type_"+@orchestra.orch_type)})
  %h3
    =  @orchestra.orchName
    - if not @orchestra.report_sheet_required? or not @orchestra.currentReportSheet.nil? then
      = link_to 'Rechnungsvorschau', invoice_preview_orchestra_path(@orchestra),  data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'
  #orchestraAccordion.accordion
    .accordion-item
      .accordion-header 
        %button.accordion-button{"aria-controls" => "paymentDataCollapse", "aria-expanded" => "true" }
          Orchesterdaten
      .accordion-body
        = entity_row(@orchestra,:fullname)
        = entity_row(@orchestra,:gruendung,:date)
        = entity_row(@orchestra,:promusica,:date)
        = custom_entity_row(t("orchestra.url"),link_to(@orchestra.url, sanitize_url(@orchestra.url)))
        = entity_row(@orchestra,:gema_kdnr)
        = entity_row(@orchestra,:gema_kdnr_new)
        = entity_row(@orchestra,:bemerkung)

  = render @orchestra.member,:partial=>"member"

  .btn-group{:role=>"group"}
    = edit_glyph_link(edit_orchestra_path(@orchestra),@orchestra)
    = del_glyph_link( orchestra_path(@orchestra),@orchestra)

- content_for :sidebar, render(:partial => 'sidebar_show')

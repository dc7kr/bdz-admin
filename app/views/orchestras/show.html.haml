.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %table
        %tr
          %td.label
            &nbsp;
          %td #{@orchestra.mglnr} (#{t("orchestra.type_"+@orchestra.orch_type)})
        %tr
          %td.label #{t("orchestra.orchName")}:
          %td= @orchestra.orchName
        %tr
          %td.label #{t("common.address")}:
          %td #{@orchestra.fullname}
        %tr
          %td &nbsp;
          %td= @orchestra.strasse
        %tr
          %td &nbsp;
          %td #{@orchestra.plz} #{@orchestra.ort}
        %tr
          %td &nbsp;
          %td= @orchestra.country.name
        %tr
          %td.label #{t("orchestra.telefon")}:
          %td= @orchestra.telefon
        %tr
          %td.label #{t("orchestra.fax")}:
          %td= @orchestra.fax
        %tr
          %td.label #{t("orchestra.email")}:
          %td=mail_to @orchestra.email,@orchestra.email
        %tr
          %td.label #{t("orchestra.gruendung")}:
          %td= format_date(@orchestra.gruendung)
        %tr
          %td.label #{t("orchestra.eintritt")}:
          %td= format_date(@orchestra.eintritt)
        %tr
          %td.label #{t("orchestra.za")}:
          %td #{t("common.za_"+@orchestra.za)}
        %tr
          %td.label #{t("orchestra.konto")}:
          %td= @orchestra.konto
        %tr
          %td.label #{t("orchestra.blz")}:
          %td= @orchestra.blz
        %tr
          %td.label #{t("orchestra.austrittZum")}:
          %td= format_date(@orchestra.austritt_zum)
        %tr
          %td.label #{t("orchestra.bemerkung")}:
          %td= @orchestra.bemerkung
        %tr
          %td.label #{t("orchestra.url")}:
          %td= @orchestra.url
        %tr
          %td.label #{t("orchestra.kuendigungErfasst")}:
          %td!= format_bool(@orchestra.kuendigungErfasst)
        %tr
          %td.label #{t("orchestra.zweitanschrift")}:
          %td= @orchestra.zweitanschrift
        %tr
          %td.label #{t("orchestra.name2")}:
          %td= @orchestra.name2
        
    .wat-cf
      = edit_button(edit_orchestra_path(@orchestra),@orchestra)
      = del_button( orchestra_path(@orchestra),@orchestra)
    //= render 'report_sheets/fororchestra' unless @report_sheets.count ==0

- content_for :sidebar, render(:partial => 'sidebar.show')

.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %h2 #{@orchestra.member.mglnr} (#{t("orchestra.type_"+@orchestra.orch_type)})
      %h3
        =  @orchestra.orchName
        - if not @orchestra.zero_member_fee_balance?
          %span.label.label-danger=t("member.nonzero_balance")
        - if @orchestra.is_direct_debit? then
          %span.label.label-info=t("member.is_direct_debit")
      = entity_row(@orchestra,:fullname)
      = entity_row(@orchestra,:gruendung,:date)
      .row
        .col-md-3.text-right=label :orchestra,:url
        .col-md-9=link_to @orchestra.url, sanitize_url(@orchestra.url)
      .row
        .col-md-3.text-right=label :orchestra,:gema_kdnr
        .col-md-9=@orchestra.gema_kdnr


      = render @orchestra.member,:partial=>"member"
      = entity_row(@orchestra,:bemerkung)
      
    .btn-group{:role=>"group"}
      = edit_button(edit_orchestra_path(@orchestra),@orchestra)
      = del_button( orchestra_path(@orchestra),@orchestra)

- content_for :sidebar, render(:partial => 'sidebar.show')

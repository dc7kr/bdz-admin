.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    Orchester über #{@age}
  %table.table.table-sm.table-hover
    %thead
      %th= sortable "mglnr", attr_heading(Member,:mglnr)
      %th= sortable "orchName", attr_heading(Orchestra,:orchName)
      %th= sortable "email", attr_heading(Member,:email)
      %th= sortable "gruendung", attr_heading(Orchestra,:gruendung)
      %th.last &nbsp;
    %tbody#orchestras
      =render partial: "orchestra_pro_musica", collection: @orchestras, as: :orchestra
- content_for :sidebar, render(:partial => 'sidebar')

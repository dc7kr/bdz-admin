.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    Orchester ohne E-Mail
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %th= sortable "mglnr", attr_heading(Member,:mglnr)
      %th= sortable "orchName", attr_heading(Orchestra,:orchName)
      %th= sortable "email", attr_heading(Member,:email)
      %th &nbsp;
    %tbody#orchestras
      = render partial: "orchestra_nomail", collection: @members
- content_for :sidebar, render(:partial => 'sidebar')

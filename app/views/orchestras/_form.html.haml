= bootstrap_form_for(@orchestra, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  .container-fluid
    .panel.panel-default
      .panel-heading Orchesterdaten
      .panel-body
        = f.text_field :orchName, :required=>true
        = f.select :orch_type,   options_for_select([["Vereinsorchester", "O"], ["Kooperativ", "K"],  ["Landesorchester", "L"],["Auslandsorchester","A"],["Außerordentliche Mitglieder","X"]],:selected=>@orchestra.orch_type)
        = f.url_field :url
        = f.date_field :gruendung


    = f.fields_for :member do |member_form|
      = render :partial => "members/member_form", :locals => { :f => member_form,:member=>@orchestra.member}

    = f.text_area(:bemerkung,  cols: 80, rows: 5) 
    = submit_button()
    = cancel_button()

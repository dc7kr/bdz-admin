.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %table
    %tr
      %td= f.label :mglnr, corika_tr("orchestra","mglnr","Mitgl.-Nr."), :class => :label
      %td= f.text_field :mglnr, :class => 'number_field'
    %tr
      %td= f.label :orchName, corika_tr("orchestra","orchName","Name"), :class => :label
      %td= f.text_field :orchName, :class => 'text_field'
    %tr
      %td= f.label :anrede, corika_tr("orchestra","anrede","Anrede"), :class => :label
      %td= f.select :anrede, options_for_select([[t('common.salutation.M'),"M"],[t('common.salutation.W'), "W"]],:selected=>@orchestra.anrede)
      %td= f.text_field :anrede, :class => 'text_field'
    %tr
      %td= f.label :vorname, corika_tr("orchestra","vorname","Vorname"), :class => :label
      %td= f.text_field :vorname, :class => 'text_field'
    %tr
      %td= f.label :name, corika_tr("member","name","Nachname"), :class => :label
      %td= f.text_field :name, :class => 'text_field'
    %tr
      %td= f.label :strasse, corika_tr("orchestra","strasse","Strasse"), :class => :label
      %td= f.text_field :strasse, :class => 'text_field'
    %tr
      %td= f.label :plz, corika_tr("orchestra","plz","Plz"), :class => :label
      %td= f.text_field :plz, :class => 'text_field'
    %tr
      %td= f.label :ort, corika_tr("orchestra","ort","Ort"), :class => :label
      %td= f.text_field :ort, :class => 'text_field'
    %tr
      %td= f.label :land, corika_tr("orchestra","land","Land"), :class => :label
      %td= collection_select(:orchestra, :country_id, Country.all, :id, :name) 
    %tr
      %td= f.label :telefon, corika_tr("orchestra","telefon","Telefon"), :class => :label
      %td= f.text_field :telefon, :class => 'text_field'
    %tr
      %td= f.label :fax, corika_tr("orchestra","fax","Fax"), :class => :label
      %td= f.text_field :fax, :class => 'text_field'
    %tr
      %td= f.label :email, corika_tr("member","email","Email"), :class => :label
      %td= f.text_field :email, :class => 'text_field'
    %tr
      %td= f.label :url, corika_tr("orchestra","url","Url"), :class => :label
      %td= f.text_field :url, :class => 'text_field'

    %tr
      %td= f.label :gruendung, corika_tr("orchestra","gruendung","Gruendung"), :class => :label
      %td= f.text_field :gruendung 
    %tr
      %td= f.label :eintritt, corika_tr("orchestra","eintritt","Eintritt"), :class => :label
      %td= f.text_field :eintritt
    %tr
      %td= f.label :za, corika_tr("orchestra","za","Za"), :class => :label
      %td= f.select :za, options_for_select([["Lastschrift", "L"], ["Rechnung", "R"]],:selected=>@orchestra.za) 
    %tr
      %td= f.label :konto, corika_tr("orchestra","konto","Konto"), :class => :label
      %td= f.number_field :konto, :class => 'number_field'
    %tr
      %td= f.label :blz, corika_tr("orchestra","blz","Blz"), :class => :label
      %td= f.number_field :blz, :class => 'number_field'
    %tr
      %td= f.label :regional_organization, corika_tr("orchestra","regional_organization","Landesverband"), :class => :label
      %td= collection_select(:orchestra, :regional_organization_id, RegionalOrganization.all, :id, :name) 
    %tr
      %td
        = f.label :orch_type, corika_tr("orchestra","orch_type","OrchType"), :class => :label
      %td= f.select :orch_type, options_for_select([["Vereinsorchester", "O"], ["Kooperativ", "K"],  ["Landesorchester", "L"]],:selected=>@orchestra.orch_type) 
    %tr
      %td= f.label :austritt_zum, corika_tr("orchestra","austritt_zum","Austrittzum"), :class => :label
      %td= f.text_field :austritt_zum, :class => 'datePicker'
    %tr
      %td= f.label :bemerkung, corika_tr("orchestra","bemerkung","Bemerkung"), :class => :label
      %td= f.text_area :bemerkung, :class => 'text_field', :cols=>80, :rows=>5
    %tr
      %td= f.label :kuendigungErfasst, corika_tr("orchestra","kuendigungErfasst","Kuendigungerfasst"), :class => :label
      %td= f.check_box :kuendigungErfasst, :class => 'check_box'
    %tr
      %td= f.label :zweitanschrift, corika_tr("orchestra","zweitanschrift","Zweitanschrift"), :class => :label
      %td= f.text_field :zweitanschrift, :class => 'text_field'
    %tr
      %td= f.label :name2, corika_tr("orchestra","name2","Name2"), :class => :label
      %td= f.text_field :name2, :class => 'text_field'
  %button.button{:type => "submit"}
    = image_tag("web-app-theme/icons/tick.png", :alt => "#{t("web-app-theme.save", :default => "Save")}")
    = t("web-app-theme.save", :default => "Save")
  %span.text_button_padding= t("web-app-theme.or", :default => "or")
  = cancel_button()

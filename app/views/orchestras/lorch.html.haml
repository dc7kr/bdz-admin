.secondary-navigation
  =render :partial=>'nav'
.container
  %h2
    = t("common.all")
    = t("orchestra.regional_orchestra",:count=>3)
  #enty_info.text-center
    = page_entries_info @orchestras
  #paginator
    = paginate @orchestras
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %th= sortable "mglnr", attr_heading(Member,:mglnr), "table-dark"
      %th= sortable "orchName", attr_heading(Orchestra, :orchName), "table-dark"
      %th= sortable "email", attr_heading(Member, :email), "table-dark"
      %th &nbsp;
    %tbody#orchestras
      =render @orchestras
- content_for :sidebar, render(:partial => 'sidebar')

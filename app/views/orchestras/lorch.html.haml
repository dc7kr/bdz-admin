.secondary-navigation
  =render :partial=>'nav'
.container
  %h2
    = t("common.all")
    = t("orchestra.regional_orchestra",:count=>3)
  #enty_info.text-center
    = page_entries_info @orchestras
  #paginator
    = paginate @orchestras
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %th.first= sortable "mglnr", t("member.mglnr")
      %th= sortable "orchName", t("orchestra.orchName")
      %th= sortable "email", t("member.email")
      %th= sortable "eintritt", t("member.eintritt")
      %th.last &nbsp;
    %tbody#orchestras
      =render @orchestras
- content_for :sidebar, render(:partial => 'sidebar')

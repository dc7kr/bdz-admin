.block
  .secondary-navigation
    =render :partial => 'nav'
  .content
    %h2.title
      = t("orchestra.noreport")
    .inner
      %table.table
        %tr
          %th.first 
            = sortable "mglnr", t("orchestra.mglnr", :default => "Mglnr")
          %th= sortable "orchName", t("orchestra.orchName", :default => "Name")
          %th.last &nbsp;
        =render @orchestras

      = paginate @orchestras
      .actions-bar.wat-cf
        .actions

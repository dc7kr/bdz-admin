.block
  .secondary-navigation
    =render :partial => 'nav'
  .container
    %h2= t("orchestra.noreport")
    #enty_info.text-center
      = page_entries_info @orchestras
    #paginator
      = paginate @orchestras
    %table.table.table-sm
      %thead.table-dark
        %tr
          %th= sortable "mglnr", t("member.mglnr")
          %th= sortable "orchName", t("orchestra.orchName")
          %th= t("member.email")
          %th &nbsp;
      =render @orchestras

.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", orchestras_path
      %li.active= link_to "#{t("web-app-theme.noreport", :default => "No Report")}", noreport_orchestras_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_orchestra_path
  .content
    %h2.title
      = t("orchestra.noreport_title", :default=>"#noreport#")
    .inner
      %table.table
        %tr
          %th.first 
            = sortable "mglnr", t("orchestra.mglnr", :default => "Mglnr")
          %th= sortable "orchName", t("orchestra.orchName", :default => "Name")
          %th.last &nbsp;
        =render @orchestras

      = paginate @orchestras
      .actions-bar.wat-cf
        .actions

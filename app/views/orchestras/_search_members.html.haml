.card
  .card-header.bg-primary.text-white=t("orchestra_member.search")
  .card-body
    = bootstrap_form_with url: search_orchestra_members_path, data: { "turbo": false }  do |f|
      = f.text_field :first_name, default: params[:first_name], label: t("orchestra_member.first_name")
      = f.text_field :last_name, default: params[:last_name], label: t("orchestra_member.last_name"), help: t("orchestra_member.search_txt")
      =f.submit t("common.search"), class: "btn btn-primary" 

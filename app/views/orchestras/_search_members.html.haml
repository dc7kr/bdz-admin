.block
  %h3=t("orchestra_member.search")
  .content
    .notice=t("orchestra_member.search_txt")
    = form_tag search_orchestra_members_path, :method => 'get' do
      %table
        %tr
          %td
            %label=t("orchestra_member.first_name")
          %td= text_field_tag :first_name, params[:first_name]
        %tr
          %td
            %label=t("orchestra_member.last_name")
          %td= text_field_tag :last_name, params[:last_name]
      = submit_tag "Suchen", :name => nil

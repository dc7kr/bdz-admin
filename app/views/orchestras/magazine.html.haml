.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("web-app-theme.all", :default => "All")
      Orchester
    .inner
      %table.table
        %tr
          %th.first 
            = sortable "mglnr", t("orchestra.mglnr", :default => "Mglnr")
          %th= sortable "orchName", t("orchestra.orchName", :default => "Name")
          %th.last &nbsp;
	
        - @result.sort_by { |item| item[:magazines]}.each do |data|
          %tr
            %td=data[:name]
            %td=data[:fullname]
            %td=data[:strasse]
            %td=data[:plz]
            %td=data[:ort]
            %td=data[:land]
            %td=data[:magazines]
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    Orchester
  #enty_info.text-center
    = page_entries_info @orchestras
  #paginator= paginate @orchestras
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %tr
        %th= sortable "mglnr", t("orchestra.mglnr", :default => "Mglnr")
        %th= sortable "orchName", t("orchestra.orchName", :default => "Name")
        %th= t("member.email")
        %th.last &nbsp;
    =render @orchestras
- content_for :sidebar, render(:partial => 'sidebar')

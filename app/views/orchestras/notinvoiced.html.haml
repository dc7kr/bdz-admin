.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      Orchester
    .inner
      #entry_info
        = page_entries_info @orchestras
      %table.table.table-hover.table-condensed
        %tr
          %th.first 
            = sortable "mglnr", t("orchestra.mglnr", :default => "Mglnr")
          %th= sortable "orchName", t("orchestra.orchName", :default => "Name")
          %th.last &nbsp;
        =render @orchestras
      = paginate @orchestras
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

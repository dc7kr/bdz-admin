.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", orchestras_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_orchestra_path
      %li.active= link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_orchestra_path
  .content
    %h2.title
      = t("web-app-theme.edit", :default => "Edit")
      Orchestra
    .inner
      = form_for @orchestra, :url => orchestra_path(@orchestra), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

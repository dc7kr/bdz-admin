.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      Orchester
      = t("web-app-theme.edit", :default => "Edit")
    .inner
      = form_for @orchestra, :url => orchestra_path(@orchestra), :html => { :class => "form form-horizontal" } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

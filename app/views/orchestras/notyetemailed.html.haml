.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      Orchester ohne Mail für Event #{@event}
    .inner
      %table.table
        %thead
          %th.first= sortable "mglnr", t("orchestra.mglnr")
          %th= sortable "orchName", t("orchestra.orchName")
          %th= sortable "email", t("member.email")
          %th.last &nbsp;
        %tbody#orchestras
          =render @orchestras
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

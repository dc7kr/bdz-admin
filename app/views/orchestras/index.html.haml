.secondary-navigation
  =render :partial=>'nav'
.content
  %h2.title
    = t("common.all")
    = Orchestra.model_name.human
  .inner
    #entry_info
      = page_entries_info @orchestras
    %table.table.table-hover.table-condensed
      %thead
        %th.first= sortable "mglnr", attr_heading(Member,:mglnr)
        %th= sortable "orchName", attr_heading(Orchestra,:orchName)
        %th= sortable "email", attr_heading(Member,:email)
        %th.last &nbsp;
      %tbody#orchestras
        =render @orchestras
    #paginator
      = paginate @orchestras, { :remote=>true, :type=>"script"}
    .actions-bar.wat-cf
      .actions
- content_for :sidebar, render(:partial => 'sidebar')

.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("orchestra", count:3) 
  #enty_info.text-center
    = page_entries_info @orchestras
  #paginator
    = paginate @orchestras

  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %tr
        %th= sortable "mglnr", attr_heading(Member,:mglnr)
        %th= sortable "orchName", attr_heading(Orchestra,:orchName)
        %th= sortable "email", attr_heading(Member,:email)
        %th.last &nbsp;
    %tbody#orchestras
      =render @orchestras
- content_for :sidebar, render(:partial => 'sidebar')

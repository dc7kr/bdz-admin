.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("orchestra", count:3) 
  #entry_info.text-center= page_entries_info @orchestras
  #paginator= paginate @orchestras, params: { format: :turbo_stream }
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %tr
        %th= sortable "mglnr", attr_heading(Member,:mglnr), "table-dark"
        %th= sortable "orchName", attr_heading(Orchestra,:orchName), "table-dark"
        %th.d-none.d-md-table-cell= sortable "email", attr_heading(Member,:email), "table-dark"
        %th.last &nbsp;
    %tbody#orchestras
      =render @orchestras
- content_for :sidebar, render(:partial => 'sidebar')

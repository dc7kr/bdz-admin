.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("member.nopayment")
      (#{t("orchestra.title")})
    .inner
      = link_to_csv_download_path(t('common.download'),nopayment_orchestras_path(:format=>:csv))
      %table.table
        %tr
          %th.first 
            = sortable "mglnr", t("orchestra.mglnr", :default => "Mglnr")
          %th=t("orchestra.orchName",:default => "#orchName")
          %th=t("member.email")
          %th=t("member_account_booking.balance")
          %th.last=t("common.links")
        - @orchestras.each do |orchestra| 
          %tr
            %td=link_to orchestra.mglnr, orchestra_path(orchestra)
            %td=orchestra.orchName
            %td=mail_to orchestra.email, orchestra.email
            %td=format_currency(@accounts[orchestra.member_id],'€')
            %td=link_to_orchestra_acct orchestra, t("orchestra.member_account")
      .actions-bar.wat-cf
        .actions


.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("member.nopayment")
      (#{t("orchestra",:count=>3)})
    .inner
      %table.table-sm
        %tr
          %th.first 
            = sortable "mglnr", t("orchestra.mglnr", :default => "Mglnr")
          %th=t("orchestra.orchName",:default => "#orchName")
          %th=t("orchestra.email",:default => "#email")
          %th.last=t("member_account_booking.balance",:default => "#balance#")
        - @orchestras.each do |orchestra| 
          %tr
            %td=link_to orchestra.mglnr, orchestra_path(orchestra)
            %td=orchestra.orchName
            %td=mail_to orchestra.email, orchestra.email
            %td=format_currency(@accounts[orchestra.member_id],'€')
      .actions-bar.wat-cf
        .actions

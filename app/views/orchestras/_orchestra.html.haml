-if readable?(orchestra) 
  %tr{:class => cycle("odd", "even")}
    %td
      = link_to orchestra.mglnr, orchestra_path(orchestra)
    %td
      = orchestra.orchName
    %td
      = mail_to orchestra.email, orchestra.email
    %td.last
      = link_to_show orchestra, t("common.show")
      = link_to_edit orchestra,  t("common.edit")
      = link_to_delete orchestra, t("common.delete"), t("common.delete_confirm")
      = link_to_orchestra_acct orchestra, t("orchestra.member_account")

= form_for @url_category do |f|
  -if @url_category.errors.any?
    #error_explanation
      %h2= "#{pluralize(@url_category.errors.count, "error")} prohibited this url_category from being saved:"
      %ul
        - @url_category.errors.full_messages.each do |msg|
          %li= msg
  .container-fluid
    = form_my_field(f,@url_category, :parent)
    = form_my_field(f,@url_category, :leaf)
    = form_my_field(f,@url_category, :hascountry)
    = form_my_field(f,@url_category, :description)
  .actions
    = submit_button
    = cancel_button

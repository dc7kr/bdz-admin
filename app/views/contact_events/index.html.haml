.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("contact_event.p")
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %th=attr_heading Contact_event, :event_type
          %th=attr_heading Contact_event, :event_date
          %th=attr_heading Contact_event, :event
          %th=attr_heading Contact, :s
          %th=attr_heading Contact_event, :comment
          %th=attr_heading Contact_event, :filename
          %th
        = render @contact_events



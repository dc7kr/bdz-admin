%ul.nav.nav-tabs
  %li{ :class => 'first'}= link_to_up_path t("common.up"), @up_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to t("common.list"), contact_events_path
  -if (@contact_event)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), '#'
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to t("common.new"), new_contact_event_path


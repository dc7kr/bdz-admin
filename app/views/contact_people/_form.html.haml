= form_for @contact_person, :html => { :class => "form-horizontal" } do |f|
    = form_my_field(f,@contact_person,  :salutation)
    = form_my_field(f,@contact_person,  :first_name)
    = form_my_field(f,@contact_person,  :last_name)
    = form_my_field(f,@contact_person,  :street)
    = form_my_field(f,@contact_person,  :zip)
    = form_my_field(f,@contact_person,  :city)
    = form_my_field(f,@contact_person,  :country)
    = form_my_field(f,@contact_person,  :email)
    = form_my_field(f,@contact_person,  :phone)
 
  .actions
    =submit_button
    =cancel_button 

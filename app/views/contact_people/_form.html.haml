= semantic_form_for @contact_person do |f|
  = f.inputs do
    = f.input :salutation
    = f.input :first_name
    = f.input :last_name
    = f.input :street
    = f.input :zip
    = f.input :city
    = f.input :country
    = f.input :email
    = f.input :phone
  
  = f.actions do
    = f.action :submit, :as => :button

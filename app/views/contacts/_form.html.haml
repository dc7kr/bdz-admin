= form_for @address, :html => { :class => "form-horizontal" } do |f|
  -if @address.errors.any?
    #error_explanation
      %h2= "#{pluralize(@address.errors.count, "error")} prohibited this address from being saved:"
      %ul
        - @address.errors.full_messages.each do |msg|
          %li= msg
  .container-fluid
    = render :partial => "contacts/contact_form", :locals => { :f => f,:entity=>@address}

  .actions
    = submit_button
    = cancel_button

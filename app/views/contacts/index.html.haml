.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all", :default => "All")
      = t("contact.title")
    .inner
      %table.table
        %thead
          %th Vorname
          %th Name
          %th Adresse
          %th Telefon
          %th Fax
          %th Email
          %th
        %tbody#contacts
          = render @contacts


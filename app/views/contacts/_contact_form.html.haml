%tr
  %td= f.label :company, t("contact.company"), :class => :label
  %td= f.text_field :company, :class => 'text_field'
%tr
  %td= f.label :department, t("contact.department"), :class => :label
  %td= f.text_field :department, :class => 'text_field'
%tr
  %td= f.label :salutation, t("contact.salutation"), :class => :label
  %td= f.select :salutation, options_for_select([[t('common.salutation.M'),"M"],[t('common.salutation.W'), "W"]],:selected=>entity.salutation)
%tr
  %td=f.label :title, t("contact.title"),:class=>:label
  %td=f.text_field :title
%tr
  %td=f.label :first_name, t("contact.first_name"),:class=>:label

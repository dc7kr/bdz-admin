  %td=f.label :last_name, t("contact.last_name"),:class=>:label
  %td=f.text_field :last_name
%tr
  %td=f.label :street, t("contact.street"),:class=>:label
  %td=f.text_field :street
%tr
  %td=f.label :zip, t("contact.zip"),:class=>:label
  %td=f.text_field :zip
%tr
  %td=f.label :city, t("contact.city"),:class=>:label
  %td=f.text_field :city
%tr
  %td= f.label :country, t("contact.country"), :class => :label

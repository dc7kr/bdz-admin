.card.mb-2#name_data
  .card-header
    Name
  .card-body
    = f.text_field :company
    = f.text_field :department
    = f.select :salutation, get_salutation_options(contact.salutation), class: "form-select"
    = f.text_field :title
    = f.text_field :first_name
    = f.text_field :last_name
.card.mb-2#address_data
  .card-header
    Adresse
  .card-body
    = f.text_field :street
    = f.text_field :zip
    = f.text_field :city
    .row
      .col-md-2=f.label :country_code
      .col-md-10=f.country_select(:country_code, { iso_codes:true }, { class:  "form-select"})
.card#contact_data
  .card-header
    Telefon und E-Mail
  .card-body
    = f.text_field :phone
    = f.text_field :fax
    = f.text_field :office_phone
    = f.text_field :email

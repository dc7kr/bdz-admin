.secondary-navigation
  =render :partial=>'nav'
.container
  .card.mb-3.bg-light
    .card-body
      %h2.card-title
        = t("event_meal", count: 1)
        = @event_meal.participant_id
      .row
        .col-md-3.text-end=t('event_meal.participant_id')
        .col-md-9=link_to @event_meal.participant_id , festival_application_path(@event_meal.participant_id)
      .row
        .col-md-3.text-end=t('event_meal.meals')
        .col-md-9=@event_meal.tln
      .row
        .col-md-3.text-end=t('event_meal.veg')
        .col-md-9=@event_meal.veg
      .row
        .col-md-3.text-end=t('event_meal.name')
        .col-md-9=@event_meal.name
      .row
        .col-md-3.text-end=t('event_meal.email')
        .col-md-9=mail_to @event_meal.email,@event_meal.email
      .row
        .col-md-3.text-end=t('event_meal.orderdate')
        .col-md-9=format_date @event_meal.orderdate

      %h4.card-title Essenszeiten
      .row
        .col-md-3 &nbsp;
        .col-md-3.fw-bold Mittag
        .col-md-3.fw-bold Abend
      .row
        .col-md-3.text-end=t('date.day_names')[4]
        .col-md-3=@event_meal.lunch1
        .col-md-3=@event_meal.dinner1
      .row
        .col-md-3.text-end=t('date.day_names')[5]
        .col-md-3=@event_meal.lunch2
        .col-md-3=@event_meal.dinner2
      .row
        .col-md-3.text-end=t('date.day_names')[6]
        .col-md-3=@event_meal.lunch3
        .col-md-3=@event_meal.dinner3



      .row
        .col-md-12=link_to_edit @event_meal, t("common.edit")

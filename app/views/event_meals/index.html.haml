.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("event_meal.title")
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %tr
            %th=t('event_meal.participant_id')
            %th=t('event_meal.meals')
            %th=t('event_meal.veg')
            %th=t('event_meal.name')
            %th=t('event_meal.email')
            %th=t('event_meal.arrival_time')
            %th.last &nbsp;
        = render @event_meals

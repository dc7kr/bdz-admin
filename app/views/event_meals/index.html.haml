.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("event_meal",:count=>3)
  %table.table.table-striped.table-sm
    %thead
      %tr
        %th=attr_heading(EventMeal, :participant_id)
        %th=attr_heading(EventMeal, :meals)
        %th=attr_heading(EventMeal, :veg)
        %th=attr_heading(EventMeal, :name)
        %th=attr_heading(EventMeal, :email)
        %th=attr_heading(EventMeal, :arrival_time)
        %th.last &nbsp;
    = render @event_meals

%ul.nav.nav-tabs
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_festival_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list", :default => "List")}", event_meals_path
  -if (@event_meal and @event_meal.id)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), event_meal_path(@event_meal)
    %li{ :class => tabActiveClass(@current_action,'edit',nil)}= link_to t("common.edit"), edit_event_meal_path(@event_meal)
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_event_meal_path


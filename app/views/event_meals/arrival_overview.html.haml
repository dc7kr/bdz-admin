.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("event_meal.arrival_overview")
  %table.table-sm.table-condensed.table-hover
    %tr
      %th
      %th{:colspan=>2,:align=>:center} Mittag
      %th{:colspan=>2, :align=>:center} Abend
    %tr
      %th
      %th Vegetarisch
      %th Gesamt
      %th Vegetarisch
      %th Gesamt
    %tr
      %td Donnerstag 
      %td=@counts[:do][:mittag][:veg]
      %td=@counts[:do][:mittag][:tln]
      %td=@counts[:do][:abend][:veg]
      %td=@counts[:do][:abend][:tln]
    %tr
      %td Freitag
      %td=@counts[:fr][:mittag][:veg]
      %td=@counts[:fr][:mittag][:tln]
      %td=@counts[:fr][:abend][:veg]
      %td=@counts[:fr][:abend][:tln]
    %tr
      %td Samstag
      %td=@counts[:sa][:mittag][:veg]
      %td=@counts[:sa][:mittag][:tln]
      %td=@counts[:sa][:abend][:veg]
      %td=@counts[:sa][:abend][:tln]

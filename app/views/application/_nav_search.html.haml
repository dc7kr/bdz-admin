= form_tag search_path, :method => 'get', class: "d-flex me-5" do
  = hidden_field_tag :direction, sort_direction
  = hidden_field_tag :sort, sort_column

  .input-group
    %input.form-control{ type: :search, name: :search, placeholder: t("common.search"), "aria-label": t("common.search"), class: "form-control" }
    = button_tag(type: 'submit', class: "btn btn-primary") do 
      = my_fa_icon("search")

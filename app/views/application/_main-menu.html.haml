%nav.navbar.navbar-default
  .container-fluid
    .collapse.navbar-collapse
      %ul.nav.navbar-nav.navbar-left
        %li{:role => "presentation", :class=>"dropdown"}
          %a{:href=>"/"}
            %span.glyphicon.glyphicon-home
        -if ( current_user ) then
          %li{:role => "presentation", :class=>"dropdown"}
            %a.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :toggle=> "dropdown" }}=t("main_menu.public_data")
            =render :partial => "public_data_dropdown"
          %li{:role => "presentation", :class=>"dropdown"}
            %a.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :toggle=> "dropdown" }}=t("main_menu.member_data")
            =render :partial => "member_data_dropdown"

          - if current_user and current_user.reference_data_permission? then
            %li{:role => "presentation", :class=>"dropdown"}
              %a.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :toggle=> "dropdown" }}=t("main_menu.reference_data")
              =render :partial => "reference_data_dropdown"
          - if current_user and current_user.magazine_permission? then
            %li{:role => "presentation", :class=>"dropdown"}
              %a.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :toggle=> "dropdown" }}=t("main_menu.magazine_data")
              =render :partial => "magazine_dropdown"
          - if current_user and current_user.festival_permission? then
            %li{ :class => tabActiveClass(current_area,'festival_data',nil)}= link_to "#{t("main_menu.festival_data")}", home_festival_data_path 
          -if current_user and current_user.has_role?(:regional) then
            %li{ :class => tabActiveClass(current_area,'regional','last')}= link_to "#{t("main_menu.regional")}", RegionalOrganization.with_role(:regional, current_user).first

      %ul.nav.navbar-nav.navbar-right
        -if current_user and current_user.bulk_permission? then
          %li{:role => "presentation", :class=>"dropdown"}
          %li{ :class => tabActiveClass(current_area,'regional','last')}= link_to content_tag(:span, "",class: ["glyphicon","glyphicon-time"]), home_cron_path
        -if current_user and current_user.has_role?(:admin) then
          %li{:role => "presentation", :class=>"dropdown"}
            %a.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :toggle=> "dropdown" }}=content_tag(:span, "",class: ["glyphicon","glyphicon-cog"])
            =render :partial => "admin_dropdown"
        -if current_user
          %li{ :role => "presentation", :class=>"dropdown" }
            %a{:href => "/logout"}
              %span.glyphicon.glyphicon-log-out
          %li{ :role => "presentation", :class=>"dropdown" }
            %a{:href => "/about"}
              %span.glyphicon.glyphicon-info-sign
      - if current_user then
        %p.navbar-text.navbar-right Angemeldet als: #{current_user.email}

%ul.wat-cf
  -if ( current_user ) then
    %li{ :class => tabActiveClass(current_area,'public_data','first')}= link_to "#{t("main_menu.public_data")}",home_public_data_path
    %li{ :class => tabActiveClass(current_area,'member_data',nil)}= link_to "#{t("main_menu.member_data")}", home_member_data_path

    - if current_user and current_user.reference_data_permission? then
      %li{ :class => tabActiveClass(current_area,'reference_data',nil)}= link_to "#{t("main_menu.reference_data")}", home_reference_data_path 
    - if current_user and current_user.magazine_permission? then
      %li{ :class => tabActiveClass(current_area,'magazine_data',nil)}= link_to "#{t("main_menu.magazine_data")}", home_magazine_data_path 
    - if current_user and current_user.festival_permission? then
      %li{ :class => tabActiveClass(current_area,'festival_data',nil)}= link_to "#{t("main_menu.festival_data")}", home_festival_data_path 
    -if current_user and current_user.has_role?(:admin) then
      %li{ :class => tabActiveClass(current_area,'admin_data','last')}= link_to "#{t("main_menu.admin_data")}", home_admin_data_path
    -if current_user and current_user.bulk_permission? then
      %li{ :class => tabActiveClass(current_area,'cron','last')}= link_to "#{t("main_menu.cron")}", home_cron_path
    -if current_user and current_user.has_role?(:regional) then
      %li{ :class => tabActiveClass(current_area,'regional','last')}= link_to "#{t("main_menu.regional")}", RegionalOrganization.with_role(:regional, current_user).first

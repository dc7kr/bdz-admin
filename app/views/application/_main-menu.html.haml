%ul.wat-cf
  -if ( current_user ) then
    %li{ :class => tabActiveClass(current_area,'public_data','first')}= link_to "#{t("common.public_data")}",home_public_data_path
    %li{ :class => tabActiveClass(current_area,'member_data',nil)}= link_to "#{t("common.member_data")}", home_member_data_path
    %li{ :class => tabActiveClass(current_area,'reference_data',nil)}= link_to "#{t("common.reference_data")}", home_reference_data_path 
    %li{ :class => tabActiveClass(current_area,'magazine_data',nil)}= link_to "#{t("common.magazine_data")}", home_magazine_data_path 
    -if current_user and current_user.admin? then
      %li{ :class => tabActiveClass(current_area,'admin_data','last')}= link_to "#{t("common.admin_data")}", home_admin_data_path
    -if current_user and current_user.cron_permission? then
      %li{ :class => tabActiveClass(current_area,'cron','last')}= link_to "#{t("common.cron")}", home_cron_path

%li.nav-item.dropdown
  - r = main_app
  %a.nav-link.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :bs=> { :toggle=>"dropdown" }}, :aria => { :expanded => "false"}}
    =t("main_menu.member_data")
  %ul.dropdown-menu{ :aria => {:labelledby=>"dropdownMenu2"}}
    - if policy(RegionalOrganization).show?
      %li= link_to "Landesverbände", r.regional_organizations_path, :class=>"dropdown-item"
    - if policy(Orchestra).show?
      %li= link_to "Orchester", r.orchestras_path , :class=>"dropdown-item"
    - if policy(PersonMember).show?
      %li= link_to "Einzelmitglieder", r.person_members_path , :class=>"dropdown-item"
    - if policy(HonorMember).show?
      %li= link_to "Ehrungen", r.honor_members_path , :class=>"dropdown-item"
    - if current_user and (current_user.has_role?(:admin) or current_user.has_role?(:national) )
      .dropdown-divider
      %li= link_to "Mitgliederbericht", "/member_report", :class=>"dropdown-item"
      %li= link_to t('report_sheet.final'), r.final_report_sheets_path, :class=>"dropdown-item"
      %li= link_to t('report_sheet.analysis'), r.analysis_report_sheets_path, :class=>"dropdown-item"

%li.nav-item.dropdown
  %a.nav-link.dropdown-toggle{:href=>"#", :role=>"button" ,:data=> { :bs => { :toggle=> "dropdown" }}}
    =t("main_menu.festival_data")
    %span.caret
  %ul.dropdown-menu{ :aria => {:labelledby=>"dropdownMenu2"}}
    %li= link_to t('festival_application.other'), festival_applications_path, :class=>"dropdown-item"
    %li= link_to t('festival_participant.other'), permitted_festival_applications_path, :class=>"dropdown-item"
    %li= link_to t('festival_concert.other'), festival_concerts_path, :class=>"dropdown-item"
    %li= link_to t('festival_exhibitor', count:3), festival_exhibitors_path, class: "dropdown-item"
    -if current_user.has_role? :national or current_user.has_role? :admin
      %li
        %hr.dropdown-divider
      %li= link_to t('event_meal.other'), event_meals_path, :class=>"dropdown-item"
      %li= link_to t('event_card.other'), event_cards_path, :class=>"dropdown-item"
      %li= link_to t('event_meal.arrival_overview'), arrival_overview_event_meals_path, :class=>"dropdown-item"
      - if current_user.has_role? :bulk or current_user.has_role? :admin
        %li
          %hr.dropdown-divider
        %li= link_to t('festival_mail.other'), festival_mails_path, :class=>"dropdown-item"
        %li= link_to t('festival_mail.gen_invoices'), invoices_festival_mails_path, :class=>"dropdown-item"
        %li= link_to t('festival_mail.reservation_invoices'), reservation_invoices_festival_mails_path, :class=>"dropdown-item"

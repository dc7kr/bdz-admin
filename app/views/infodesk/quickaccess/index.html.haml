%h2 Teilnehmer
%p
  = form_tag search_infodesk_festival_applications_path, :method => 'get' do
    = hidden_field_tag :direction, params[:direction]
    = hidden_field_tag :sort, params[:sort]
    = text_field_tag :search, params[:search], :class => :quickaccess,:size=>4
    = submit_tag "Abfragen", :name => nil

%h2 Kartenbestellungen
%p
  = form_tag search_infodesk_event_cards_path, :method => 'get' do
    = hidden_field_tag :direction, params[:direction]
    = hidden_field_tag :sort, params[:sort]
    = text_field_tag :search, params[:search], :class => :quickaccess,:size=>4
    = submit_tag "Abfragen", :name => nil

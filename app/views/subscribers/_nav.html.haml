%ul.wat-cf
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_magazine_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list")}", subscribers_path
  -if (@subscriber and @subscriber.id != nil )
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), subscriber_path(@subscriber)
    %li{:class => tabActiveClass(@current_action,'edit',nil)}= link_to t("common.edit"), edit_subscriber_path(@subscriber)
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_subscriber_path(@subscriber)


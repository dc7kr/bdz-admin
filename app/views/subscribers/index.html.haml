.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("subscriber.p")
    .inner
      %table.table
        %thead
          %th.first=t("contact_person.first_name")
          %th=t("contact_person.last_name")
          %th=t("contact_person.phone")
          %th=t("contact_person.email")
          %th.last &nbsp;
        %tbody#subscribers
          =render @subscribers
      #paginator
        = paginate @subscribers
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

  

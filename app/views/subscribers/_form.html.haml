.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %table
    %tr
      %td= f.label :firma, t("contact.company"), :class => :label
      %td= f.text_field :firma, :class => 'text_field'
    %tr
      %td= f.label :abteilung, t("contact.department"), :class => :label
      %td= f.text_field :abteilung, :class => 'text_field'
    %tr
    %tr
      %td= f.label :anrede, t("contact.anrede"), :class => :label
      %td= f.select :anrede, options_for_select([[t('common.salutation.M'),"M"],[t('common.salutation.W'), "W"]],:selected=>@subscriber.anrede)
    %tr
      %td= f.label :vorname, t("contact.vorname"), :class => :label
      %td= f.text_field :vorname, :class => 'text_field'
    %tr
      %td= f.label :name, t("contact.name"), :class => :label
      %td= f.text_field :name, :class => 'text_field'
    %tr
      %td= f.label :strasse, t("contact.strasse"), :class => :label
      %td= f.text_field :strasse, :class => 'text_field'
    %tr
      %td= f.label :plz, t("contact.plz"), :class => :label
      %td= f.text_field :plz, :class => 'text_field'
    %tr
      %td= f.label :ort, t("contact.Ort"), :class => :label
      %td= f.text_field :ort, :class => 'text_field'
    %tr
      %td= f.label :country, t("contact.country"), :class => :label
      %td= collection_select(:subscriber, :country_id, Country.all, :id, :name) 
    %tr
      %td= f.label :telefon, t("contact.phone"), :class => :label
      %td= f.text_field :telefon, :class => 'text_field'
    %tr
      %td= f.label :fax, t("contact.fax"), :class => :label
      %td= f.text_field :fax, :class => 'text_field'
    %tr
      %td= f.label :email, t("contact.email"), :class => :label
      %td= f.text_field :email, :class => 'text_field'
      
    %tr
      %td= f.label :account, t("subscriber.account"), :class => :label
      %td= f.text_field :account, :class => 'text_field'
    %tr
      %td= f.label :bic, t("subscriber.bic"), :class => :label
      %td= f.text_field :bic, :class => 'text_field'
  %button.button{:type => "submit"}
    =submit_button(t("common.save", :default => "Save"))
  = cancel_button()
  %br

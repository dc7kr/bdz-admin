.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %table
    = render :partial => "contacts/contact_form", :locals => { :f => f,:entity=>@subscriber }
    %tr
      %td= f.label :account, t("subscriber.account"), :class => :label
      %td= f.text_field :account, :class => 'text_field'
    %tr
      %td= f.label :bic, t("subscriber.bic"), :class => :label
      %td= f.text_field :bic, :class => 'text_field'
  %button.button{:type => "submit"}
    =submit_button(t("common.save", :default => "Save"))
  = cancel_button()
  %br

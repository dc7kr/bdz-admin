.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %table
    %tr
      %td.label= f.label :firma
      %td= f.text_field :firma, :class => 'text_field'
    %tr
      %td.label= f.label :abteilung
      %td= f.text_field :abteilung, :class => 'text_field'
    %tr
    %tr
      %td.label= f.label :anrede
      %td= f.select :anrede, options_for_select([[t('common.salutation_d.M'),"M"],[t('common.salutation_d.W'), "W"]],:selected=>@magazine_sampling.anrede)
    %tr
      %td.label= f.label :vorname
      %td= f.text_field :vorname, :class => 'text_field'
    %tr
      %td.label= f.label :name
      %td= f.text_field :name, :class => 'text_field'
    %tr
      %td.label= f.label :strasse
      %td= f.text_field :strasse, :class => 'text_field'
    %tr
      %td.label= f.label :plz
      %td= f.text_field :plz, :class => 'text_field'
    %tr
      %td.label= f.label :ort
      %td= f.text_field :ort, :class => 'text_field'
    %tr
      %td.label= f.label :country
      %td= collection_select(:magazine_sampling, :country_id, Country.all, :id, :name) 
    %tr
      %td.label= f.label :telefon
      %td= f.text_field :telefon, :class => 'text_field'
    %tr
      %td.label= f.label :fax
      %td= f.text_field :fax, :class => 'text_field'
    %tr
      %td.label= f.label :email
      %td= f.text_field :email, :class => 'text_field'
    %tr
      %td.label= f.label :count
      %td= f.text_field :count, :class => 'text_field'
      
  =submit_button()
  = cancel_button()
  %br

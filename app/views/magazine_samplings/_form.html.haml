.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %table
    %tr
      %td.label= f.label :company
      %td= f.text_field :company, :class => 'text_field'
    %tr
      %td.label= f.label :department
      %td= f.text_field :department, :class => 'text_field'
    %tr
    %tr
      %td.label= f.label :salutation
      %td= f.select :salutation, options_for_select([[t('common.salutation_d.M'),"M"],[t('common.salutation_d.W'), "W"]],:selected=>@magazine_sampling.salutation)
    %tr
      %td.label= f.label :first_name
      %td= f.text_field :first_name, :class => 'text_field'
    %tr
      %td.label= f.label :last_name
      %td= f.text_field :last_name, :class => 'text_field'
    %tr
      %td.label= f.label :street
      %td= f.text_field :street, :class => 'text_field'
    %tr
      %td.label= f.label :zip
      %td= f.text_field :zip, :class => 'text_field'
    %tr
      %td.label= f.label :city
      %td= f.text_field :city, :class => 'text_field'
    %tr
      %td.label= f.label :country
      %td= collection_select(:magazine_sampling, :country_id, Country.all, :id, :name) 
    %tr
      %td.label= f.label :phone
      %td= f.text_field :phone, :class => 'text_field'
    %tr
      %td.label= f.label :fax
      %td= f.text_field :fax, :class => 'text_field'
    %tr
      %td.label= f.label :email
      %td= f.text_field :email, :class => 'text_field'
    %tr
      %td.label= f.label :count
      %td= f.text_field :count, :class => 'text_field'
      
  =submit_button()
  = cancel_button()
  %br

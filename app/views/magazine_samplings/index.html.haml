.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("magazine_sampling.p")
    .inner
      #entry_info
        = page_entries_info @magazine_samplings
      %table.table.table-hover.table-condensed
        %thead
          %th.first{:style=>"width: 30%"}=attr_heading(Concact,:company)
          %th.first=attr_heading(Contact,:first_name)
          %th.first=attr_heading(Contact,:last_name)
          %th.first=attr_heading(Contact,:city)
          %h=attr_heading(MagazineSampling,:count)
          %th.last
        %tbody#magazine_samplings
          = render @magazine_samplings
      #paginator
        = paginate @magazine_samplings, :remote=>true
- content_for :sidebar, render(:partial => 'sidebar')

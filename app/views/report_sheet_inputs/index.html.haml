.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("report_sheet_input",:count=>3)

  #entry_info.text-center= page_entries_info @report_sheet_inputs
  #paginator= paginate @report_sheet_inputs, params: { format: :turbo_stream }
  %table.table.table-sm.table-hover.table-condensed
    %thead
      %th=t("common.year")
      %th=t("member.mglnr")
      %th=t("orchestra.orch_name") 
      %th=t("report_sheet_input.token")
      %th=t("common.updated_at") 
      %th.last &nbsp;
    %tbody#report_sheet_inputs=render @report_sheet_inputs

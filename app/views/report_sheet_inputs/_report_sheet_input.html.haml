%tr
  - if report_sheet_input.report_sheet.nil?
    %td
      %b BROKEN
    %td
      =link_to_delete(report_sheet_input)
  - else
    %td=report_sheet_input.report_sheet.year
    -if report_sheet_input.orchestra != nil then
      %td #{report_sheet_input.orchestra.member.mglnr}
      %td #{report_sheet_input.orchestra.orchName} 
    -else
      %td NIL 
      %td NIL 
    %td=report_sheet_input.token
    %td=report_sheet_input.report_sheet.updated_at unless report_sheet_input.report_sheet.nil?
    %td=link_to t("report_sheet_input",:count=>1)+" "+report_sheet_input.report_sheet.year.to_s, metadata_report_sheet_input_path(report_sheet_input)
    %td=link_to "Direkt", login_mgl_report_sheet_inputs_path(:mglnr=>report_sheet_input.orchestra.member.mglnr,:token=> report_sheet_input.token)


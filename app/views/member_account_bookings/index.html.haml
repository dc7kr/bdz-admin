.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("booking.index")
      #{@name} (#{@member.mglnr})
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %tr
            %th.first= t('booking.booking_date')
            %th= t('booking.booking_type') 
            %th= t('booking.booking_year')
            %th= t('booking.text')
            %th= t('booking.amount')
            %th= t('booking.has_reference')
            %th.last
        %tbody#member_account_bookings
          = render @bookings

- content_for :sidebar, render(:partial => 'sidebar')

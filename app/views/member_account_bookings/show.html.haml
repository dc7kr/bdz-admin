.secondary-navigation=render :partial=>'nav'
.container
  %h2.title
    = t("member_account_bookings.booking_types.#{@booking.booking_type}")
    = t("member_account_booking", count:1)

  = entity_row @booking, :booking_year
  = entity_row @booking, :booking_date, :date
  = entity_row @booking, :booking_txt
  = entity_row @booking, :amount, :currency
  - if @invoice.present?  and @invoice.generator_session_id.present?
    - invoice = CorikaInvoices::Invoice.find(@booking.invoice_id)
    = entity_row @booking, :invoice_id
    = entity_row invoice, :generator_session_id
  - else
    = entity_row @booking, :filename

  .row
    .col-md-3.fw-bold=t("invoice", count: 1)
    .col-md-9
      - if @booking.invoice_id.present?
        %b Nr. #{@invoice.full_number} vom #{l @invoice.invoice_date}
        = link_to my_fa_icon("download"), invoice_pdf_download_path(invoice), class: 'btn btn-secondary btn-sm'
        = link_to 'Rechnungsvorschau', invoice_preview_member_account_booking_path(@booking), data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'
        - if @invoice.customer.direct_debit?
          = link_to 'SEPA', invoice_sepa_member_account_booking_path(@booking), class: 'btn btn-secondary btn-sm'



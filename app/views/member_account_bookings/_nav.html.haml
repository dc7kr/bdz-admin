%ul.nav.nav-tabs.d-print-none
  - if @member_type == :orchestra
    %li.nav-item= link_to_up_path t("common.up"), orchestra_path(@member_entity)
    = nav_to_list MemberAccountBooking, orchestra_member_account_bookings_path(@member_entity)
    = nav_to_new MemberAccountBooking, new_orchestra_member_account_booking_path(@member_entity)
  - elsif @member_type == :person_member 
    %li{ :class => 'nav-item'}= link_to_up_path t("common.up"), person_member_path(@member_entity)
    = nav_to_list MemberAccountBooking, person_member_member_account_bookings_path(@member_entity)
    = nav_to_new MemberAccountBooking, new_person_member_member_account_booking_path(@member_entity)
  - elsif @member_type == :regional_organization 
    %li{ :class => 'nav-item'}= link_to_up_path t("common.up"), regional_organization_path(@member_entity)
    = nav_to_list MemberAccountBooking, regional_organization_member_account_bookings_path(@member_entity)
    = nav_to_new MemberAccountBooking, new_regional_organization_member_account_booking_path(@member_entity)
  -if ( @booking != nil and @booking.id != nil) then
    = nav_to_edit @booking

- content_for :entity_menu, render(:partial => 'entity_menu')

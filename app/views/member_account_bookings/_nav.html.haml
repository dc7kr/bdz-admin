%ul.wat-cf
  -if(@isOrchestra)
    %li{ :class => 'first'}= link_to_up_path t("common.up"), orchestra_path(params[:orchestra_id])
    %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list")}", orchestra_member_account_bookings_path(@orchestra)
    - if current_user.accounting_permission?
      %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new")}", new_orchestra_member_account_booking_path(@orchestra)
  - else
    %li{ :class => 'first'}= link_to_up_path t("common.up"), person_member_path(@member)
    %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list")}", person_member_member_account_bookings_path(@member)
    - if current_user.accounting_permission?
      %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new")}", new_person_member_member_account_booking_path(@member)
  -if ( @booking != nil and @booking.id != nil) then
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"),'#'



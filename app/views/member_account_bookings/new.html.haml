%h1 Neue Buchung 

= form_for ([@member,@booking]) do |f|
  -if @booking.errors.any?
    #error_explanation
      %h2= "#{pluralize(@booking.errors.count, "error")} prohibited this booking from being saved:"
      %ul
        - @booking.errors.full_messages.each do |msg|
          %li= msg
  = render :partial => "form", :locals => {:f => f}
-if(@isOrchestra)
  = link_to 'Back', orchestra_member_account_bookings_path(@member)
-else
  = link_to 'Back', person_member_member_account_bookings_path(@member)

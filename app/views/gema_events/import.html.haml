.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("gema_event",:count=>3)
  #entry_info= page_entries_info @gema_events
  %table.table.table-sm.table-hover.table-condensed
    %thead
      %th.first Nf
      %th Kdnr
      %th Date
      %th Title
      %th Name
      %th Amount
      %th.last &nbsp;

    %tbody#gema_events=render @gema_events
  #paginator= paginate @gema_events

- content_for :sidebar, render(:partial => 'sidebar')
    


%ul.nav.nav-tabs
  %li{ :role=>"presentation", :class => 'first'}= link_to_up_path t("common.up"), home_member_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to t("common.list"), gema_events_path
  
  -if (not @gema_event.nil?)
    -if can? :edit, @gema_event and not @gema_event.id.nil? 
      %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), @gema_event
      %li{ :class => tabActiveClass(@current_action,'edit',nil)}= link_to t("common.edit"), edit_gema_event_path(@gema_event)
  - if can? :create, GemaEvent
    %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to t("common.new", :default => "New"), new_gema_event_path


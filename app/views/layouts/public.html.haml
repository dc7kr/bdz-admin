!!!
%html
  %head
    %title BDZ Online
    = stylesheet_link_tag :ef, 'data-turbo-track'=>true, media: :all
    = javascript_include_tag :application, 'data-turbo-track'=>true
    //= javascript_include_tag :application, params[:controller], 'data-turbo-track'=>true
    = csrf_meta_tags
  %body
    .container
      #user-navigation
        -if (current_user)
          %nav.navbar.navbar-inverse
            .container-fluid
              / Brand and toggle get grouped for better mobile display
              .navbar-header
                %button.navbar-toggle.collapsed{"aria-expanded" => "false", "data-target" => "#bs-example-navbar-collapse-1", "data-toggle" => "collapse", :type => "button"}
                %p.navbar-text.navbar-right Eingeloggt als #{current_user.email}
                %a.btn.btn-danger.navbar-btn.navbar-right{:href => "/logout"}= t("web-app-theme.logout", :default => "Logout")
      - if not current_user.nil?
        = render :partial => "public_main_nav"
      .wrapper#wrapper
        #flash-messages
          = render :partial => "flash_messages", locals: { :flash => flash }
        #main
          = yield

!!!
%html
  %head
    %title= content_for(:title)
    %meta{:name=>"viewport", :content=>"width=device-width, initial-scale=1, shrink-to-fit=no"}
    %meta{:name=>"apple-mobile-web-app-capable", :content=>"yes"}
    = csrf_meta_tags
    = csp_meta_tag
    %script{:async => "", "data-turbo-track" => "reload", :src => "https://ga.jspm.io/npm:es-module-shims@1.8.2/dist/es-module-shims.js"}

    = javascript_importmap_tags
    = yield :head

    %link{:href => "/manifest.json", :rel => "manifest"}/
    %link{:href => "/icon.png", :rel => "icon", :type => "image/png"}/
    %link{:href => "/icon.svg", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png", :rel => "apple-touch-icon"}/
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
  %body
    - if not current_user.nil?
      = render :partial => "main_menu"
    #flash-messages
      = render :partial => "flash_messages", locals: { :flash => flash }

    .wrapper
      #content.pb-5.w-100.container-fluid
        #main
          = yield
          = turbo_frame_tag :modal
          .toast#remote_toast{"aria-atomic" => "true", "aria-live" => "assertive", :role => "alert"}
      = render("footer")


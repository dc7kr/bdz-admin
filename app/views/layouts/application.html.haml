!!!
%html
  %head
    %title #{title}
    = stylesheet_link_tag :application
    = javascript_include_tag :application
    = csrf_meta_tag
  %body
    #container
      #header
        %h1
          %a{:href => "/"} #{title}
        #user-navigation
          %ul.wat-cf
            -if current_user 
              %li.username
                Angemeldet als: #{current_user.email} 
              %li
                %a.logout{:href => "/logout"}= t("account.logout")
            %li
              %a{:href => "/about"}= t("common.about", :default => "About")
        #main-navigatio
          = render :partial => "main-menu"
      #wrapper.wat-cf
        #flash-message
          - flash.each do |type, message|
            %div{:class => "message #{type}", :id => "flash_#{type}"}
              %p=message
        #main
          = yield
        #sidebar
          = yield :sidebar
        #footer
          .block
            %p
              Copyright &copy; 2011-#{Time.now.year} by Karsten Richter 


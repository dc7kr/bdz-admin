!!!
%html
  %head
    %title #{title}
    = stylesheet_link_tag :application
    = javascript_include_tag :application
    = csrf_meta_tag
  %body
    #container
      #header
        %h1
          %a{:href => "/"} #{title}
        #user-navigation
          %ul.wat-cf
            -if current_user 
              %li.username
                Angemeldet als: #{current_user.email} 
              %li
                =link_to t("web-app-theme.profile"), edit_user_registration_path
              %li
                = link_to t("web-app-theme.settings"), edit_user_registration_path
              %li
                %a.logout{:href => "/logout"}= t("web-app-theme.logout", :default => "Logout")
            %li
              %a{:href => "/about"}= t("common.about", :default => "About")
        #main-navigation
          = render :partial => "main-menu"
      #wrapper.wat-cf
        .flash
          - flash.each do |type, message|
            %div{:class => "message #{type}"}
              %p= message
        #main
          .block#mainblock
            = yield
        #sidebar
          = yield :sidebar
        #footer
          .block
            %p
              Copyright &copy; 2011-#{Time.now.year} by Karsten Richter 


!!!
%html
  %head
    %title #{title}
    %meta{:name=>"viewport", :content=>"width=device-width, initial-scale=1, shrink-to-fit=no"}
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body
    - if not current_user.nil?
      = render :partial => "main_menu"
    #flash-message
      = flash_messages
    .wrapper
      #content.pb-5.w-100.container-fluid
        #main
          = yield
          = turbo_frame_tag :modal
      - if not current_user.nil?
        .offcanvas.offcanvas-end#offcanvasSidebar{ :data => { :bs => { :backdrop => "static"} }, :aria => { :labelledby=> "sidebarLabel" } }
          .offcanvas-header
            %h5.offcanvas-title#sidebarLabel Sidebar
            %button.btn-close.text-reset{ :type=>"button", :data=> { :bs=> { :dismiss=> "offcanvas"}, :aria => {:label => "close"}}}
          .offcanvas-body 
            = yield :sidebar
    %footer.page-footer.fixed-bottom.font-small.d-print-none.text-white.bg-dark
      %p.text-center.p-1.mb-0 Copyright &copy; 2011-#{Time.now.year} by Karsten Richter - Version #{IMAGE_VERSION}-#{GIT_REVISION}

!!!
%html
  %head
    %title #{title}
    = stylesheet_link_tag :application
    = javascript_include_tag :application
    = csrf_meta_tag
  %body
    #container
      #header{:class=>Rails.env}
        - if Rails.env == "development"
          .overlay 
            DEV
        #main-navigatio
          = render :partial => "main-menu"
      #wrapper.wat-cf
        #flash-message
          - flash.each do |type, message|
            %div{:class => "alert #{map_flash_type(type)}", :id => "flash_#{type}"}
              %p=message
        #main
          = yield
        #sidebar
          = yield :sidebar
        #footer
          .block
            %p
              Copyright &copy; 2011-#{Time.now.year} by Karsten Richter 


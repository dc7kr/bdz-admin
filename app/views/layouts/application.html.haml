!!!
%html
  %head
    %title #{title}
    = stylesheet_link_tag :application, 'data-turbolinks-track'=>true, media: :all
    = javascript_include_tag :application, 'data-turbolinks-track'=>true
    = csrf_meta_tags
    %meta{:name=>"viewport", :content=>"width=device-width, initial-scale=1, shrink-to-fit=no"}
  %body
    #header{:class=>Rails.env}
      #main-nav
        = render :partial => "main_menu"
    #flash-message
      = flash_messages
    #main
      = yield
    #sidebar
      = yield :sidebar
    #footer
      .block
        %p
          Copyright &copy; 2011-#{Time.now.year} by Karsten Richter - rev. #{GIT_REVISION}


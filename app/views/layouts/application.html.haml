!!!
%html
  %head
    %title= content_for(:title)
    %meta{:name=>"viewport", :content=>"width=device-width, initial-scale=1, shrink-to-fit=no"}
    %meta{:name=>"apple-mobile-web-app-capable", :content=>"yes"}
    = csrf_meta_tags
    = csp_meta_tag
    %script{:async => "", "data-turbo-track" => "reload", :src => "https://ga.jspm.io/npm:es-module-shims@1.8.2/dist/es-module-shims.js"}

    = javascript_importmap_tags
    = yield :head

    %link{:href => "/manifest.json", :rel => "manifest"}/
    %link{:href => "/icon.png", :rel => "icon", :type => "image/png"}/
    %link{:href => "/icon.svg", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png", :rel => "apple-touch-icon"}/
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
  %body
    - if not current_user.nil?
      = render :partial => "main_menu"
    #flash_messages
      = render :partial => "flash_messages", locals: { :flash => flash }

    .wrapper
      #content.pb-5.w-100.container-fluid
        #main
          = yield
          = turbo_frame_tag :modal
          = turbo_stream_from :notifications
          #notifications{ data: { controller: "toast"} }
            / Notifications will be appended here
          .toast#remote_toast{"aria-atomic" => "true", "aria-live" => "assertive", :role => "alert"}
            .toast-header
              %i.fas.fa-info-circle
              %strong.me-auto#rt_title
              %small#rt_time
              %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "toast", :type => "button"}
            .toast-body#rt_body


      - if not current_user.nil?
        .offcanvas.offcanvas-end#offcanvasSidebar{ :data => { :bs => { :backdrop => "static"} }, :aria => { :labelledby=> "sidebarLabel" } }
          .offcanvas-header
            %h5.offcanvas-title#sidebarLabel Sidebar
            %button.btn-close.text-reset{ :type=>"button", :data=> { :bs=> { :dismiss=> "offcanvas"}, :aria => {:label => "close"}}}
          .offcanvas-body
            = yield :sidebar

    = render "footer"
    %dialog#turbo-confirm-dialog{"aria-describedby" => "turbo-confirm-message", "aria-labelledby" => "turbo-confirm-title", :closedby => "any"}
      %header
        %hgroup
          %h3#turbo-confirm-title=t("common.confirm")
          %p#turbo-confirm-message
      %footer
        %button.btn.btn-sm.btn-secondary{:command => "close", :commandfor => "turbo-confirm-dialog", :type => "button"}
          =t("common.cancel")
        %form{:method => "dialog"}
          %button.btn.btn-sm.btn-danger{:type => "submit", :value => "confirm"}
            Confirm


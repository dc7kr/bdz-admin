<!DOCTYPE html>
<html>
<head>
  <title>Notenverzeichnis</title>
  <%= stylesheet_link_tag :all %>
  <%= javascript_include_tag "jquery-1.6.1.min.js" %>
  <%= javascript_include_tag "rails.jquery.js" %>
  <%= csrf_meta_tag %>
  <%= yield :head %>
</head>
<body>
<div id="header">
	<h1 id="title"> Notenverzeichnis </h1>
	<div id="header-badge"></div>
	<div id="user_nav">
  		<% if user_signed_in? %>
    	Angemeldet als <%= current_user.email %>. Not you?
    	<%= link_to "Abmelden", destroy_user_session_path %>
  		<% else %>
    		<%= link_to "Anmelden", new_user_session_path %>
			|
    		<%= link_to "Registrieren", new_user_registration_path %>
  		<% end %>
	</div>
</div>
<div id="body-wrapper">
<p id="notice"><%= notice %></p>
<p class="alert"><%= alert %></p>

<%= yield %>
</div>
</body>
</html>

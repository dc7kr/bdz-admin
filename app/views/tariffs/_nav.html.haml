  %li.nav-item= link_to t("common.list"), tariffs_path, :class=>tabActiveClass(@current_action,'index','nav-link')
  -if (not @tariff.nil?)
    -if can? :edit, @tariff and not @tariff.id.nil? 
      %li.nav-item= link_to t("common.show"), @tariff, :class => tabActiveClass(@current_action,'show',"nav-link")
      %li.nav-item= link_to t("common.edit"), edit_tariff_path(@tariff), :class => tabActiveClass(@current_action,'edit',"nav-link")
  -else

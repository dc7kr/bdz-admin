%h1 Listing tariffs

%table.table.table-hover.table-condensed
  %tr
    %th Tariff type
    %th Description
    %th Amount
    %th
    %th
    %th

  - @tariffs.each do |tariff|
    %tr
      %td= tariff.tariff_type
      %td= tariff.description
      %td= tariff.amount
      %td
        = link_to_show tariff

= bootstrap_form_for(@tariff, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f|
  %ul
    - @tariff.errors.full_messages.each do |msg|
      %li= msg

  .container-fluid
    = f.text_field(:tariff_type)
    = f.text_field(:description)
    = f.text_field(:tag)
    = f.number_field(:amount)
    .actions
      = submit_button
      = cancel_button

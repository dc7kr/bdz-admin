= form_for @tariff do |f|
  -if @tariff.errors.any?
    #error_explanation
      %h2= "#{pluralize(@tariff.errors.count, "error")} prohibited this tariff from being saved:"
      %ul
        - @tariff.errors.full_messages.each do |msg|
          %li= msg

  .field
    = f.label :tariff_type
    = f.number_field :tariff_type
  .field
    = f.label :description
    = f.text_field :description
  .field
    = f.label :amount
    = f.text_field :amount
  .actions
    = f.submit 'Save'
    = cancel_button()

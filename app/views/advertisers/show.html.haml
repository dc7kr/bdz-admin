.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %table
        = render @advertiser.contact,:partial=>"contact"
        %tr
          %td.label #{t("contact.konto")}:
          %td= @advertiser.konto
        %tr
          %td.label #{t("contact.iban")}:
          %td= @advertiser.iban
        %tr
          %td.label
            #{t("contact.blz")}:
          %td
            = @advertiser.blz
      .wat-cf
        = edit_button edit_advertiser_path(@advertiser),@advertiser
        = del_button(contact_path(@advertiser),@advertiser)

- content_for :sidebar, render(:partial => 'sidebar.show')

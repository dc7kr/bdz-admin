%h1 Neue #{t("booking.title")}

= form_for [@regional_organization,@booking], :url=>regional_organization_acct_bookings_path(@regional_organization) do |f|
  -if @booking.errors.any?
    #error_explanation
      %h2= "#{pluralize(@booking.errors.count, "error")} prohibited this booking from being saved:"
      %ul
        - @booking.errors.full_messages.each do |msg|
          %li= msg
  = render :partial => "form", :locals => {:f => f}
= link_to 'Back', regional_organization_acct_bookings_path(@regional_organization)


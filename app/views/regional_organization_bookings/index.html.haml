.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("regional_organization_booking.index")
      #{@regional_organization.name}
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %tr
            %th.first= attr_heading(RegionalOrganizationBooking,:booking_date)
            %th= attr_heading(RegionalOrganizationBooking,:booking_type) 
            %th= attr_heading(RegionalOrganizationBooking,:booking_year)
            %th= attr_heading(RegionalOrganizationBooking,:text)
            %th= attr_heading(RegionalOrganizationBooking,:amount)
            %th.last
        %tbody#regional_organization_bookings
          = render @bookings


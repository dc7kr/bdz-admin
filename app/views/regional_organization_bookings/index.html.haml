.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("regional_organization_booking.index")
      #{@regional_organization.name}
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %tr
            %th.first= t('booking.booking_date')
            %th= t('booking.booking_type') 
            %th= t('booking.booking_year')
            %th= t('booking.text')
            %th= t('booking.amount')
            %th.last
        %tbody#regional_organization_bookings
          = render @bookings


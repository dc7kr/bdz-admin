- if readable? regional_organization_booking
  %tr{:class => cycle("odd", "even"), :id=>"row#{regional_organization_booking.id}"}
    %td
      -if regional_organization_booking.booking_date != nil
        =l regional_organization_booking.booking_date.to_date, :format => :long
      -else
        NULL
    %td=t('regional_organization_booking.booking_type_'+regional_organization_booking.booking_type)

    %td=regional_organization_booking.booking_year
    %td=regional_organization_booking.booking_txt
    %td=format_currency(regional_organization_booking.amount,'€')
    %td
      =link_to_download_path(t('common.download'),download_regional_organization_booking_path(regional_organization_booking),regional_organization_booking)
      -if ( regional_organization_booking.booking_mode=='M' or isAdmin?) then
        = link_to_edit regional_organization_booking
        = link_to_delete regional_organization_booking



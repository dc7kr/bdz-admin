.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  .container-fluid
    =form_my_select(f,@booking, :booking_type, options_for_select([["Gutschrift", "G"], ["Sollstellung", "S"]],:selected=>@booking.booking_type))
    =form_my_field(f,@booking, :booking_year,:number)
    =form_my_field(f,@booking, :booking_date, :date)
    =form_my_field(f,@booking, :booking_txt)
    =form_my_field(f,@booking, :amount)
    .actions
      =submit_button
      =cancel_button  

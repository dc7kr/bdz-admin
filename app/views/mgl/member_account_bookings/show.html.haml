.container
  %h2= t("member_account_booking", count: 1)
  .card.mb-3
    .card-body
      = custom_entity_row(attr_heading(MemberAccountBooking, :booking_date), l(@booking.booking_date.to_date))
      = custom_entity_row(attr_heading(MemberAccountBooking, :booking_type), t("member_account_bookings.booking_types.#{@booking.booking_type}", default: @booking.booking_type))
      = entity_row(@booking, :booking_year)
      = entity_row(@booking, :booking_txt)
      = custom_entity_row(attr_heading(MemberAccountBooking, :amount), format_currency(@booking.amount, "€"))
  - if policy([ :mgl, @booking ]).download?
    = link_to t("common.download"), download_mgl_member_account_booking_path(@booking), class: "btn btn-primary", data: { turbo: false }
  = link_to t("common.back"), mgl_member_account_bookings_path, class: "btn btn-secondary"

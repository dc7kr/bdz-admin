.notice=notice
.card.card-primary.w-50.mb-3.mt-3.mx-auto.shadow
  .card-header.text-white.bg-primary= t("report_sheet_input.login_title")
  .card-body
    = bootstrap_form_tag url: submit_login_mgl_report_sheet_inputs_path do |f|
      =f.text_field :mglnr, value: mglnr, label: t("member.mglnr")
      =f.password_field :token, value: token, label: t("report_sheet_input.token")
      .mb-3
        =check_box_tag(:dsgvo,1,false)
        %b=t('report_sheet_input.dsgvo')

      .text-center=f.submit t('report_sheet_input.login'), class: "btn btn-primary"

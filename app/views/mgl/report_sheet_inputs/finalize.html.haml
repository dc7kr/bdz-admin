.block
  .content
    %h2.title Meldebogen #{@rs.year} - #{@report_sheet_input.orchestra.orchName} (#{@report_sheet_input.orchestra.mglnr}) 
    .inner
      = render :partial => "progress", :locals => { max: 100, value:90 }
      %p Bitte überprüfen Sie noch einmal Ihre Angaben.
      
      .panel.panel-default
        .panel-heading Kontaktadresse 
        .panel-body
          =entity_row(@report_sheet_input.orchestra,:orchName)
          =entity_row(@report_sheet_input.orchestra, :gruendung,:date)
        %tr
          %td.label_l=t('orchestra.contact')
          %td
            =t('common.salutation_d.'+@report_sheet_input.orchestra.anrede)
            =@report_sheet_input.orchestra.vorname
            =@report_sheet_input.orchestra.name
        %tr
          %td.label_l=t('member.street')
          %td=@report_sheet_input.orchestra.strasse
        %tr
          %td.label_l=t('member.zip')
          %td=@report_sheet_input.orchestra.plz
        %tr
          %td.label_l=t('member.city')
          %td=@report_sheet_input.orchestra.ort
        %tr
          %td.label_l=t('country.s')
          %td=translated_country(@report_sheet_input.orchestra.country_code)
      .panel.panel-default
        .panel-heading Ansprechpartner
        .panel-body
          -@roles.each do |r|
            - if @contacts[r] != nil then
              %b=t('orchestra_contact.role_'+r)
              %br
              #{@contacts[r].first_name} #{@contacts[r].last_name}
              %br
              =@contacts[r].street
              %br
              #{@contacts[r].zip} #{@contacts[r].city}
              %br
              =@contacts[r].phone
              %br
              =@contacts[r].email

      .panel.panel-default
        .panel-heading Beitragspflichtige Mitglieder
        .panel-body
          =entity_row(@rs,:children)
          =entity_row(@rs,:teens)
          =entity_row(@rs,:youth)
          =entity_row(@rs,:adult)
          =entity_row(@rs,:senior)
      
      .panel.panel-default
        .panel-heading 
          Mitglieder
        .panel-body
      %table
        -ReportSheet.age_categories.each do |cat|
          %tr
            %td.label=t('report_sheet.age_category.'+cat)
            %td=@counts[cat]

      .panel.panel-default
        .panel-heading Sonstige Mitglieder
        .panel-body
          %b 1. Mitglieder in Ausbildung
          =entity_row(@rs,:azubi_child)
          =entity_row(@rs,:azubi_teens)
          =entity_row(@rs,:azubi_youth)
          =entity_row(@rs,:azubi_adult)
          =entity_row(@rs,:azubi_senior)
          %b 2. Anzahl der passiven Mitglieder (nicht beitragspflichtig)
          =entity_row(@rs,:passive)
          =entity_row(@rs,:supporters)

      .panel.panel-default
        .panel-heading 
          Statistische Daten
        .panel-body
          %h4 Ensembles / Orchester im Verein
          = entity_row(@rs,:child_ens)
          = entity_row(@rs,:youth_ens)
          = entity_row(@rs,:adult_ens)
          = entity_row(@rs,:senior_ens)
          = entity_row(@rs,:other_ens)
          .row
            .col-sm-12.col-md-3.text-right=label :report_sheet,:instrumentation
            .col-sm-12.col-md-9=@orchestration.join(", ")

    .group.navform.wat-cf
      = back_button( url_for(:action=>:step4, :id=>@report_sheet_input))
      =wizard_forward_button("Verbindlich absenden", url_for(:action=>:confirm, :id=>@report_sheet_input))

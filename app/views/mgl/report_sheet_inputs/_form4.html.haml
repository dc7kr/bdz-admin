= form_for @report_sheet , :url=> url_for(:action=>:submit4,:id=>@report_sheet_input), :html => { :class => "form form-horizontal" } do |f|
  .panel.panel-default
    .panel-heading
      1. Mitglieder in Ausbildung
    .panel-body
      = form_my_field(f, @report_sheet,:azubi_child)
      = form_my_field(f, @report_sheet,:azubi_teens)
      = form_my_field(f, @report_sheet,:azubi_youth)
      = form_my_field(f, @report_sheet,:azubi_adult)
      = form_my_field(f, @report_sheet,:azubi_senior)
  .panel.panel-default
    .panel-heading
      2. Anzahl der passiven Mitglieder (nicht beitragspflichtig)
    .panel-body
      = form_my_field(f, @report_sheet,:passive)
      = form_my_field(f, @report_sheet,:supporters)

    .panel.panel-default
      .panel-heading
        3. Anzahl der Ensembles / Orchester im Verein
      .panel-body
        = form_my_field(f, @report_sheet,:child_ens)
        = form_my_field(f, @report_sheet,:youth_ens)
        = form_my_field(f, @report_sheet,:adult_ens)
        = form_my_field(f, @report_sheet,:senior_ens)
        = form_my_field(f, @report_sheet,:other_ens)

  .panel.panel-default
    .panel-heading 4. Instrumentierung
    .panel-body
      = form_my_field(f, @report_sheet,:zo,:checkbox)
      = form_my_field(f, @report_sheet,:zi_o,:checkbox)
      = form_my_field(f, @report_sheet,:go,:checkbox)
      = form_my_field(f, @report_sheet, :oz,:checkbox)
  
  = wizard_back_button( url_for(:action=>:step3, :id=>@report_sheet_input))
  = submit_button( t("common.save_and_continue"))
  

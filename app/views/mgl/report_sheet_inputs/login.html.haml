.notice=notice
.block
  .content
    %h2.title
      = t("report_sheet_input.login_title")
    .inner
      .container-fluid
        =form_tag({:controller => "report_sheet_inputs", :action => "submit_login", :method => "post"},{:class=>"form form-horizontal"}) do
          .row
            .col-md-2.col-sm-12=label(:member,:mglnr, :class=>"control-label col-md-2 col-sm-2")
            .col-md-6.col-sm-12=text_field_tag(:mglnr,@mglnr,:class=>"form-control")
          .row
            .col-md-2.col-sm-12
              =label(:report_sheet_input,:token, :class=>"control-label col-md-2 col-sm-2")
            .col-md-6.col-sm-12=password_field_tag(:token,@token,:class=>"form-control")
          .row
            .col-md-2
            .col-md-5.col-sm-12
              =submit_button(t('report_sheet_input.login'))

%h1 Listing report_sheet_inputs

%table
  %tr
    %th Report sheet
    %th Orchestra
    %th Token
    %th
    %th
    %th

  - @report_sheet_inputs.each do |report_sheet_input|
    %tr
      %td= report_sheet_input.report_sheet
      %td= report_sheet_input.orchestra
      %td= report_sheet_input.token
      %td= link_to 'Show', report_sheet_input
      %td= link_to 'Edit', edit_report_sheet_input_path(report_sheet_input)
      %td= link_to 'Destroy', report_sheet_input, method: :delete, data: { confirm: 'Are you sure?' }

%br

= link_to 'New Report sheet input', new_report_sheet_input_path

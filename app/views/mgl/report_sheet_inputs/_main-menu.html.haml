%nav.navbar.navbar-default
  .container-fluid
    .navbar-header
      -if not @report_sheet_input.nil? then
        =link_to t('report_sheet_input.login_title'), url_for( :action=>"step1" , :id=>@report_sheet_input ), :class=> "navbar-brand"
      -else
        .navbar-brand= t('report_sheet_input.login_title')
    %ul.nav.navbar-nav.navbar-left

= bootstrap_form_with(url: url_for(:action=> :upload, :id => @report_sheet_input), method: "post", multipart: true) do |f|
  .row
    .col-md-8
      .custom-file
        Datei auswählen
        = file_field_tag :datafile, :class => "custom-file-input"
        %label.custom-file-label#datafile-label{:for=>"datafile"} Datei wählen
    .col-md-4= submit_button("Hochladen")

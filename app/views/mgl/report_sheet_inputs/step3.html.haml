.block
  .content
    %h2.title
      = t("report_sheet_input.page_3", :year => @report_sheet_input.report_sheet.year.to_s)
    .inner
      = render :partial => "progress", :locals => { max: 100, value:40}
      = render 'form3'

      = wizard_back_button(url_for(:action =>:step2,:id=>@report_sheet_input))
      - if (@members != nil and @members.count > 0)

        = wizard_del_button( url_for(:action=>:delete_members,:id=> @report_sheet_input), t('orchestra_member.delete_all'),@members[0]);
      - if (@members != nil and @members.count > 0 and @faultyMembers == 0 ) or @orchestra.is_coop?
        = wizard_forward_button(t('common.save_and_continue'),url_for(:action=>:step4,:id=> @report_sheet_input))
      -if @members != nil and @members.count >0
        %h3=t('report_sheet_input.current_members')
        %table.border
          %tr
            %th=t('orchestra_member.first_name')
            %th=t('orchestra_member.last_name')
            %th=t('orchestra_member.year_of_birth')
            - if @orchestra.is_lorch? then
              %th=t('member.mglnr')
            %th=t('orchestra_member.instrument')
            %th=t('report_sheet.children_col')
            %th=t('report_sheet.teens_col')
            %th=t('report_sheet.youth_col')
            %th=t('report_sheet.adult_col')
            %th=t('report_sheet.senior_col')

          - @members.each do |m|
            %tr
              %td=m.first_name
              %td=m.last_name
              %td{ :class => birthyear_class(m)}=m.year_of_birth
              - if @orchestra.is_lorch? then
                %td=m.mglnr.to_s
              %td=m.instrument
              - ageCategory = memberToAgeCategory(m.date_of_birth,@year)
              %td.check=ageCategory[0]
              %td.check=ageCategory[1]
              %td.check=ageCategory[2]
              %td.check=ageCategory[3]
              %td.check=ageCategory[4]
    



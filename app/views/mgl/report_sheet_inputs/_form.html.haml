= form_for @report_sheet_input, :url => url_for(:action => :submit1, :id=> @report_sheet_input) do |f|
  = f.fields_for @report_sheet_input.report_sheet do |rs|
    =form_my_field(rs,@report_sheet_input,:uv,:checkbox) 
  = f.fields_for @report_sheet_input.orchestra do |orch|
    = render partial: "form_errors", locals: { entity: @report_sheet_input.orchestra }
    = form_my_field(orch,@report_sheet_input.orchestra, :orchName)
    = form_my_field(orch,@report_sheet_input.orchestra, :gruendung,:date)
    = form_my_select(orch,@report_sheet_input.orchestra, :anrede, get_salutation_options(@report_sheet_input.orchestra.anrede))
    = form_my_field(orch,@report_sheet_input.orchestra, :vorname)
    = form_my_field(orch,@report_sheet_input.orchestra, :name)
    = form_my_field(orch,@report_sheet_input.orchestra, :strasse)
    = form_my_field(orch,@report_sheet_input.orchestra, :plz)
    = form_my_field(orch,@report_sheet_input.orchestra, :ort)
    = form_my_field(orch,@report_sheet_input.orchestra, :telefon)
    = form_my_field(orch,@report_sheet_input.orchestra, :fax)
    = form_my_field(orch,@report_sheet_input.orchestra, :email)
    - if ( @report_sheet_input.orchestra.za == 'R' ) then 
      =form_my_select(orch,@report_sheet_input.orchestra, :za, options_for_select([["Lastschrift", "L"], ["Rechnung", "R"]],:selected=>@report_sheet_input.orchestra.za)) 
    = form_my_field(orch,@report_sheet_input.orchestra, :iban)
    = form_my_field(orch,@report_sheet_input.orchestra, :bic)

    = submit_button(t("common.save_and_continue"))
  

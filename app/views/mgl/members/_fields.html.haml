-# contact and payment fields of the member record, see Mgl::MemberParams
= bootstrap_fields_for :member, member, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10" do |mf|
  .card.mb-3
    .card-header= t("mgl.member.contact")
    .card-body
      = mf.select :anrede, get_salutation_options(member.anrede), label: t("member.salutation")
      = mf.text_field :title, label: t("mgl.member.title")
      = mf.text_field :vorname
      = mf.text_field :name
      = mf.text_field :strasse
      = mf.text_field :plz
      = mf.text_field :ort
      = mf.country_select :country_code, { iso_codes: true, label: t("member.country_code") }, { class: "form-select" }
      = mf.email_field :email
      = mf.phone_field :telefon, label: t("member.phone")
      = mf.phone_field :fax

  .card.mb-3
    .card-header= t("mgl.member.payment")
    .card-body
      - if member.za == "R"
        = mf.select :za, options_for_select([ [ t("common.za_L"), "L" ], [ t("common.za_R"), "R" ] ], member.za), label: t("member.za")
      - else
        = mf.static_control :za, value: t("common.za_#{member.za}", default: member.za.to_s), label: t("member.za")
      = mf.text_field :iban
      = mf.text_field :bic
      = mf.text_field :zahler

.block
  .secondary-navigation
    =render :partial=>'links'
  .content
    %h2.title=t('users.profile.title')

    = form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put }) do |f| 
      = devise_error_messages! 

      %div
        = t('users.profile.email')
        %br 
      = f.email_field :email 

      %div
        = t('users.profile.auth_token')
        %br
        = f.text_field :authentication_token, :readonly=>true

      %div
        = t('users.profile.new_password')
        %i=t('users.profile.password_blank_hint')
        %br
        = f.password_field :password, :autocomplete => "off" 

      %div
        = t('users.profile.new_password_confirm')
        %br 
        = f.password_field :password_confirmation

      %div
        = t('users.profile.current_password')
        %i=t('users.profile.current_password_hint')
        %br
        = f.password_field :current_password 
      = f.submit "Update"


    %h3=t('users.profile.cancel_account')
    %p
      = link_to t('users.profile.cancel_account'), registration_path(resource_name), :confirm => "Wirklich löschen?", :method => :delete 
    
    = link_to "Back", :back 

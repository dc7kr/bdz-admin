.block
  .secondary-navigation
    =render :partial=>'links'
  .content
    %h2.title
      =t("devise.forgot_pw")
    = form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post }) do |f| 
      = devise_error_messages! 

      %div
        = t("devise.email")
        %br
      = f.email_field :email 
    
      %div= f.submit t("devise.send_reset_instructions")
 

.card.card-primary.mb-3.mt-3.mx-auto.shadow.w-50
  .card-header.text-white.bg-primary=t(".forgot_your_password")
  .card-body
    = bootstrap_form_for(resource, as: resource_name, url: password_path(resource_name))  do |f|
      = devise_error_messages!
      = f.email_field :email, autofocus: true
      .d-grid.gap-2.mx-auto
        = f.submit t(".send_me_reset_password_instructions")
    .mt-5= render "devise/shared/links"

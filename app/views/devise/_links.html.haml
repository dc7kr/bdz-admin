%ul.nav.nav-pills
  - if controller_name != 'sessions' 
    %li{ :role => "presentation" }= link_to t("devise.sign_in"), new_session_path(resource_name) 

  - if devise_mapping.registerable? && controller_name != 'registrations' 
    %li{ :role => 'presentation'}= link_to t("devise.sign_up"), new_registration_path(resource_name) 

  - if devise_mapping.recoverable? && controller_name != 'passwords' 
    %li{ :role => "presentation"}= link_to t("devise.forgot_pw"), new_password_path(resource_name) 

  - if devise_mapping.confirmable? && controller_name != 'confirmations' 
    %li{ :role => "presentation" }=link_to t("devise.didnt_receive_confirm"), new_confirmation_path(resource_name) 

  - if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' 
    %li{ :role => "presentation" }=link_to t("devise.didnt_receive_unlock"), new_unlock_path(resource_name) 

  - if devise_mapping.omniauthable? 
    - resource_class.omniauth_providers.each do |provider| 
      %li{ :role => "presentation" }=link_to "Sign in with #{provider.to_s.titleize}", omniauth_authorize_path(resource_name, provider) 

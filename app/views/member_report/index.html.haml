.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("member_report.title")
    .inner
      %table.table
        %thead
          %th.first= t("report_sheet.year")
          %th= t("member_report.orchestra_count")
          %th= t("report_sheet.children")
          %th= t("report_sheet.teens")
          %th= t("report_sheet.youth")
          %th= t("report_sheet.adult")
          %th= t("report_sheet.senior")
          %th= t("report_sheet.azubi")
          %th= t("report_sheet.passive")
          %th= t("member_report.active_sum")
          %th.last= t("member_report.member_sum")
        %tbody
          - @sums.each do |sum|
            %tr
              %td=sum.year
              %td=format_int sum.anzahl
              %td=format_int sum.sum_children
              %td=format_int sum.sum_teens
              %td=format_int sum.sum_youth
              %td=format_int sum.sum_adult
              %td=format_int sum.sum_senior
              %td=format_int sum.sum_azubi
              %td=format_int sum.sum_passive
              - sum_active = sum.sum_children+sum.sum_teens+sum.sum_youth+sum.sum_adult+sum.sum_senior+sum.sum_azubi
              %td= format_int sum_active
              %td= format_int (sum_active+sum.sum_passive)

      %table.table
        %thead
          %th.first= t("report_sheet.year")
          %th= t("member_report.person_member_count")
          %th= t("member_report.orchestra_count")
          %th= t("member_report.orch_count")
          %th= t("member_report.koop_count")
          %th= t("member_report.lo_count")
          %th= t("member_report.lo_only")
          %th= t("member_report.lo_all")
        %tbody
          - @l_orch_no_pay.each do |lv|
            %tr
              %td=lv[0]
              - if (lv[0] == Time.now.year) then
                %td #{format_int @em_count} (#{@em_nomail})
                %td #{format_int @orch_counts["O"]+@orch_counts["K"]+@orch_counts["L"]} (#{@o_nomail})
                %td=format_int @orch_counts["O"]
                %td=format_int @orch_counts["K"]
                %td=format_int @orch_counts["L"]
              -else
                %td -
                %td -
                %td -
                %td -
                %td -
              %td=format_int lv[1]
              %td=format_int @lorch[lv[0]]

      .actions-bar.wat-cf
        .actions

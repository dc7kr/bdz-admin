= form_for @url do |f|
  -if @url.errors.any?
    #error_explanation
      %h2= "#{pluralize(@url.errors.count, "error")} prohibited this url from being saved:"
      %ul
        - @url.errors.full_messages.each do |msg|
          %li= msg

  .field
    = f.label :category
    = f.text_field :category
  .field
    = f.label :url
    = f.text_field :url
  .field
    = f.label :titel
    = f.text_field :titel
  .field
    = f.label :descr
    = f.text_field :descr
  .field
    = f.label :sprache
    = f.text_field :sprache
  .field
    = f.label :country
    = country_select(:url, :country_code, nil, :iso_codes=>true)
  .field
    = f.label :bland, corika_tr("url","state","STATE")
    = collection_select(:url, :bland, State.all, :id, :name) 
  .field
    = f.label :email
    = f.text_field :email
  .field
    = f.label :lastchange
    = f.text_field :lastchange
  .field
    = f.label :confirmed
    = f.text_field :confirmed
  .field
    = f.label :ip
    = f.text_field :ip
  .actions
    = f.submit 'Save'
    = cancel_button()

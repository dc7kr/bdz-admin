.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      URLs
    .inner
      .container-fluid
        .row
          .col-sm-3=label :url,:url_category
          = @url.url_category
        .row
          .col-sm-3=label :url,:url
          = @url.url
        .row
          .col-sm-3=label :url,:title
          = @url.titel
        .row
          .col-sm-3=label :url,:descr
          = @url.descr
        .row
          .col-sm-3=label :url,:sprache
          = @url.sprache
        .row
          .col-sm-3=label :url,:country_code
          = @url.country_code
        .row
          .col-sm-3=label :url,:state
          = @url.state
        .row
          .col-sm-3=label :url,:email
          = @url.email
        .row
          .col-sm-3=label :url,:lastchange
          = @url.lastchange
        .row
          .col-sm-3=label :url,:confirmed
          = @url.confirmed
        .row
          .col-sm-3=label :url,:ip
          = @url.ip


.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      URLs
    .inner
      %table.table-sm
        %thead
          %th.first= t('urls.category')
          %th=sortable 'url', t('urls.url')
          %th=t('urls.title')
          %th=t('urls.language')
          %th=t('urls.email')
          %th=t('urls.lastchange')
          %th.last &nbsp;

        %tbody#urls
          =render @urls
      #paginator
        = paginate @urls
      .actions-bar.wat-cf
        .actions


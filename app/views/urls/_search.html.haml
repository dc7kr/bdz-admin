.block
  %h3=t("common.search")
  %ul.navigation
    %li
      %p=t("common.search")
      %p
        = form_tag urls_path, :method => 'get' do
          = hidden_field_tag :direction, params[:direction]
          = hidden_field_tag :sort, params[:sort]
          = text_field_tag :search, params[:search]
          = submit_tag t("common.search"), :name => nil


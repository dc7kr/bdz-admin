.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      URLs
    .inner
      %table.table-sm.table-hover.table-condensed
        %thead
          %th.first= attr_heading(Url,:category)
          %th=sortable 'url', attr_heading(Url,:url)
          %th=attr_heading(Url,:title)
          %th=attr_heading(Url,:language)
          %th=attr_heading(Url,:email)
          %th=attr_heading(Url,:lastchange)
          %th.last &nbsp;

        %tbody#urls
          =render @urls
      #paginator
        = paginate @urls, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

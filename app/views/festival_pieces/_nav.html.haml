%ul.nav.nav-tabs
  - if @festival_application then
    %li=link_to_up_path t("common.up"), festival_application_path(@festival_application)
    = nav_to_list FestivalApplication, festival_application_festival_pieces_path(@festival_application)
    = nav_to_new FestivalPiece, new_festival_application_festival_piece_path(@festival_application)
  - else 
    %li{ :class => 'first'}= link_to_up_path t("common.up"), home_landing_page_path
  -if (@festival_piece and @festival_piece[:id] != nil)
    = nav_to_show @festival_piece, festival_application_festival_piece_path(@festival_application,@festival_piece)
    = nav_to_edit @festival_piece, edit_festival_application_festival_piece_path(@festival_application,@festival_piece)


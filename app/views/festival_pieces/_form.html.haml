= bootstrap_form_for([@festival_application,@festival_piece], layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  .container-fluid
    =f.text_field :title
    =f.text_field :composer
    =f.text_field :arranger
    =f.text_field :publisher
    =f.time_field :duration

    %h4=t("festival_piece.additional_info")
    =f.text_field :soloist
    =f.check_box :premiere
    =f.check_box :outdoor
    .actions
      =submit_button
      =cancel_button

.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t('festival_piece',:count=>3)


  .container-fluid
    %ul.nav.nav-tabs#piece_tab
      %li.nav-item{:role => "presentation"}
        %button#all-tab.nav-link.active{"aria-controls" => "all-tab-pane", "aria-selected" => "true", "data-bs-target" => "#all-tab-pane", "data-bs-toggle" => "tab", :role => "tab", :type => "button"}=t("common.all")
      - if @premieres.present?
        %li.nav-item{:role => "presentation"}
          %button#premiere-tab.nav-link{"aria-controls" => "premiere-tab-pane", "aria-selected" => "true", "data-bs-target" => "#premiere-tab-pane", "data-bs-toggle" => "tab", :role => "tab", :type => "button"}=t("festival_piece.premiere")
  
    #piece_tab_content.tab-content
      #all-tab-pane.tab-pane.fade.show.active{ role: "tabpanel", 'aria-labelledby': "all-tab", 'tabindex': 0 }
        %table.table.table-sm.table-hover
          %thead
            %th= attr_heading(FestivalPiece, :title)
            %th.first= attr_heading(FestivalPiece, :composer)
            %th.first= attr_heading(FestivalPiece, :arranger)
            %th.first= attr_heading(FestivalPiece, :publisher)
            %th= attr_heading(FestivalPiece, :duration)
            %th.last &nbsp;
          %tbody#festvial_pieces
            =render @festival_pieces
      #premiere-tab-pane.tab-pane.fade{ role: "tabpanel", 'aria-labelledby': "premiere-tab", 'tabindex': 0 }
        %table.table-sm.table-hover.table-condensed
          %thead
            %th= attr_heading(FestivalPiece, :title)
            %th.first= attr_heading(FestivalPiece, :composer)
            %th.first= attr_heading(FestivalPiece, :arranger)
            %th.first= attr_heading(FestivalPiece, :publisher)
            %th= attr_heading(FestivalPiece, :duration)
            %th.last &nbsp;
          %tbody#festvial_pieces_premiere
            - if @premieres.present?
              - @premieres.each do |piece|
                =render piece

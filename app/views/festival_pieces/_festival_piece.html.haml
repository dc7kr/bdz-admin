%tr.festival_piece{:id => dom_id(festival_piece) }
  %td= festival_piece.composer
  %td= festival_piece.title
  %td= festival_piece.duration
  %td
    = link_to_show_path festival_application_festival_piece_path(festival_piece.festival_application_id,festival_piece),t('common.show'), festival_piece
    = link_to_edit_path edit_festival_application_festival_piece_path(festival_piece.festival_application_id, festival_piece),t('common.edit'), festival_piece
    = link_to_del_path festival_application_festival_piece_path(festival_piece.festival_application_id,festival_piece),  festival_piece

%tr.festival_piece{:id => dom_id(festival_piece) }
  %td= festival_piece.title
  %td= festival_piece.composer
  %td= festival_piece.arranger
  %td= festival_piece.publisher
  %td= render_duration(festival_piece.duration)
  %td
    - f_appl = festival_piece.festival_application
    - if not f_appl.nil?
      = link_to_show festival_piece, festival_application_festival_piece_path(f_appl.token,festival_piece)
      = link_to_edit festival_piece, edit_festival_application_festival_piece_path(f_appl.token, festival_piece)
      = link_to_delete festival_piece, festival_application_festival_piece_path(f_appl.token,festival_piece)

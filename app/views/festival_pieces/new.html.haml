.block
  .secondary-navigation
    = render :partial =>'nav'
  .content
    %h2.title
      = t("common.new")
      = t("festival_piece.title")
    .inner
      = form_for :festival_piece, :url => festival_application_festival_pieces_path(@festival_application), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')




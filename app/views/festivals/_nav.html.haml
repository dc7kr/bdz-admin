%ul.wat-cf
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_member_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list", :default => "List")}", festivals_path
  -if (@festival)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), '#'
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_festival_path


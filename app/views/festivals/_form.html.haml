= form_for @festival do |f|
  -if @festival.errors.any?
    #error_explanation
      %h2= "#{pluralize(@festival.errors.count, "error")} prohibited this festival from being saved:"
      %ul
        - @festival.errors.full_messages.each do |msg|
          %li= msg

  .field
    = f.label :startdate
    = f.text_field :startdate
  .field
    = f.label :bland
    = f.text_field :bland
  .field
    = f.label :name
    = f.text_field :name
  .field
    = f.label :description
    = f.text_field :description
  .field
    = f.label :anmeldung
    = f.text_field :anmeldung
  .field
    = f.label :gebuehren
    = f.text_field :gebuehren
  .field
    = f.label :stadt
    = f.text_field :stadt
  .field
    = f.label :homepage
    = f.text_field :homepage
  .field
    = f.label :ort
    = f.text_field :ort
  .field
    = f.label :ortdetails
    = f.text_field :ortdetails
  .field
    = f.label :visible
    = f.text_field :visible
  .actions
    = f.submit 'Save'
    = cancel_button()

= bootstrap_form_for(@festival, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  .container-fluid
    =f.date_field :startdate
    =f.text_field :bland
    =f.text_field :name
    =f.text_field :description
    =f.text_field :anmeldung
    =f.text_field :gebuehren
    =f.text_field :stadt
    =f.url_field :homepage
    =f.text_field :ort
    =f.text_field :ortdetails
    =f.check_box :visible
    .actions
      = f.submit 'Save'
      = cancel_button()

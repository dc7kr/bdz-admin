= form_for @festival,:html => { :class => "form-horizontal"} do |f|
  -if @festival.errors.any?
    #error_explanation
      %h2= "#{pluralize(@festival.errors.count, "error")} prohibited this festival from being saved:"
      %ul
        - @festival.errors.full_messages.each do |msg|
          %li= msg
  .container-fluid
    =form_my_field(f,@festival, :startdate)
    =form_my_field(f,@festival, :bland)
    =form_my_field(f,@festival, :name)
    =form_my_field(f,@festival, :description)
    =form_my_field(f,@festival, :anmeldung)
    =form_my_field(f,@festival, :gebuehren)
    =form_my_field(f,@festival, :stadt)
    =form_my_field(f,@festival, :homepage)
    =form_my_field(f,@festival, :ort)
    =form_my_field(f,@festival, :ortdetails)
    =form_my_field(f,@festival, :visible,:checkbox)
    .actions
      = f.submit 'Save'
      = cancel_button()

.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("festival",:count=>3)
    .inner
      #entry_info
        = page_entries_info @festivals
      %table.table.table-hover.table-condensed
        %thead
          %th.first= sortable "startdate", t("festival.startdate")
          %th= sortable "name", t("festival.name")
          %th= sortable "homepage", t("festival.homepage")
          %th.last &nbsp;
        %tbody#festivals
          =render @festivals
      #paginator
        = paginate @festivals, :remote=>true
      .actions-bar.wat-cf
        .actions
%h1 Listing festivals

%table
  %tr
    %th Startdate
    %th Bland
    %th Name
    %th Description
    %th Anmeldung
    %th Gebuehren
    %th Stadt
    %th Homepage
    %th Ort
    %th Ortdetails
    %th Visible
    %th
    %th
    %th

  = render @festivals
%br


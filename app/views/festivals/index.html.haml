.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      Orchester
    .inner
      #entry_info
        = page_entries_info @festivals
      %table.table
        %thead
          %th.first= sortable "mglnr", t("festival.mglnr")
          %th= sortable "orchName", t("festival.orchName")
          %th= sortable "email", t("member.email")
          %th.last &nbsp;
        %tbody#festivals
          =render @festivals
      #paginator
        = paginate @festivals, :remote=>true
      .actions-bar.wat-cf
        .actions
%h1 Listing festivals

%table
  %tr
    %th Startdate
    %th Bland
    %th Name
    %th Description
    %th Anmeldung
    %th Gebuehren
    %th Stadt
    %th Homepage
    %th Ort
    %th Ortdetails
    %th Visible
    %th
    %th
    %th

  = render @festivals
%br


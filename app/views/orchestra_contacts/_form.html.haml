= bootstrap_form_for([@orchestra,@orchestra_contact], layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  =f.select :role, t_opts("orchestra_contact","role", OrchestraContact.roles)
  =f.select :salutation, [["Herr", "M"], ["Frau", "W"]]
  =f.text_field :first_name
  =f.text_field :last_name
  =f.text_field :street
  =f.text_field :zip
  =f.text_field :city
  .row
    .col-md-2=label :member,:country
    .col-md-10= f.country_select(:country_code, { iso_codes:true }, { class:  "form-select"})
  =f.text_field :email
  =f.text_field :phone

  = submit_button
  = cancel_button


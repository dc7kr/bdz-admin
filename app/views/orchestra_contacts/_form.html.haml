.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %table
    %tr
    =form_my_select(f,@orchestra_contact, :role, options_for_select(t_opts("orchestra_contact","role", ["V", "S", "G", "D", "J", "O"]), :selected=>@orchestra_contact.role) )
    =form_my_select(f,@orchestra_contact, :salutation, options_for_select([["Herr", "M"], ["Frau", "W"]],:selected=>@orchestra_contact.salutation) )
    =form_my_field(f,@orchestra_contact, :first_name)
    =form_my_field(f,@orchestra_contact, :last_name)
    =form_my_field(f,@orchestra_contact, :street)
    =form_my_field(f,@orchestra_contact, :zip)
    =form_my_field(f,@orchestra_contact, :city)
    =form_wrapped_field(f,@orchestra_contact, :country, country_select(:orchestra_contact, :country_code, {iso_codes:true },{:class => "form-control"}))
    =form_my_field(f,@orchestra_contact, :email)
    =form_my_field(f,@orchestra_contact, :phone)
  
  .actions
    =submit_button
    = cancel_button

.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", countries_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_country_path
      %li.active= link_to "#{t("web-app-theme.show", :default => "Show")}", country_path
  .content
    .inner
      %p
        %b
          = t("activerecord.attributes.country.name", :default => t("activerecord.labels.name", :default => "Name"))
          \:
        = @country.name
      %p
        %b
          = t("activerecord.attributes.country.ccode", :default => t("activerecord.labels.ccode", :default => "Ccode"))
          \:
        = @country.ccode
      .wat-cf
        = link_to image_tag("web-app-theme/icons/application_edit.png", :alt => "#{t("web-app-theme.edit", :default=> "Edit")}") + " " + t("web-app-theme.edit", :default=> "Edit"), edit_country_path(@country), :class => "button"
        = link_to image_tag("web-app-theme/icons/cross.png", :alt => "#{t("web-app-theme.delete", :default=> "Delete")}") + " " + t("web-app-theme.delete", :default => "Delete"), country_path(@country), :method => "delete", :class => "button", :confirm => "#{t("web-app-theme.confirm", :default => "Are you sure?")}"

      %table.table
        %tr
          %th.first ID
          %th=t('state.name')
          %th.last 
        = render :partial => 'country_state', :collection => @country.states

- content_for :sidebar, render(:partial => 'sidebar')

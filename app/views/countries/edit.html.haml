.block
  .secondary-navigation
    %ul.wat-cf
      %li.first= link_to "#{t("web-app-theme.list", :default => "List")}", countries_path
      %li= link_to "#{t("web-app-theme.new", :default => "New")}", new_country_path
      %li.active= link_to "#{t("web-app-theme.edit", :default => "Edit")}", edit_country_path
  .content
    %h2.title
      = t("web-app-theme.edit", :default => "Edit")
      Country
    .inner
      = form_for @country, :url => country_path(@country), :html => { :class => :form }, :remote =>true do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

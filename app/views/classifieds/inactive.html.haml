.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("classified",:count=>3)
    .inner
      %table.table-sm
        %thead
        %tbody#classifieds
          = render @classifieds
      #paginator
        = paginate @classifieds, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')


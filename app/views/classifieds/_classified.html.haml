%tr
  %td= classified.adv_type
  %td= classified.object
  %td= classified.name
  %td=l classified.validuntil
  %td
    - if not classified.visible then
      = link_to_publish classified,  t("common.publish")
    = link_to_show classified, t('common.show')
    = link_to_edit classified, t('common.edit')
    = link_to_delete classified, t('common.delete'),t('common.delete_confirm')




.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("classified.p")
    .inner
      %table.table
        %thead
          %th.first= t("classified.adv_type")
          %th= t("classified.object")
          %th= t("classified.name")
          %th= t("classified.validuntil")
          %th.last &nbsp;
        %tbody#classifieds
          = render @classifieds
      #paginator
        = paginate @classifieds, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')


= bootstrap_form_for(@classified, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  .container-fluid
    =f.text_field :object
    =f.text_area :description, cols: 80, rows: 5
    =f.date_field :validuntil
    =f.check_box :visible 
  .actions
    = f.submit t("common.save")
    = cancel_button()

.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %h2 Quizfragen
  %table
    %tr
      %td=f.label :response1
      %td=f.text_field :response1
    %tr
      %td=f.label :response2
      %td=f.text_field :response2
    %tr
      %td=f.label :response3
      %td=f.text_field :response3
    %tr
      %td=f.label :response4
      %td=f.text_field :response4

  %h2 Persönliche Daten
  
  %table
    %tr
      %td=f.label :first_name
      %td=f.text_field :first_name
    %tr
      %td=f.label :last_name
      %td=f.text_field :last_name
    %tr
      %td=f.label :street
      %td=f.text_field :street
    %tr
      %td=f.label :zip
      %td=f.text_field :zip
    %tr
      %td=f.label :city
      %td=f.text_field :city
    %tr
      %td=f.label :country_code
      %td=f.text_field :country_code
    %tr
      %td=f.label :date_of_birth
      %td=f.text_field :date_of_birth

    %tr
      %td=f.label :email
      %td=f.text_field :email
    %tr
      %td=f.label :winner
      %td=f.check_box :winner


  %h2=t("competition_entry.feedback.title")
  %h3=t("competition_entry.feedback.hint")

  %table
    %tr
      %td=t('competition_entry.feedback.like')
      %td=f.text_area :like
    %tr
      %td=t('competition_entry.feedback.missing')
      %td=f.text_area :missing
    %tr
      %td=t('competition_entry.feedback.improve')
      %td=f.text_area :improve

  =f.submit
    


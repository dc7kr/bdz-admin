.block
  = f.error_messages :message => "", :header_tag => :h3
.group
  %h2 Quizfragen
  .container-fluid
    =form_my_field(f, @competition_entry, :response1)
    =form_my_field(f, @competition_entry, :response2)
    =form_my_field(f, @competition_entry, :response3)
    =form_my_field(f, @competition_entry, :response4)

  %h2 Persönliche Daten
  .container-fluid
    =form_my_field(f, @competition_entry, :first_name)
    =form_my_field(f, @competition_entry, :last_name)
    =form_my_field(f, @competition_entry, :street)
    =form_my_field(f, @competition_entry, :zip)
    =form_my_field(f, @competition_entry, :city)
    =form_my_field(f, @competition_entry, :country_code)
    =form_my_field(f, @competition_entry, :date_of_birth,:date)
    =form_my_field(f, @competition_entry, :email,:email)

    %tr
      %td=f.label :winner
      %td=f.check_box :winner


  %h2=t("competition_entry.feedback.title")
  %h3=t("competition_entry.feedback.hint")

  %table
    %tr
      %td=t('competition_entry.feedback.like')
      %td=f.text_area :like
    %tr
      %td=t('competition_entry.feedback.missing')
      %td=f.text_area :missing
    %tr
      %td=t('competition_entry.feedback.improve')
      %td=f.text_area :improve

  =f.submit
    


%table
  %tr
    %td= f.label :advertiser, t("advertiser.s"), :class => :label
    %td= f.collection_select(:advertiser_id, Advertiser.all, :adv_id, :company) 
  %tr
    %td= f.label :magazine_issue, t("magazine_issue.s"), :class => :label
    %td= f.collection_select(:magazine_issue_id, MagazineIssue.all, :id, :full_number) 
  %tr
    %td= f.label :advert_type, t("magazine_advert.advert_type"), :class => :label
    %td= f.select :advert_type, options_for_select([[t('magazine_advert.advert_types.F'),"F"],[t('magazine_advert.advert_types.H'), "H"],[t('magazine_advert.advert_types.T'),"T"],[t('magazine_advert.advert_types.Q'), "Q"]],:selected=>@magazine_advert.advert_type)


.group.navform.wat-cf
  %button.button{:type => "submit"}
    = image_tag("web-app-theme/icons/tick.png", :alt => "#{t("web-app-theme.save", :default => "Save")}")
    = t("web-app-theme.save", :default => "Save")
  %span.text_button_padding= t("web-app-theme.or", :default => "or")
  = cancel_button()

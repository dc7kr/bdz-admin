.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    %h2.title
      =t("magazine_advert.s")
    .inner
      %table
        %tr
          %td.label=t("magazine_issue.s")
          %td= @magazine_advert.magazine_issue.full_number
        %tr
          %td.label=t("advertiser.s")
          %td
            = @magazine_advert.advertiser.company
            = t('advertiser.customer_nr')+" "+ @magazine_advert.advertiser.customer_id
        %tr
          %td.label=t("magazine_advert.advert_type")
          %td=t("magazine_advert.advert_types."+@magazine_advert.advert_type)


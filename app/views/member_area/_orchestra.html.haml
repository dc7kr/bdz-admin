.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %table
        %tr
          %td.label
            &nbsp;
          %td #{@orchestra.mglnr} (#{t("orchestra.type_"+@orchestra.orch_type)})
        %tr
          %td.label #{t("orchestra.orchName")}:
          %td= @orchestra.orchName
        = render @orchestra.member,:partial=>"member"
        %tr
          %td.label #{t("common.address")}:
          %td #{@orchestra.fullname}
        %tr
          %td.label #{t("orchestra.gruendung")}:
          %td= format_date(@orchestra.gruendung)
        %tr
          %td.label #{t("orchestra.bemerkung")}:
          %td= @orchestra.bemerkung
        %tr
          %td.label #{t("orchestra.url")}:
          %td=link_to @orchestra.url, sanitize_url(@orchestra.url)
        %tr
          %td.label #{t("member.kuendigungErfasst")}:
          %td!= format_bool(@orchestra.kuendigungErfasst)
        
    .wat-cf
      = edit_button(edit_orchestra_path(@orchestra),@orchestra)
      = del_button( orchestra_path(@orchestra),@orchestra)
    //= render 'report_sheets/fororchestra' unless @report_sheets.count ==0

- content_for :sidebar, render(:partial => 'sidebar.show')

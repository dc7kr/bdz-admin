.card
  .card-header.bg-primary.text-white Mitgliedertabelle hochladen
  .card-body
    %ul.navigation
      %li
        %p
          = bootstrap_form_tag url: upload_orchestra_orchestra_members_path(@orchestra), method: 'post', :multipart=>true do |f|
            = f.file_field :datafile, hide_label: true
            = f.submit "Hochladen"

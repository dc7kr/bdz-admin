.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("orchestra_member",:count=>3)
    .inner

      %table.table-sm
        %thead
          %th.first= sortable "first_name", t("orchestra_member.first_name")
          %th= sortable "last_name", t("orchestra_member.last_name")
          %th=t("orchestra_member.date_of_birth")
          %th= t("orchestra.orch_name")
          %th= t("member.mglnr")
          %th.last &nbsp;
        %tbody#orchestra_members
          - @orchestra_members.each do |om|
            %tr
              %td=om.first_name
              %td=om.last_name
              %td=om.year_of_birth
              - if om.orchestra.nil? then
                %td NIL
                %td NIL
              - else
                %td=om.orchestra.orchName 
                %td=om.orchestra.member.mglnr
      .actions-bar.wat-cf
        .actions


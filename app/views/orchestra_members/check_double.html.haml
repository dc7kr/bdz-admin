.content
  .inner
    %h2.title 
      Doppelmitgliedschaftscheck
      - if @needs_update then 
        %span.label.label-danger=t("report_sheet.update_needed")
      - else
        %span.label.label-info=t("report_sheet.no_update_needed")
    - if @result[:faulty].count > 0 then
      %h3
        %span.label.label-danger Fehlerhaft:
      %table.table.table-collapsed
        = render @result[:faulty]
    - if @result[:verified].count > 0 then 
      %h3 
        %span.label.label-success Erfolgreich geprüft:
      %table.table.table-collapsed
        = render @result[:verified]
    - if @result[:neutral].count > 0 then 
      %h3 
        %span.label.label-warning Ignoriert:
      %table.table.table-collapsed
        = render @result[:neutral]
    - if @needs_update  then
      = wizard_img_button(update_double_members_orchestra_report_sheet_path(@orchestra,@current_report_sheet,:dm=>@result[:verified].count), t('report_sheet.update_double_members'), "/assets/icons/check.png")

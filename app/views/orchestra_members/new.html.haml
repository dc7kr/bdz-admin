.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      = t('common.new')
      = t('orchestra_member.title')
    .inner
      = form_for @orchestra_member, :url => orchestra_orchestra_members_path(@orchestra), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}


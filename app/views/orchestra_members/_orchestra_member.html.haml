-if readable?(orchestra_member) 
  %tr{:class => cycle("odd", "even")}
    %td= orchestra_member.first_name
    %td= orchestra_member.last_name
    - if ( orchestra_member.is_dummy_birthday?) then
      %td.invalid
        = format_date orchestra_member.date_of_birth
    - else 
      %td= format_date orchestra_member.date_of_birth
    - if @orchestra.is_lorch?
      %td= link_to orchestra_member.mglnr.to_s, orchestras_path+"?search="+orchestra_member.mglnr.to_s
    %td= orchestra_member.instrument
    %td
      = link_to_show_path orchestra_orchestra_member_path(orchestra_member.orchestra,orchestra_member), t('common.show') , orchestra_member
      = link_to_edit_path  edit_orchestra_orchestra_member_path(orchestra_member.orchestra,orchestra_member),'Edit',orchestra_member
      = link_to_del_path orchestra_orchestra_member_path(orchestra_member.orchestra,orchestra_member), 'Del',t('common.delete_confirm'),orchestra_member
      = link_to_exchange exchange_orchestra_orchestra_member_path(orchestra_member.orchestra,orchestra_member), t('common.exchange') , orchestra_member

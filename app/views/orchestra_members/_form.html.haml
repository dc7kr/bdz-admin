.group
  = bootstrap_form_for([@orchestra, @orchestra_member], layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
    .container-fluid
      =f.text_field :first_name
      =f.text_field :last_name
      =f.text_field :date_of_birth
      =f.text_field :instrument
      =f.number_field :mglnr
    .actions
      = submit_button
      = cancel_button

%h2= t('.title')

.heading 
  =t('event_card.order_confirm.heading', nr: @event_card.id )
%table.table

  - @event_card.ordered_cards.each do |c|
    -if c.count >0 
      %tr
        %td.number=c.count
        %td=t('event_card.'+c.key)
        %td=t('event_card.each_price', price: c.price)
        %td.number="%.2f EUR" % c.total

  %tr
    %td &nbsp;
    %td.sum=t('common.sum')
    %td &nbsp;
    %td{:class=> "sum number"}="%.2f EUR" % @event_card.sum

#sumup-card
%script{:src => "https://gateway.sumup.com/gateway/ecom/card/v2/sdk.js", :type => "text/javascript"}
:javascript
  SumUpCard.mount({
    id: 'sumup-card',
    checkoutId: '#{@event_card.checkout_id}', 
    onResponse: function (type, body) {
      console.log('Type', type);
      console.log('Body', body);
    },
  });

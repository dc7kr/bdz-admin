- invoice = event_card.to_invoice

%table.table
  %thead
    %tr
      %th.number=t("common.count")
      %th=t("event_card.card_type")
      %th.number=t("event_card.single_price")
      %th.number=t("event_card.total_price")

  - invoice.invoice_items.each do |i|
    %tr
      %td.number=i.count.to_i
      %td=i.label
      %td.number=t('event_card.each_price', price: i.unit_price.round())
      %td.number=format_currency i.gross
  %tr
    %td &nbsp;
    %td.sum=t('common.sum')
    %td &nbsp;
    %td.sum.number=format_currency invoice.total


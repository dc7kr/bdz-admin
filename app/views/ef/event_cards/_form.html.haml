= bootstrap_form_for @event_card, :layout=> :horizontal, url: @url  do |f|
  = f.alert_message  t("common.please_fix_form_errors")
  = f.text_field :name
  = f.email_field :email
  =f.text_field :street
  =f.text_field :zip
  =f.text_field :city
  .row.mb-3
    .col-md-2=f.label :country_code, class: "control-label col-sm-2"
    .col-md-10=f.country_select :country_code, {iso_codes:true, priority_countries: %w(DE UK), selected: @event_card.country_code, prompt: t("common.please_select_country")}, class: 'form-control'
  .row.mb-3
    =f.select(:preferred_lang, options_for_select([[I18n.t("lang.de"),'de'],[I18n.t("lang.en"),'en']],:selected=>@event_card.preferred_lang))
  
  .row.d-none.d-md-flex
    .col-2 &nbsp;
    .col-2=t('event_card.regular')
    .col-2 &nbsp;
    .col-2=t('event_card.reduced')
    .col-4 &nbsp;
  .row
    .col-md-2.d-md-inline.d-none= f.label :nr_fest, t("event_card.fest")
    .col-md-2= f.number_field :nr_fest, min: 0, label_class: "d-md-none", class: "col-md-2", label: t('event_card.nr_fest', price:@prices["ticket"]) 
    .col-md-2.d-none.d-md-inline= t("event_card.each_price", price: @prices["ticket"])
    .col-md-2= f.number_field :nr_fest_erm , min: 0, label_col: 'd-md-none', class: "col-md-2", label: t('event_card.nr_fest_erm', price:@prices["ticket_red"])
    .col-md-2.d-none.d-md-inline=t('event_card.each_price', price: @prices["ticket_red"])
    .col-md-2#fest_sum
  .row
    .col-md-2.d-none.d-md-flex= f.label :nr_do, t('event_card.do')
    .col-md-2= f.number_field :nr_do, min:0, label_col: 'd-md-none', label: t('event_card.nr_do', price:@prices["tageskarte"])
    .col-md-2.d-none.d-md-inline= t('event_card.each_price', price: @prices["tageskarte"])
    .col-md-2= f.number_field :nr_do_erm, min:0, label_col: 'd-md-none', label: t('event_card.nr_do_erm', price:@prices["tageskarte_erm"])
    .col-md-2.d-none.d-md-inline=t('event_card.each_price', price: @prices["tageskarte_erm"])
    .col-md-2.d-none.d-md-flex#sum_do
  .row
    .col-md-2.d-none.d-md-flex= f.label :nr_fr, t('event_card.fr')
    .col-md-2= f.number_field :nr_fr , min:0, label_col: 'd-md-none', label: t('event_card.nr_fr', price:@prices["tageskarte"])
    .col-md-2.d-none.d-md-inline= t('event_card.each_price', price: @prices["tageskarte"])
    .col-md-2= f.number_field :nr_fr_erm, min:0, label_col: 'd-md-none', label: t('event_card.nr_fr_erm', price:@prices["tageskarte_erm"])
    .col-md-2.d-none.d-md-inline= t('event_card.each_price', price: @prices["tageskarte_erm"])
    .col-md-2.d-none.d-md-flex#sum_fr
  .row
    .col-md-2.d-none.d-md-flex= f.label :nr_sa, t('event_card.sa')
    .col-md-2= f.number_field :nr_sa , min:0, label_col: 'd-md-none', label: t('event_card.nr_sa', price:@prices["tageskarte"])
    .col-md-2.d-none.d-md-inline=t('event_card.each_price', price: @prices["tageskarte"])
    .col-md-2= f.number_field :nr_sa_erm, min:0, label_col: 'd-md-none', label: t('event_card.nr_sa_erm', price:@prices["tageskarte_erm"])
    .col-md-2.d-none.d-md-inline=t('event_card.each_price', price: @prices["tageskarte_erm"])
    .col-md-2#sum_sa
  - if current_user
    =f.number_field  :nr_fest_bdz, value: 0, min:0
  - else 
    =f.hidden_field  :nr_fest_bdz, value: 0

  =f.hidden_field  :nr_fest_bdz_erm, value: 0
  =f.hidden_field  :nr_concert_so_erm, value:0
  =f.hidden_field  :nr_concert_so, value:0
  =f.hidden_field  :nr_schloss_1, value:0
  =f.hidden_field  :nr_schloss_2, value:0
  =f.hidden_field  :nr_schloss_3, value:0

  =f.submit t(".submit")

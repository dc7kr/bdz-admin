#concert-tab-pane.tab-pane.fade{ role: "tabpanel", 'aria-labelledby': "concert-tab", 'tabindex': 0 }
  .row
    .col-md-9.text-center
      %h2
        = t("festival_concert", count: 1)
        - concert = @festival_application.festival_concert
        = concert.label
  =entity_row(@festival_application,:stage_time, :date)
  =entity_row(@festival_application,:rehearsal_time, :date)
  =entity_row(@festival_application,:num_players)
  =entity_row(@festival_application,:equipment)
  =entity_row(@festival_application,:special_cast)
  =entity_row(@festival_application,:stage_plan, :active_storage)
  =entity_row(@festival_application,:player_list, :active_storage)


#invoice-tab-pane.tab-pane.fade{ role: "tabpanel", 'aria-labelledby': "invoice-tab", 'tabindex': 0 } 
  .container 
    - if not @festival_application.fee_invoice_id.nil?
      .row
        .col-md-8
          = t('festival_application.fee_invoice')
          - invoice = CorikaInvoices::Invoice.find(@festival_application.fee_invoice_id)
          = invoice.full_number
        .col-md-4
          =link_to my_fa_icon('file-download', 'fas'), fee_invoice_ef_festival_application_path(@festival_application),:class=>"btn btn-primary btn-sm", data: { turbo:false }
    - if not @festival_application.ticket_invoice_id.nil?
      .row
        .col-md-8
          = t('festival_application.ticket_invoice') 
          - invoice = CorikaInvoices::Invoice.find(@festival_application.ticket_invoice_id)
          = invoice.full_number
        .col-md-4=link_to my_fa_icon('file-dowload', 'fas'), ticket_invoice_ef_festival_application_path(@festival_application),:class=>"btn btn-primary btn-sm", data: { turbo:false }
    =custom_entity_row(t("festival_application.payment_status"), t("festival_application.payment_states.#{@festival_application.payment_status}"))


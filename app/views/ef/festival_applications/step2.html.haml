.secondary-navigation
  = render :partial =>'nav'
.secondary-navigation
  = render :partial =>'nav'
.page-title-section
  %h1=t("festival_application.step2_title")
.ef-inner
  %h3=t('festival_application.planned_programme')
  %table.table
    %thead
      %tr
        %th=t('festival_piece.title')
        %th=t('festival_piece.composer')
        %th=t('festival_piece.arranger')
        %th=t('festival_piece.publisher')
        %th=t('festival_piece.duration')
    %tbody#festival_pieces
      = render @festival_pieces 
   
     
  %h3=t('festival_application.add_piece')
  = render partial: "ef/festival_pieces/form", locals: { festival_application: @festival_application, festival_piece: FestivalPiece.new }
  
  = wizard_forward_button(t('common.finalize'),finalize_ef_festival_application_path(@festival_application))
= render :partial => "ef/footer"
- content_for :sidebar, render(:partial => 'sidebar')

%tr{:id => dom_id(festival_piece) }
  %td
    = festival_piece.title
    - if festival_piece.premiere
      %span.badge.text-bg-primary=t("festival_piece.premiere")
    - if festival_piece.outdoor
      %span.badge.text-bg-primary=t("festival_piece.outdoor")
  %td= festival_piece.composer
  %td= festival_piece.arranger
  %td= festival_piece.publisher
  %td= festival_piece.printable_duration
  %td
    = link_to_edit festival_piece, edit_ef_festival_application_festival_piece_path(@festival_application,festival_piece), authz: false, turbo: true
    = link_to_delete festival_piece, ef_festival_application_festival_piece_path(@festival_application,festival_piece), authz: false

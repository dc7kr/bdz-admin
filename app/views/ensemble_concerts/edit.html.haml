.block
  .secondary-navigation
    = render :partial => 'nav'
  .content
    %h2.title
      = t("common.edit")
      = t('ensemble_concert.title')
    .inner
      = form_for @ensemble_concert, :url => ensemble_ensemble_concert_path(@ensemble,@ensemble_concert), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

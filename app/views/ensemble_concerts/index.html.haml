.block
  .secondary-navigation
    %ul.wat-cf
      =render :partial => 'nav'
  .content
    %h2.title
      = t("common.all", :default => "All")
      = t("ensemble_concerts.title")
    .inner
      %table.table
        %tr
          %th.first 
            = sortable "id", t("ensemble_concerts.id", :default => "Nr")
          %th= sortable "name", t("ensemble_concerts.title", :default => "Titel")
          %th.last &nbsp;
        = render @ensemble_concerts
      = paginate @ensemble_concerts
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

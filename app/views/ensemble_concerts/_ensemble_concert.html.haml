%tr{:class => cycle("odd", "even"), :id=>"row#{ensemble_concert.id}"}
  %td= format_date(ensemble_concert.datum)
  %td= format_time(ensemble_concert.zeit)
  %td= ensemble_concert.stadt
  %td= ensemble_concert.ort
  %td= link_to ensemble_concert.url,ensemble_concert.url
  %td
    - if ensemble_concert.visible == 0 then
      = link_to_publish ensemble_concert,  t("common.publish")
    = link_to_show ensemble_concert
    = link_to_edit ensemble_concert
    = link_to_delete ensemble_concert
  
  %td=ensemble_concert.visible

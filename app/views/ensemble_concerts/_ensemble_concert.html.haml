%tr
  %td
    - if ensemble_concert.datum == nil
      ="---"
    - else
      =l ensemble_concert.datum,:format=>:short
  %td
    - if ensemble_concert.zeit== nil
      ="---"
    - else
      =l ensemble_concert.zeit
  %td=ensemble_concert.stadt
  %td
    - if ( ensemble_concert.url != nil and ensemble_concert.url.length > 0) then
      =link_to ensemble_concert.ort, ensemble_concert.url
    -else
      = ensemble_concert.ort
    
  %td=ensemble_concert.visible
  %td
    - if concert.visible == 0 then
      = link_to_publish ensemble_concert,  t("common.publish")
    = link_to_show_path ensemble_ensemble_concert_path(ensemble_concert.ensemble,ensemble_concert), t('common.show'),ensemble_concert
    = link_to_edit_path edit_ensemble_ensemble_concert_path(ensemble_concert.ensemble,ensemble_concert), t('common.edit'),ensemble_concert
    = link_to_del_path ensemble_ensemble_concert_path(ensemble_concert.ensemble,ensemble_concert), ensemble_concert
    - if ensemble_concert.visible == 0 then
      = icon_link("OK",'/icons/confirm.svg',publish_ensemble_ensemble_concert_path(ensemble_concert.ensemble,ensemble_concert))

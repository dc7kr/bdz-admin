.card
  .card-header#memberData
    Mitgliedsdaten
  .card-body
    = f.number_field :mglnr
    - if current_user.national_permission? then
      =f.collection_select(:regional_organization_id, RegionalOrganization.all, :id, :name) 
    -else
      = form_my_field(f,member, :regional_organization_id,:static)

    = f.date_field :eintritt, :class => "datetimepicker"
    = f.date_field :austritt_zum
    .form-group.row
      =f.label :dsgvo, :class =>"col-form-label col-sm-2"
      .col-sm-10
        = f.check_box :dsgvo, custom: :switch, label: "&nbsp;".html_safe
    = f.date_field :dsgvo_date,:class=> "datetimepicker"
    = f.number_field :magazines, help: t("member.magazine_help")
</div>


.card
  .card-header#contactData
    Kontaktdaten
  .card-body
    = f.select :anrede, get_salutation_options(member.anrede), class: "form-select"
    = f.text_field :title
    = f.text_field :vorname
    = f.text_field :name
    = f.text_field :strasse
    = f.text_field :plz
    = f.text_field :ort
    .row
      .col-md-2=f.label :country
      .col-md-10= f.country_select(:country_code, { iso_codes:true }, { class:  "form-select"})
    = f.phone_field :telefon
    = f.phone_field :fax
    = f.email_field :email

.card
  .card-header#paymentData
    Zahlungsdaten
  .card-body
    = f.select :za, options_for_select([["Lastschrift", "L"], ["Rechnung", "R"]],:selected=>member.za)
    = f.text_field :iban
    = f.text_field :bic
    = f.text_field :zahler
    = f.date_field :sepa_date
    = f.text_field :sepa_mandate_nr

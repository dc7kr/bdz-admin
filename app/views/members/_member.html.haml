#memberAccordion.accordion
  .accordion-item
    .accordion-header
      %button.accordion-button{"aria-controls" => "memberDataCollapse", "aria-expanded" => "true"}
        Mitgliedsdaten
        - if not member.zero_member_fee_balance?
          %span.badge.bg-danger=t("member.nonzero_balance", amount: member.member_fee_balance*-1)
    #memberDataCollapse.accordion-collapse.collapse.show{"data-bs-parent" => "#memberAccordion"}

      .accordion-body
        =entity_row(member.regional_organization,:name)
        =entity_row(member,:eintritt,:date)
        =entity_row(member,:austritt_zum,:date)
        =entity_row(member,:dsgvo,:boolean)
        =entity_row(member,:dsgvo_date,:date)
        .row
          .col-md-3.text-end.fw-bold=label :member,:magazines
          .col-md-9
            - if member.magazines >= 0
              = member.magazines
              %span.badge.bg-warning=t("member.is_ztg_override")
              ( berechnet:
              = member.member_entity.currentMagazines(false)
              )
            - else
              = member.member_entity.currentMagazines(true)
              %span.badge.bg-success=t("member.ztg_calculated")

  .accordion-item
    .accordion-header
      %button.accordion-button
        Kontaktdaten
    .accordion-body
      =custom_entity_row(t("member.salutation"), t("common.salutations."+member.anrede))
      =entity_row(member,:fullname)
      =entity_row(member,:strasse)
      =entity_row(member,:plz)
      =entity_row(member,:ort)
      =custom_entity_row(t("member.country_code"), translated_country(member.country_code))
      =entity_row(member,:email,:mailto)
      =entity_row(member,:telefon)
      =entity_row(member,:fax)
  .accordion-item
    .accordion-header
      %button.accordion-button
        Zahlungsdaten
        - if member.direct_debit? then
          %span.badge.bg-info=t("member.direct_debit")
    .accordion-body
      =custom_entity_row(t("member.za"), t("common.za_"+member.za))
      =entity_row(member,:iban)
      .row
        .col-md-3.text-end.fw-bold=label :member, :bic
        .col-md-9
          =member.bic
          - if not BIC_FINDER.valid?(member.bic)
            %span.badge.bg-danger=t("member.bic_invalid")
      =entity_row(member,:zahler)
      =entity_row(member,:sepa_date)
      =entity_row(member,:sepa_mandate_nr)

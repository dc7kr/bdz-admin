.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %table
        %tr
          %td.label=t('feature_request.owner')
          %td=@feature_request.owner_s
        %tr
          %td.label=t('feature_request.priority')
          %td=@feature_request.priority
        %tr
          %td.label=t('feature_request.status.title')
          %td=t('feature_request.status.'+@feature_request.status)

        %tr
          %td.label=t('feature_request.title')
          %td=@feature_request.title
        %tr
          %td.label=t('feature_request.description')
          %td
            %pre=@feature_request.description
        %tr
          %td.label=t('feature_request.priority')
          %td=@feature_request.priority


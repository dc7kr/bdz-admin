.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner

      %h2 #{t("feature_request",:count=>1)} #{@feature_request.id}
      %h3 #{@feature_request.title} 
      = entity_row(@feature_request,:owner_s, nil, t("feature_request.owner"))
      = entity_row(@feature_request,:priority)
      = entity_row(@feature_request,:status)
      .row
        .col-md-3.text-end
          %label=t('feature_request.description')
        .col-md-9
          %pre.pre-wrap=@feature_request.description


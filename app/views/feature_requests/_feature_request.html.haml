%tr
  %td= feature_request.priority
  %td{:class=>"status_"+feature_request.status}= t('feature_request.status_values.'+feature_request.status)
  %td= feature_request.title
  %td
    = link_to_show feature_request
    - if feature_request.user_id == current_user.id or current_user.admin?
      = link_to_edit feature_request
      = link_to_delete feature_request
      

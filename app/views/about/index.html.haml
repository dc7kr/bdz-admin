.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      =t('common.about')
      =@git_info[:application].html_safe
    .inner
      %b Config
      %table
        %tr
          %td.label SEPA-Mode
          %td= @sepa
      %p
        %b #{t('about.last_commits')}: 
        %table.table
          - @git_info[:last_commits].each do |commit|
            %tr
              %td=commit[:id]
              %td=commit[:date]
              %td
                %pre
                  -commit[:lines].each do |line|
                    =line.html_safe

%tr
  %td
    #{event_card.id}
    - if event_card.incomplete?
      .badge.text-bg-warning Incomplete
    - else
      - if not event_card.invoice.present? or not event_card.invoice.pdf_filename.present?
        .badge.text-bg-danger No PDF
  %td
    =t("event_card.payment_methods.#{event_card.payment_method}") if event_card.payment_method.present?
  %td=mail_to event_card.email,event_card.name
  %td
    = link_to_show event_card, event_card_path(checkout_reference: event_card.checkout_reference)
    = link_to_edit event_card
    = link_to "Pickup", pickup_event_card_path(checkout_reference: event_card.checkout_reference)
    = link_to_delete event_card

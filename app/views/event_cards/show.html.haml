.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("event_card.title")
    .inner
      %table
        %tr
          %td.label #{t('event_card.nr_fest')}/#{t('event_card.erm')}
          %td #{@event_card.nr_fest}/#{@event_card.nr_fest_erm}
        %tr
          %td.label #{t('event_card.nr_fest_bdz')}/#{t('event_card.nr_fest_bdz_erm')}
          %td #{@event_card.nr_fest}/#{@event_card.nr_fest_erm}
        %tr
          %td.label #{t('event_card.nr_do')}/#{t('event_card.nr_do_erm')}
          %td #{@event_card.nr_fest}/#{@event_card.nr_fest_erm}
        %tr
          %td.label #{t('event_card.nr_fr')}/#{t('event_card.nr_fr_erm')}
          %td #{@event_card.nr_fest}/#{@event_card.nr_fest_erm}
        %tr
          %td.label #{t('event_card.nr_sa')}/#{t('event_card.nr_sa_erm')}
          %td #{@event_card.nr_sa}/#{@event_card.nr_sa_erm}
        %tr
          %td.label=t('event_card.name')
          %td=@event_card.name
        %tr
          %td.label=t('event_card.email')
          %td=mail_to @event_card.email,@event_card.email
        %tr
          %td.label=t('event_card.orderdate')
          %td=format_date @event_card.orderdate

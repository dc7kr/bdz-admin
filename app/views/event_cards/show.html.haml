.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      #{t("event_card.s")} Nr. #{@event_card.id}
    .inner
      %h3=mail_to @event_card.email, @event_card.name
      %h4 #{t('event_card.orderdate')}:  #{format_date @event_card.orderdate}
      %table 
        %tr
          %th=t('common.count')
          %th=t('event_card.card_type')
          %th=t('event_card.single_price')
          %th=t('event_card.total_price')
        - @event_card.ordered_cards.each do |c|
          %tr
            %td.number=c.count
            %td=t('event_card.'+c.key)
            %td=t('event_card.each_price', { :price => c.price})
            %td.number="%.2f EUR" % c.total

        %tr
          %td &nbsp;
          %td.sum=t('common.sum')
          %td &nbsp;
          %td{:class=> "sum number"}="%.2f EUR" % @event_card.sum


        

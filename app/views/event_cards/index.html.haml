.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("event_card",:count=>3)
    .inner
      %p 
        %b Bezahlt 
        #{format_currency(@payed)}
        %br
        %b Gesamtsumme 
        #{format_currency(@sum)}
      %table.table-sm.table-hover.table-condensed
        %thead
          %tr
            %th=attr_heading(EventCard,:id)
            %th=attr_heading(EventCard,:fest)
            %th Tageskarten |Do|Fr|Sa|
            %th=attr_heading(EventCard,:name)
            %th &nbsp;
        = render @event_cards
- content_for :sidebar, render(:partial => 'sidebar')

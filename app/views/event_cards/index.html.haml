.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t("event_card",:count=>3)
  %p
    %b Bezahlt
    #{format_currency(@payed)}
    %br
    %b Gesamtsumme
    #{format_currency(@sum)}
  %table.table.table-sm.table-hover.table-condensed.table-striped
    %thead
      %tr
        %th=attr_heading(EventCard,:id)
        %th=attr_heading(EventCard,:payment_method)
        %th=attr_heading(EventCard,:name)
        %th &nbsp;
    = render @event_cards
- content_for :sidebar, render(:partial => 'sidebar')

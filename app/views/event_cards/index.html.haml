.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t("event_card.p")
    .inner
      %table.table
        %thead
          %tr
            %th=t('event_card.id')
            %th=t('event_card.fest')
            %th Tageskarten |Do|Fr|Sa|
            %th=t('event_card.name')
            %th &nbsp;
        = render @event_cards
- content_for :sidebar, render(:partial => 'sidebar')

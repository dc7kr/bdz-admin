.block
  .secondary-navigation
    = render :partial =>'nav'
  .content
    %h2.title
      = t("common.edit")
      = t("event_card.s")
    .inner
      = form_for @event_card, :url => event_card_path(@event_card), :html => { :class => :form } do |f|
        = render :partial => "form", :locals => {:f => f}
- content_for :sidebar, render(:partial => 'sidebar')

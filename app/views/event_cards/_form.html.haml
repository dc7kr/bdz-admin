= bootstrap_form_for(@event_card, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  = f.check_box :pickup
  = f.text_field :company
  = f.text_field :name
  = f.email_field :email
  = f.text_field :street
  = f.text_field :zip
  = f.text_field :city
  = f.country_select :country_code, iso_codes:true
  = f.select(:preferred_lang, options_for_select([['Deutsch','de'],['Englisch','en']],:selected=> @event_card.preferred_lang))
  = f.check_box :invoiced
  = f.check_box :payment_received
  .row
    .col-md-2
    .col-md-4=t('event_card.regular')
    .col-md-4=t('event_card.reduced')
  .row 
    .col-md-2= f.label :nr_fest, t('event_card.fest')
    .col-md-2= f.number_field :nr_fest,hide_label: true
    .col-md-2= t('event_card.each_price', price: @prices["fest"])
    .col-md-2= f.number_field :nr_fest_erm ,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["fest_erm"])
    .col-md-2#fest_sum
  .row 
    .col-md-2= f.label :nr_fest_bdz, t('event_card.fest_bdz')
    .col-md-2= f.number_field :nr_fest_bdz ,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["fest_bdz"])
    .col-md-2= f.number_field :nr_fest_bdz_erm,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["fest_bdz_erm"])
    .col-md-2#fest_sum_bdz
  .row 
    .col-md-2= f.label :nr_do, t('event_card.do')
    .col-md-2= f.number_field :nr_do ,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["tageskarte"])
    .col-md-2= f.number_field :nr_do_erm,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["tageskarte_erm"])
    .col-md-2#sum_do
  .row 
    .col-md-2= f.label :nr_fr, t('event_card.fr')
    .col-md-2= f.number_field :nr_fr ,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["tageskarte"])
    .col-md-2= f.number_field :nr_fr_erm,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["tageskarte_erm"])
    .col-md-2#sum_fr
  .row 
    .col-md-2= f.label :nr_sa, t('event_card.sa')
    .col-md-2= f.number_field :nr_sa ,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["tageskarte"])
    .col-md-2= f.number_field :nr_sa_erm,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["tageskarte_erm"])
    .col-md-2#sum_sa
  .row
    .col-md-2= f.label :nr_concert_so, t('event_card.concert_so')
    .col-md-2= f.number_field :nr_concert_so,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["concert"])
    .col-md-2= f.number_field :nr_concert_so_erm,hide_label: true
    .col-md-2=t('event_card.each_price', price: @prices["concert_erm"])
    .col-md-2#sum_sa

  = f.submit t("event_card.order_form.submit")

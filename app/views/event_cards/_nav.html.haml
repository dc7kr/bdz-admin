%ul.nav.nav-tabs
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_festival_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list")}", event_cards_path
  -if (@event_card)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), event_card_path(@event_card)
    %li{ :class => tabActiveClass(@current_action,'edit',nil)}= link_to t("common.edit"), edit_event_card_path(@event_card)
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_event_card_path


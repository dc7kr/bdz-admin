.block
  .secondary-navigation
    = render :partial => "nav"
  .content
    .inner
      .container-fluid
        .row
          .col-md-2=label :university, :name
          .col-md-10= @university.name
        .row
          .col-md-2=label :university, :institute
          %p.col-md-10= @university.institut
        .row
          .col-md-2=label :university, :instrument
          %p.col-md-10= @university.instrument
        .row
          .col-md-2=label :university, :studiengang
          %p.col-md-10= @university.studiengang
        .row
          .col-md-2=label :university, :strasse
          .col-md-10= @university.strasse
        .row
          .col-md-2=label :university, :plz
          .col-md-10= @university.plz
        .row
          .col-md-2=label :university, :ort
          .col-md-10= @university.ort
        .row
          .col-md-2=label :university, :land
          .col-md-10= translated_country(@university.country_code)
        .row
          .col-md-2=label :university, :state
          .col-md-10= translated_state(@university.country_code, @university.state)
        .row
          .col-md-2=label :university, :telefon
          .col-md-10= @university.telefon
        .row
          .col-md-2=label :university, :dozent
          .col-md-10= @university.dozent
        .row
          .col-md-2=label :university, :email
          .col-md-10= @university.email
        .row
          .col-md-2=label :university, :homepage
          .col-md-10= @university.homepage


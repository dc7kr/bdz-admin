= form_for @university do |f|
  -if @university.errors.any?
    #error_explanation
      %h2= "#{pluralize(@university.errors.count, "error")} prohibited this university from being saved:"
      %ul
        - @university.errors.full_messages.each do |msg|
          %li= msg
  =form_my_field(f, @university, :name)
  =form_my_field(f, @university, :institut)
  =form_my_field(f, @university, :strasse)
  =form_my_field(f, @university, :plz)
  =form_my_field(f, @university, :ort)
  =form_wrapped_field(f, @university, :country_code, country_select(:university, :country_code, {:iso_codes=>true}, { class: "form-control" }))
  =form_my_select(f,@university, :state, options_for_select(state_options_for_country(@university.country_code)))
  =form_my_field(f, @university, :telefon)
  =form_my_field(f, @university, :studiengang)
  =form_my_field(f, @university, :dozent)
  =form_my_field(f, @university, :email)
  =form_my_field(f, @university, :homepage)
  .actions
    = submit_button()
    = cancel_button()

%h1 Listing universities

%table
  %tr
    %th Name
    %th Institut
    %th Strasse
    %th Plz
    %th Ort
    %th Land
    %th Telefon
    %th Studiengang
    %th Dozent
    %th Email
    %th Homepage
    %th
    %th
    %th

  - @universities.each do |university|
    %tr
      %td= university.name
      %td= university.institut
      %td= university.strasse
      %td= university.plz
      %td= university.ort
      %td= university.land
      %td= university.telefon
      %td= university.studiengang
      %td= university.dozent
      %td= university.email
      %td= university.homepage
      %td= link_to 'Show', university
      %td= link_to 'Edit', edit_university_path(university)
      %td= link_to 'Destroy', university, :confirm => 'Are you sure?', :method => :delete

%br

= link_to 'New University', new_university_path

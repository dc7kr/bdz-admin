%tr
  %td= university.name
  %td= university.institut
  %td= university.dozent
  %td= university.email
  %td= university.homepage
  %td
    = link_to_show university, t('common.show')
    = link_to_edit university, t('common.edit') 
    = link_to_delete university, t('common.delete'), t('common.delete_confirm')




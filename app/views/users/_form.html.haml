= form_for @user, :html => { :class => "form-horizontal", :autocomplete => 'off' } do |f|
  -if @user.errors.any?
    #error_explanation
      %h2= "#{pluralize(@user.errors.count, "error")} prohibited this user from being saved:"
      %ul
        - @user.errors.full_messages.each do |msg|
          %li= msg
  .container-fluid
    = form_my_field(f,@url, :username)
    = form_my_field(f,@url, :name)
    = form_my_field(f,@url, :email)
    = form_my_field(f,@user, :password,:password)
    = form_wrapped_field(f,@user, :admin, check_box_tag(:admin, 1, @user.has_role?(:admin)) )
    = form_wrapped_field(f,@user, :regional, check_box_tag(:regional, 1, @user.has_role?(:regional)) )
    = form_wrapped_field(f,@user, :member, check_box_tag(:member, 1, @user.has_role?(:member)) )
    .actions
      = submit_button
      = cancel_button

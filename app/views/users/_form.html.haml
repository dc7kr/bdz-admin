= form_for @user do |f|
  -if @user.errors.any?
    #error_explanation
      %h2= "#{pluralize(@user.errors.count, "error")} prohibited this user from being saved:"
      %ul
        - @user.errors.full_messages.each do |msg|
          %li= msg
  %table
    %tr
      %td.label= f.label :username
      %td= f.text_field :username
    %tr
      %td.label= f.label :name
      %td= f.text_field :name
    %tr
      %td.label= f.label :email
      %td= f.text_field :email
    %tr
      %td.label= f.label :password
      %td= f.password_field :password
    %tr
      %td.label= f.label :role
      %td= f.collection_select :role, User::ROLES, :to_s, :humanize 
  .actions
    = f.submit t("common.save")
    = cancel_button()

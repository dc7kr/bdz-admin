.secondary-navigation
  = render :partial=>'nav'
.container.w-50
  %h2
    =my_fa_icon("user")
    &nbsp;
    =t("user",count:1)
    = @user.username
  =entity_row @user,:username
  =entity_row @user,:name
  =entity_row @user,:email,:mailto
  
  .row
    .col-md-3.text-end=label :user, :roles
    .col-md-9
      %table.table.table-sm#roles
        = render @user.roles
      = render partial: "role_form"

  =custom_entity_row t("activerecord.attributes.user.access_level"), t("users.access_levels.#{@user.access_level}")
  -if not @user.restricting_entity.nil?
    =custom_entity_row t("activerecord.attributes.user.restricting_entity"), "#{@user.restricting_entity} (#{@user.restricting_mglnr})"

.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      .container-fluid
        =entity_row @user,:username
        =entity_row @user,:name
        =entity_row @user,:email,:mailto
        .row
          .col-md-3.text-right=label :user, :roles
          .col-md-9
            -@user.roles.each do |r|
              =r.name
              %br
        =entity_row @user,:entity_class
        =entity_row @user,:entity_id
        =entity_row @user,:restricting_entity
        =entity_row @user,:auth_token

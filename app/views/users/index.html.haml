.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t('user.p')
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %th.first= attr_heading(User,:username)
          %th= attr_heading(User,:email)
          %th= attr_heading(User,:last_sign_in_at)
          %th= attr_heading(User,:last_sign_in_ip)
          %th= attr_heading(User,:sign_in_count)
          %th.last &nbsp;
        %tbody#users
          =render @users
      #paginator
        = paginate @users, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

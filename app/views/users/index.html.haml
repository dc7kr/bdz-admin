.secondary-navigation
  =render :partial=>'nav'
.container
  %h2.title
    = t("common.all")
    = t('user',:count=>3)

  %table.table.table-sm.table-hover.table-condensed
    %thead
      %th.first= attr_heading(User,:username)
      %th= attr_heading(User,:email)
      %th= attr_heading(User,:last_sign_in_at)
      %th= attr_heading(User,:last_sign_in_ip)
      %th= attr_heading(User,:sign_in_count)
      %th.last &nbsp;
    %tbody#users=render @users
  #paginator= paginate @users



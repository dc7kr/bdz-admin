- if page.current?
  %li.active
    = content_tag :a, page, remote: remote, :"data-type"=> remote ? "script" : "", rel: (page.next? ? 'next' : (page.prev? ? 'prev' : nil))
- else
  %li
    = link_to page, url, remote: remote, :"data-type"=> remote ? "script" : "", rel: (page.next? ? 'next' : (page.prev? ? 'prev' : nil))

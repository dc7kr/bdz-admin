.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      #{t("common.list")} #{t("course",:count=>2)}
    .inner
      %table.table-sm.table-hover.table-condensed
        %tr
          %th.first= attr_heading(Course, :startDate)
          %th= attr_heading(Course, :endDate)
          %th= attr_heading(Course, :title)
          %th= attr_heading(Course, :deadline)
          %th= attr_heading(Course, :visible)
          
          %th.last &nbsp;
        = render @courses

%br


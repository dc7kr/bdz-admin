%tr{:class => cycle("odd", "even")}
  %td= course.startdate
  %td= course.enddate
  %td= course.titel
  %td= course.deadline
  %td= course.visible
  %td
    - if course.visible == 0 then
      = link_to_publish course,  t("common.publish")
    = link_to_show course
    = link_to_edit course
    = link_to_delete course


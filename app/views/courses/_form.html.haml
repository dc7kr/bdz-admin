= form_for @course , :html => {:class=>"form-horizontal"} do |f|
  -if @course.errors.any?
    #error_explanation
      %h2= "#{pluralize(@course.errors.count, "error")} prohibited this course from being saved:"
      %ul
        - @course.errors.full_messages.each do |msg|
          %li= msg
  .container-fluid
    = form_my_field(f,@course, :startdate,:date)
    = form_my_field(f,@course, :enddate,:date)
    = form_my_field(f,@course, :titel)
    = form_my_textarea(f,@course, :beschreibung,5,80)
    = form_my_textarea(f,@course, :inhalt,5,80)
    = form_my_textarea(f,@course, :zielgruppe,5,80)
    = form_my_textarea(f,@course, :dozenten,5,80)
    = form_my_field(f,@course, :more_dates)
    = form_wrapped_field(f,@course, :bland, collection_select(:course, :bland, State.all, :id, :name))
    = form_my_field(f,@course, :gebuehr)
    = form_my_field(f,@course, :anmeldung)
    = form_my_field(f,@course, :deadline)
    = form_my_field(f,@course, :reported)
    = form_my_field(f,@course, :email)
    = form_wrapped_field(f,@course, :visible, f.check_box(:visible))
  .actions
    = submit_button
    = cancel_button

= form_for @course do |f|
  -if @course.errors.any?
    #error_explanation
      %h2= "#{pluralize(@course.errors.count, "error")} prohibited this course from being saved:"
      %ul
        - @course.errors.full_messages.each do |msg|
          %li= msg

  .field
    = f.label :startdate
    = f.text_field :startdate
  .field
    = f.label :enddate
    = f.text_field :enddate
  .field
    = f.label :titel
    = f.text_field :titel
  .field
    = f.label :beschreibung
    = f.text_area :beschreibung
  .field
    = f.label :inhalt
    = f.text_area :inhalt
  .field
    = f.label :zielgruppe
    = f.text_area :zielgruppe
  .field
    = f.label :dozenten
    = f.text_area :dozenten
  .field
    = f.label :more_dates
    = f.text_area :more_dates
  %tr
    %td= f.label :bland
    %td= collection_select(:course, :bland, State.all, :id, :name)
  .field
    = f.label :gebuehr
    = f.text_field :gebuehr
  .field
    = f.label :anmeldung
    = f.text_area :anmeldung
  .field
    = f.label :deadline
    = f.text_field :deadline
  .field
    = f.label :reported
    = f.text_field :reported
  .field 
    = f.label :email
    = f.text_field :email
  .field
    = f.label :visible
    = f.check_box :visible
  .actions
    = f.submit t("common.save")
    = cancel_button()

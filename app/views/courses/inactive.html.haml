.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      #{t("common.list")} #{t("course",:count=>2)}
    .inner
      %table.table-sm
        %tr
          %th.first= t("course.startDate")
          %th= t("course.endDate")
          %th= t("course.title")
          %th= t("course.deadline")
          %th= t("course.visible")
          
          %th.last &nbsp;
        = render @courses

%br


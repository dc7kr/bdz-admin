.secondary-navigation
  = render :partial=>'nav'
.container
  %h1
    = t("festival_exhibitor", count: 1)
    = t("common.number")
    = @festival_exhibitor.id
    %br
    = @festival_exhibitor.contact.company

  = entity_row(@festival_exhibitor, :year)
  = entity_row(@festival_exhibitor, :special_tariff)
  - if @festival_exhibitor.special_tariff == 1
    = entity_row(@festival_exhibitor, :special_amount)
  - else
    = entity_row(@festival_exhibitor, :tariff)
  = entity_row(@festival_exhibitor, :rollups)
  = entity_row(@festival_exhibitor, :extra_tables)
  = entity_row(@festival_exhibitor, :advert_type)

  - if policy(@festival_exhibitor).invoice_preview?
    = link_to 'Rechnungsvorschau', invoice_preview_festival_exhibitor_path(@festival_exhibitor),  data: { 'turbo_frame' => 'modal' }, class: 'btn btn-secondary btn-sm'

  - if @festival_exhibitor.has_invoice?
    = link_to "Rechnung PDF", invoice_pdf_download_path(@festival_exhibitor.invoice),:class=>"btn btn-primary btn-sm", data: { turbo:false }
  - else
    = link_to 'Generate PDF', gen_invoice_festival_exhibitor_path(@festival_exhibitor), format: :pdf, class: 'btn btn-secondary btn-sm'
  %hr
  = render partial: "contacts/contact_show", :locals => { :contact =>  @festival_exhibitor.contact }


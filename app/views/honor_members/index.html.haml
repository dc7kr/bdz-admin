.secondary-navigation
  =render :partial=>'nav'
.container
  %h2
    = t("honor_member",:count=>99)
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %th=sortable "nr", attr_heading(HonorMember,:nr), "table-dark"
      %th= attr_heading(HonorMember,:vorname)
      %th= attr_heading(HonorMember,:name)
      %th= attr_heading(HonorMember,:ort)
      %th= sortable "honorType", attr_heading(HonorMember,:honorType), "table-dark"
      %th= sortable "honorDate", attr_heading(HonorMember,:honorDate), "table-dark"
      %th.last &nbsp;
    %tbody#orchestras
      = render @honor_members
- content_for :sidebar, render(:partial => 'sidebar')



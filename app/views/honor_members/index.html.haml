.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("honor_member.title")
    .inner
      %table.table.table-hover.table-condensed
        %thead
          %th.first= t("honor_member.nr")
          %th= t("honor_member.vorname")
          %th= t("honor_member.name")
          %th= t("honor_member.ort")
          %th= t("honor_member.honortype")
          %th= t("honor_member.honordate")
          %th.last &nbsp;
        %tbody#orchestras
          = render @honor_members
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')



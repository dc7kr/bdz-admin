.secondary-navigation
  =render :partial=>'nav'
.container
  %h2
    = t("honor_member",:count=>99)
  %table.table.table-sm.table-hover.table-condensed
    %thead.table-dark
      %th.first= attr_heading(HonorMember,:nr)
      %th= attr_heading(HonorMember,:vorname)
      %th= attr_heading(HonorMember,:name)
      %th= attr_heading(HonorMember,:ort)
      %th= sortable "honortype", attr_heading(HonorMember,:honorType)
      %th= attr_heading(HonorMember,:honorDate)
      %th.last &nbsp;
    %tbody#orchestras
      = render @honor_members
- content_for :sidebar, render(:partial => 'sidebar')



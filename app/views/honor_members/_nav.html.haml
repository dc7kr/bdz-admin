%ul.wat-cf
  %li{ :class => 'first'}= link_to_up_path t("common.up"), home_public_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to "#{t("common.list", :default => "List")}", honor_members_path
  -if (@honor_member)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), '#'
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_public_honor_member_path

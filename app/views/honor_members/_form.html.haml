= bootstrap_form_for(@honor_member, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  =f.number_field :nr
  =f.text_field :vorname
  =f.text_field :name
  =f.text_field :ort
  =f.text_field :honorType
  =f.date_field :honorDate
  .row
    .control-label.col-sm-2=label(:honor_member, :deceased)
    .col-sm-10=f.check_box :deceased, { inline: true, hide_label: true, label: ""  }
  = f.submit
  = cancel_button

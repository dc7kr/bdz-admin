= form_for @honor_member,:html=>{ :class => "form-horizontal" } do |f|
  -if @honor_member.errors.any?
    #error_explanation
      %h2= "#{pluralize(@honor_member.errors.count, "error")} prohibited this honor_member from being saved:"
      %ul
        - @honor_member.errors.full_messages.each do |msg|
          %li= msg
  .container-liquid
    =form_my_field(f,@honor_member, :nr,:number)
    =form_my_field(f,@honor_member, :vorname)
    =form_my_field(f,@honor_member, :name)
    =form_my_field(f,@honor_member, :ort)
    =form_my_field(f,@honor_member, :honorType)
    =form_my_field(f,@honor_member, :honorDate,:date)
  .actions
    = submit_button
    = cancel_button

.block
  .secondary-navigation
  .content
    %h2.title
      = t("common.error_500")
    .inner
      %p= @exception 
      -if current_user != nil and current_user.admin? or Rails.env != 'production'
        %pre
          =@exception.backtrace.join("\n")
        %h2 Cause
        -if not @exception.cause.nil?
          %p= @exception.cause
          %pre
            =@exception.cause.backtrace.join("\n")


.container.pt-5
  .alert.alert-danger
    %h1.card-title 500 Internal server error
    %h2 
      Our server is on a break.  Let's go 
      = link_to "home", "/"
  .card.bg-light.p-5
    %h2= @exception
    %pre
      = filter_backtrace @exception.backtrace
    - if not @exception.cause.nil?
      %h2=@exception.cause
      %pre=filter_backtrace @exception.cause.backtrace
      


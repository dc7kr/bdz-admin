%tr{:class => cycle("odd", "even")}
  %td
    = link_to orchestra.mglnr, orchestra_path(orchestra)
  %td
    = orchestra.orchName
    %br
    = orchestra.address
    %br
    = mail_to orchestra.email
    %br
    = orchestra.telefon
  - rs = orchestra.report_sheet_for_year(@year)
  %td
    = orchestra.total(@year)
  %td
    = orchestra.gema(@year)
  %td
    - if ( rs ) then @orchSum= @orchSum + rs.calcLvPart end
    = if ( rs ) then format_currency(rs.calcLvPart,'EUR') end
  %td
    - if ( rs ) then @orchFullSum= @orchFullSum + rs.calcInvoice end
    = if ( rs ) then format_currency(rs.calcInvoice,'EUR') end
  %td.last


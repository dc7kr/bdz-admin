%tr{:class => cycle("odd", "even")}
  %td
    = link_to person_member.member.mglnr, person_member_path(person_member)
  %td
    - if not person_member.member.zero_member_fee_balance?
      %span.glyphicon.glyphicon-ban-circle.alert
    = person_member.member.fullname
  %td
    = person_member.member.strasse
  %td
    #{person_member.member.plz} #{person_member.member.ort}
  %td 
    = person_member.member.telefon
  %td
    = mail_to person_member.member.email
  %td
    = format_currency(person_member.lvPart,'EUR')
    - @personSum=@personSum+person_member.lvPart

  %td.last


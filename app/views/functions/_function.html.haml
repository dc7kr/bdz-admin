%tr
  %td= function.label
  %td= function.regional_organization.name
  %td
    - if function.board_contact.nil? then
      .error NIL

    -else 
      = function.board_contact.contact.last_name
      ,
      = function.board_contact.contact.first_name
  %td= format_bool function.bund
  %td= format_bool function.jugend
  %td
    = function.nr
    %br
    = function.funktion
    %br
    = function.fkt_subtitle
    %br
  %td
    = link_to_show function
    = link_to_edit function 
    = link_to_delete function


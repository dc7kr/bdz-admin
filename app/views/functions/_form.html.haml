= bootstrap_form_for(@function, layout: :horizontal, label_col: "col-sm-2", control_col: "col-sm-10") do |f| 
  .container-fluid
    =f.text_field :label 
    =f.collection_select :regional_organization_id, RegionalOrganization.all.order("name ASC"), :id, :name
    %tr
      %td= t("contact",:count=>1)
      %td= f.collection_select :board_contact_id, BoardContact.includes(:contact).order("contacts.last_name ASC, contacts.first_name ASC"), :id, :to_s
    =form_my_field(f,@function, :bund,:checkbox)
    =form_my_field(f,@function, :jugend,:checkbox)
    =f.number_field :nr
    =f.text_field :funktion
    =f.text_field :fkt_subtitle
  .actions
    = submit_button
    = cancel_button()

= form_for @function do |f|
  -if @function.errors.any?
    #error_explanation
      %h2= "#{pluralize(@function.errors.count, "error")} prohibited this function from being saved:"
      %ul
        - @function.errors.full_messages.each do |msg|
          %li= msg
  %table
    %tr
      %td= f.label :label
      %td=f.text_field :label
    %tr
      %td= t('regional_organization.s')
      %td= f.collection_select :regional_organization_id, RegionalOrganization.find(:all,:order => "name ASC"), :id, :name
    %tr
      %td= t("contact.s")
      %td= f.collection_select :contact_id, Contact.find(:all,:order => "last_name ASC, first_name ASC"), :id, :to_s
    %tr
      %td= f.label :bund
      %td= f.check_box :bund, :class => 'check_box'
    %tr
      %td= f.label :jugend
      %td= f.check_box :jugend, :class => 'check_box'
    %tr
      %td= f.label :nr
      %td=f.text_field :nr
    %tr
      %td= f.label :funktion
      %td=f.text_field :funktion
    %tr
      %td= f.label :fkt_subtitle
      %td=f.text_field :fkt_subtitle
  .actions
    = submit_button
    = cancel_button()

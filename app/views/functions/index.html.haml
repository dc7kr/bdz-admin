%h1 Funktionen

%table
  %tr
    %th Eindeutiges Label
    %th Landesverband
    %th Address
    %th Bund
    %th Jugend
    %th Nr
    %th Funktion
    %th Untertitel
    %th
    %th
    %th

  - @functions.each do |function|
    %tr
      %td= function.label
      %td= function.regional_organization.name
      %td
        = function.address.name
        ,
        = function.address.vorname
      %td= function.bund
      %td= function.jugend
      %td= function.nr
      %td= function.funktion
      %td= function.fkt_subtitle
      %td= link_to_show(function,'Show')
      %td= link_to_edit(edit_function_path(function),'Edit')
      %td= link_to_delete(function, 'Del','Are you sure?')

%br

= link_to_new( new_function_path,'New')

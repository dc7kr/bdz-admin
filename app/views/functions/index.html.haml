.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t('function',:count=>3)
    .inner
      #entry_info
        = page_entries_info @functions
      %table.table.table-hover.table-condensed
        %thead
          %th.first= attr_heading(Function,:label)
          %th= sortable "regional_organization_id", t("regional_organization",:count=>1)
          %th=t("contact",:count=>1)
          %th=attr_heading(Function,:bund)
          %th=attr_heading(Function,:jugend)
          %th=attr_heading(Function,:nr)
          %th=sortable "funktion", attr_heading(Function,:funktion)
          %th.last &nbsp;
        %tbody#functions
          =render @functions
      #paginator
        = paginate @functions, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

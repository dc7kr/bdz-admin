.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t('function.p')
    .inner
      #entry_info
        = page_entries_info @functions
      %table.table.table-hover.table-condensed
        %thead
          %th.first= t("function.label")
          %th= sortable "regional_organization_id", t("regional_organization.s")
          %th=t("contact.s")
          %th=t("function.bund")
          %th=t("function.jugend")
          %th=t("function.nr")
          %th=sortable "funktion", t("function.funktion")
          %th.last &nbsp;
        %tbody#functions
          =render @functions
      #paginator
        = paginate @functions, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

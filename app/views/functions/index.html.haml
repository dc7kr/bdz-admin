.block
  .secondary-navigation
    =render :partial=>'nav'
  .content
    %h2.title
      = t("common.all")
      = t('function.p')
    .inner
      #entry_info
        = page_entries_info @functions
      %table.table
        %thead
          %th.first= t("function.label")
          %th=t("regional_organization.s")
          %th=t("contact.s")
          %th=t("function.bund")
          %th=t("function.jugend")
          %th=t("function.nr")
          %th.last &nbsp;
        %tbody#functions
          =render @functions
      #paginator
        = paginate @functions, :remote=>true
      .actions-bar.wat-cf
        .actions
- content_for :sidebar, render(:partial => 'sidebar')

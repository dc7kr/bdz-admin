%ul.wat-cf
  %li.first= link_to_up_path t("common.up"), home_public_data_path
  %li{ :class => tabActiveClass(@current_action,'index','first')}= link_to t("common.list"), functions_path
  -if (@function and @function.id!=nil)
    %li{ :class => tabActiveClass(@current_action,'show',nil)}= link_to t("common.show"), @function
  %li{:class => tabActiveClass(@current_action,'new',nil)}= link_to "#{t("common.new", :default => "New")}", new_function_path


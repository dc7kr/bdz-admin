-@contact = @function.contact
.block
  .secondary-navigation
    = render :partial=>'nav'
  .content
    .inner
      %table
        %tr
          %td.label #{t("function.label")}:
          %td= @function.label
        %tr
          %td.label #{t('contact.s')}:
          %td= @function.regional_organization
        = render @contact,:partial=>"contact"
        %tr
          %td.label #{t('function.bund')}:
          %td= @function.bund
        %tr
          %td.label #{t('function.jugend')}:
          %td= @function.jugend
        %tr
          %td.label #{t('function.nr')}:
          %td= @function.nr
        %tr
          %td.label #{t('function.funktion')}:
          %td= @function.funktion
        %tr
          %td.label #{t('function.fkt_subtitle')}:
          %td= @function.fkt_subtitle


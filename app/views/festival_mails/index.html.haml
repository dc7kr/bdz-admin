= form_for :festival_mail, :url => { :controller => :festival_mails, :action => :send_mails }  do |f|
  = f.label :event_id
  %br
  = f.text_field :event_id, :size => 60 
  %br
  = f.label :group
  %br
  = f.select :group, group_options

  %br
  = f.label :subject 
  %br
  = f.text_field :subject, :size => 60 
  %br
  = f.label :body 
  %br
  = f.text_area :body, :rols => 10, :cols => 60 
  %br
  = f.label :datafile
  \: 
  = f.file_field :datafile
  %br
  = submit_tag "Send Email "


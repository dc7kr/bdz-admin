.panel.panel-default
  = form_for :festival_mail, :url => { :controller => :festival_mails, :action => :send_mails }  do |f|
    = form_my_field(f,:festival_mail,:event_id)
    = form_my_select(f,:festival_mail,:group, group_options)
    = form_my_field(f,:festival_mail,:subject )
    = form_my_textarea(f,:festival_mail,:body,60,10)
    = form_my_field(f,:festival_mail, :datafile,:file)
    .col-sm-12.col-md-12.center-block
      = submit_button "Send Email"

